<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      The Android proof of concept: .NET for Android (no MAUI): one Android view that Skia draws into. It runs
      the same engine (PdfEngine.Vector) and the same Skia renderer (PdfEngine.Vector.Skia) as the
      web demo, through the same engine layer (PdfViewer.Web.Engine). Building it needs the android
      workload. No INTERNET permission, no telemetry.
    -->
    <!--
      net10.0-android targets Android 16 (API level 36), which Google Play requires of new apps and
      updates since 31 August 2026 (docs/android-release.md). The .NET 9 workload stops at API 35.
      -p:AndroidNet9=true builds with the .NET 9 workload instead (API 35: fine for adb and the
      emulator, refused by Play).
    -->
    <TargetFramework>net10.0-android</TargetFramework>
    <TargetFramework Condition="'$(AndroidNet9)' == 'true'">net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfViewer.Android</RootNamespace>
    <AssemblyName>PdfViewer.Android</AssemblyName>
    <ApplicationId>io.github.ramanacr.pdfviewer</ApplicationId>
    <ApplicationTitle>PDF Viewer (preview)</ApplicationTitle>
    <!-- The Play release workflow sets the version code (-p:ApplicationVersion) from its tag. -->
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>

    <!--
      Release builds an Android App Bundle (.aab), the format Google Play takes. Debug, and any
      build with -p:AndroidPackageFormat=apk (the CI test artifact), builds an APK to install with
      adb. Phones (arm64) and the x86-64 emulator only.
    -->
    <AndroidPackageFormat Condition="'$(AndroidPackageFormat)' == '' And '$(Configuration)' == 'Release'">aab</AndroidPackageFormat>
    <AndroidPackageFormat Condition="'$(AndroidPackageFormat)' == ''">apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
    <!-- The engine formats with the invariant culture: no ICU data in the package. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- No telemetry, and no debugger hooks in a release package. -->
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport Condition="'$(Configuration)' == 'Release'">false</DebuggerSupport>
    <!--
      Signing: a build signs with the SDK's per-user debug key (outside the repository), which is
      what `adb install` needs. No keystore is kept here. The Play release workflow
      (.github/workflows/android-release.yml) passes the upload key from GitHub secrets.
    -->
  </PropertyGroup>

  <ItemGroup>
    <!--
      Android's SELinux policy denies apps file locks on /system/fonts (each font read logged an
      'avc: denied { lock }'). The app never shares files it writes, so .NET's advisory locks are off.
    -->
    <RuntimeHostConfigurationOption Include="System.IO.DisableFileLocking" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT-licensed SkiaSharp's native library for Android, the same pinned version as PdfEngine.Vector.Skia. -->
    <PackageReference Include="SkiaSharp.NativeAssets.Android" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEngine.Abstractions\PdfEngine.Abstractions.csproj" />
    <ProjectReference Include="..\PdfEngine.Vector\PdfEngine.Vector.csproj" />
    <ProjectReference Include="..\PdfEngine.Vector.Skia\PdfEngine.Vector.Skia.csproj" />
    <ProjectReference Include="..\PdfViewer.Web.Engine\PdfViewer.Web.Engine.csproj" />
  </ItemGroup>

  <!-- Native debug symbols in the Release app bundle, for Google Play (docs/android-release.md). -->
  <Import Project="NativeDebugSymbols.targets" />

</Project>
