<Project>

  <!--
    Native debug symbols in the Android App Bundle, for Google Play.

    Play Console reads native debug symbols from the bundle folder
    BUNDLE-METADATA/com.android.tools.build.debugsymbols/<abi>/ (what the Android Gradle plugin
    writes when ndk.debugSymbolLevel is set; see docs/android-release.md). Without it, Play shows
    "This App Bundle contains native code, and you've not uploaded debug symbols".

    .NET for Android does not write this folder itself, but it passes each
    @(AndroidAppBundleMetaDataFile) item ("<bundle-path>:<file>") to bundletool as a metadata file.
    This target adds the native libraries of the bundle that still have symbols:

      libmonodroid.so    the .NET for Android runtime host. The runtime pack ships it unstripped
                         (it has a .symtab), so the file itself is its symbol file (.sym).
      libxamarin-app.so  generated by the build, which also keeps the unstripped copy
                         libxamarin-app.dbg.so (with DWARF debug information, .dbg).

    The other native libraries (libmonosgen-2.0, libSystem.*, libSkiaSharp, the AOT images) come
    stripped from their packages, so the build has no symbols to give for them.

    Only Release app bundles; APKs and Debug builds are not changed.
  -->
  <Target Name="_PdfViewerAddNativeDebugSymbols"
          BeforeTargets="_BuildApkEmbed"
          Condition=" '$(AndroidPackageFormat)' == 'aab' And '$(Configuration)' == 'Release' ">
    <ItemGroup>
      <_PdfViewerRuntimeHost Include="@(FrameworkNativeLibrary)"
          Condition=" '%(Filename)' == 'libmono-android.release' Or '%(Filename)' == 'libnet-android.release' " />

      <_PdfViewerNativeSymbols Include="@(_PdfViewerRuntimeHost)" Abi="arm64-v8a" SymbolName="libmonodroid.so.sym"
          Condition=" $([System.String]::Copy('%(FullPath)').Contains('android-arm64')) " />
      <_PdfViewerNativeSymbols Include="@(_PdfViewerRuntimeHost)" Abi="x86_64" SymbolName="libmonodroid.so.sym"
          Condition=" $([System.String]::Copy('%(FullPath)').Contains('android-x64')) " />
      <_PdfViewerNativeSymbols Include="@(_PdfViewerRuntimeHost)" Abi="armeabi-v7a" SymbolName="libmonodroid.so.sym"
          Condition=" $([System.String]::Copy('%(FullPath)').Contains('android-arm')) And !$([System.String]::Copy('%(FullPath)').Contains('android-arm64')) " />
      <_PdfViewerNativeSymbols Include="@(_PdfViewerRuntimeHost)" Abi="x86" SymbolName="libmonodroid.so.sym"
          Condition=" $([System.String]::Copy('%(FullPath)').Contains('android-x86')) " />

      <_PdfViewerAppDbg Include="$(IntermediateOutputPath)app_shared_libraries/*/libxamarin-app.dbg.so" />
      <_PdfViewerNativeSymbols Include="@(_PdfViewerAppDbg)" SymbolName="libxamarin-app.so.dbg"
          Abi="$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)'))))" />

      <AndroidAppBundleMetaDataFile
          Include="@(_PdfViewerNativeSymbols->'com.android.tools.build.debugsymbols/%(Abi)/%(SymbolName):%(FullPath)')" />
    </ItemGroup>

    <Warning Condition=" '@(_PdfViewerNativeSymbols)' == '' "
             Text="No native debug symbols found for the app bundle; Google Play will warn that the bundle has no debug symbols." />
    <Message Importance="high"
             Text="Native debug symbols in the bundle: @(_PdfViewerNativeSymbols->'%(Abi)/%(SymbolName)', ', ')" />
  </Target>

</Project>
