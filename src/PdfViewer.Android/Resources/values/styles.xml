    <item name="android:colorAccent">#1F5FA8</item>
    <item name="android:statusBarColor">#ECEFF3</item>
    <item name="android:navigationBarColor">#ECEFF3</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>
</resources>
