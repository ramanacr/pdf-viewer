<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfEngine.Pdfium</RootNamespace>
    <AssemblyName>PdfEngine.Pdfium</AssemblyName>
    <Description>Google PDFium native adapter and safe interop engine for PDF processing.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEngine.Abstractions\PdfEngine.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\PdfViewer\runtimes\win-x64\native\pdfium.dll" Link="runtimes\win-x64\native\pdfium.dll" Condition="Exists('..\PdfViewer\runtimes\win-x64\native\pdfium.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>runtimes\win-x64\native\pdfium.dll</TargetPath>
    </None>
    <None Include="..\PdfViewer\runtimes\win-x64\native\pdfium.dll" Link="pdfium.dll" Condition="Exists('..\PdfViewer\runtimes\win-x64\native\pdfium.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>pdfium.dll</TargetPath>
    </None>
  </ItemGroup>

</Project>
