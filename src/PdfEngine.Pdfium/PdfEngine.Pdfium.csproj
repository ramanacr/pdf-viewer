<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfEngine.Pdfium</RootNamespace>
    <AssemblyName>PdfEngine.Pdfium</AssemblyName>
    <Description>Google PDFium native adapter and safe interop engine for PDF processing.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEngine.Abstractions\PdfEngine.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PKCS#7/CMS parsing and verification for PDF digital signatures. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfViewer.Tests" />
  </ItemGroup>

  <!--
    pdfium.dll is deployed once, beside the assembly: that is the first path the DllImport
    resolver in Native/PdfiumNativeBridge.cs tries, and the directory the default native probe
    searches (in a single-file publish, the bundle's extraction directory). A second copy under
    runtimes\win-x64\native\ was bundled into PdfViewer.exe as well, doubling its 7 MB.
  -->
  <ItemGroup>
    <None Include="..\PdfViewer\runtimes\win-x64\native\pdfium.dll" Link="pdfium.dll" Condition="Exists('..\PdfViewer\runtimes\win-x64\native\pdfium.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>pdfium.dll</TargetPath>
    </None>
  </ItemGroup>

</Project>
