<Application x:Class="PdfViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:PdfViewer.Converters"
             StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
                <ResourceDictionary Source="Themes/VectorIcons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:BoolToVisibilityConverter x:Key="BoolToVis" />
            <converters:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <converters:NullToVisibilityConverter x:Key="NullToVis" />
            <converters:EnumToBoolConverter x:Key="EnumToBool" />
            <converters:EnumToVisibilityConverter x:Key="EnumToVis" />
            <converters:NormalizedCoordinateConverter x:Key="NormalizedCoordConverter" />
            <converters:SearchHighlightBackgroundConverter x:Key="SearchHighlightBgConverter" />
            <converters:SearchHighlightBorderConverter x:Key="SearchHighlightBorderConverter" />
            <converters:HexToBrushConverter x:Key="HexToBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
