<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="AppBgColor">#F3F3F3</Color>
    <Color x:Key="SurfaceBgColor">#FFFFFF</Color>
    <Color x:Key="SurfaceAltBgColor">#F9F9FB</Color>
    <Color x:Key="BorderColor">#E0E0E0</Color>
    <Color x:Key="TextPrimaryColor">#1A1A1A</Color>
    <Color x:Key="TextSecondaryColor">#666666</Color>
    <Color x:Key="AccentColor">#0066CC</Color>
    <Color x:Key="AccentHoverColor">#0052A3</Color>
    <Color x:Key="AccentLightColor">#E6F0FA</Color>
    <Color x:Key="ToolbarBgColor">#FFFFFF</Color>
    <Color x:Key="SidebarBgColor">#F8F9FA</Color>
    <Color x:Key="DocumentViewportBgColor">#525659</Color>
    <Color x:Key="PageBgColor">#FFFFFF</Color>
    <Color x:Key="HighlightMatchColor">#FFE57F</Color>
    <Color x:Key="ActiveMatchColor">#FF9100</Color>

    <SolidColorBrush x:Key="AppBgBrush" Color="{StaticResource AppBgColor}" />
    <SolidColorBrush x:Key="SurfaceBgBrush" Color="{StaticResource SurfaceBgColor}" />
    <SolidColorBrush x:Key="SurfaceAltBgBrush" Color="{StaticResource SurfaceAltBgColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="ToolbarBgBrush" Color="{StaticResource ToolbarBgColor}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{StaticResource SidebarBgColor}" />
    <SolidColorBrush x:Key="DocumentViewportBgBrush" Color="{StaticResource DocumentViewportBgColor}" />
    <SolidColorBrush x:Key="PageBgBrush" Color="{StaticResource PageBgColor}" />
    <SolidColorBrush x:Key="HighlightMatchBrush" Color="{StaticResource HighlightMatchColor}" />
    <SolidColorBrush x:Key="ActiveMatchBrush" Color="{StaticResource ActiveMatchColor}" />

    <!-- Icons. ThemeManager swaps these for system colours while Windows high contrast is on. -->
    <SolidColorBrush x:Key="IconBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="IconAccentBrush" Color="{StaticResource AccentColor}" />

    <!--
        Keys the dark control styles (DarkControls.xaml) also read. In the light theme the
        controls keep Windows' own look, so these only repeat what the light theme already drew.
    -->
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#ABADB3" />
    <SolidColorBrush x:Key="SliderTrackBrush" Color="#D6D6D6" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#6D6D6D" />
    <!-- Text on an accent-coloured button. -->
    <SolidColorBrush x:Key="OnAccentTextBrush" Color="White" />
    <!-- Items of a menu that sets its own item style keep the system menu text colour, as before. -->
    <StaticResource x:Key="MenuPopupTextBrush" ResourceKey="{x:Static SystemColors.MenuTextBrushKey}" />

</ResourceDictionary>
