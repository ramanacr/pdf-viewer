<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows 10.0.19041 (20H1) is required to reach the built-in Windows.Media.Ocr engine,
      which provides real optical character recognition with no external dependency or
      licence. Windows 10 reached end of support in October 2025, so this floor excludes
      only already-unsupported systems.
    -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PdfViewer</RootNamespace>
    <AssemblyName>PdfViewer</AssemblyName>
    <ApplicationIcon>assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfViewer.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="assets\app_icon.ico" />
    <Resource Include="assets\app_icon.png" />
    <Resource Include="assets\pdf_file.ico" />
    <Resource Include="assets\pdf_file.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEngine.Abstractions\PdfEngine.Abstractions.csproj" />
    <ProjectReference Include="..\PdfEngine.Pdfium\PdfEngine.Pdfium.csproj" />
    <ProjectReference Include="..\PdfViewer.Core\PdfViewer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="runtimes\win-x64\native\pdfium.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>runtimes\win-x64\native\pdfium.dll</TargetPath>
    </None>
    <None Include="runtimes\win-x64\native\pdfium.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>pdfium.dll</TargetPath>
    </None>
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" Condition="Exists('..\..\THIRD_PARTY_NOTICES.md')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
