<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      Windows 10.0.19041 (20H1) is required to reach the built-in Windows.Media.Ocr engine.
      Windows 10 left support in October 2025, so this floor excludes only already
      unsupported systems.

      This TFM brings in the Windows SDK projection (Microsoft.Windows.SDK.NET.dll, ~24 MB).
      A filtered CsWinRT projection was tried to avoid that, but the transitive closure of
      Windows.Media.Ocr pulls in Storage, System and Devices anyway, so it bought nothing for
      considerable fragility. Single-file compression below reclaims the size instead.
    -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PdfViewer</RootNamespace>
    <AssemblyName>PdfViewer</AssemblyName>
    <ApplicationIcon>assets\app_icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    The vector engine is the only engine the published app has (M10). PDFium is the oracle of
    developer and test builds: with PdfiumRenderer=true, the default for builds and tests, the app
    references PdfEngine.Pdfium, ships pdfium.dll beside itself and offers the PDFium engine mode.
    scripts/build_publish.ps1 publishes with -p:PdfiumRenderer=false: no PdfEngine.Pdfium, no
    pdfium.dll, and every code path that uses PDFium is compiled out (#if PDFIUM_RENDERER).
  -->
  <PropertyGroup>
    <PdfiumRenderer Condition="'$(PdfiumRenderer)' == ''">true</PdfiumRenderer>
    <DefineConstants Condition="'$(PdfiumRenderer)' == 'true'">$(DefineConstants);PDFIUM_RENDERER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfViewer.Tests" />
  </ItemGroup>


  <ItemGroup>
    <Resource Include="assets\app_icon.ico" />
    <Resource Include="assets\app_icon.png" />
    <Resource Include="assets\pdf_file.ico" />
    <Resource Include="assets\pdf_file.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="System.Speech" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEngine.Abstractions\PdfEngine.Abstractions.csproj" />
    <ProjectReference Include="..\PdfEngine.Vector\PdfEngine.Vector.csproj" />
    <ProjectReference Include="..\PdfEngine.Vector.Windows\PdfEngine.Vector.Windows.csproj" />
    <ProjectReference Include="..\PdfEngine.Vector.Direct2D\PdfEngine.Vector.Direct2D.csproj" />
    <ProjectReference Include="..\PdfViewer.Core\PdfViewer.Core.csproj" />
  </ItemGroup>

  <!--
    Read Aloud is an optional component the installer can leave out, so a user who does not
    want it does not carry it. That only works if the speech assembly stays a loose file
    beside the executable rather than being bundled inside it, hence the exclusion below.

    Nothing outside TextReaderFactory may touch a System.Speech type: the runtime resolves an
    assembly when it first JITs a method that mentions one, so a stray reference in a method
    on the startup path would turn "not installed" into "will not start".
  -->
  <Target Name="KeepSpeechOutOfTheSingleFileBundle" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Condition="'%(Filename)%(Extension)' == 'System.Speech.dll'">
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

  <!--
    PDFium, in developer and test builds only. One copy of pdfium.dll, beside the application (the
    resolvers in Services/PdfiumNativeBridge.cs and PdfEngine.Pdfium try that path first).
    Publishing it to runtimes\win-x64\native\ as well bundled it twice. A PdfiumRenderer=false
    build neither references PdfEngine.Pdfium nor copies pdfium.dll anywhere.
  -->
  <ItemGroup Condition="'$(PdfiumRenderer)' == 'true'">
    <ProjectReference Include="..\PdfEngine.Pdfium\PdfEngine.Pdfium.csproj" />
    <None Include="runtimes\win-x64\native\pdfium.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>pdfium.dll</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup Condition="'$(PdfiumRenderer)' != 'true'">
    <None Remove="runtimes\win-x64\native\pdfium.dll" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\THIRD_PARTY_NOTICES.md" Link="THIRD_PARTY_NOTICES.md" Condition="Exists('..\..\THIRD_PARTY_NOTICES.md')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
