<Window x:Class="PdfViewer.Views.Dialogs.ExportImagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Export Pages as Images"
        Icon="pack://application:,,,/assets/app_icon.png"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/LightTheme.xaml" />
                <ResourceDictionary Source="../../Themes/VectorIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Export PDF Pages to Images"
                   FontSize="16"
                   FontWeight="Bold"
                   Margin="0,0,0,16" />

        <!-- Output Folder -->
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="Output Folder:" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="FolderPathBox" Padding="6,4" VerticalContentAlignment="Center" Margin="0,0,8,0" />
                <Button Grid.Column="1" Content="Browse..." Width="80" Height="28" Click="BrowseFolder_Click" />
            </Grid>
        </StackPanel>

        <!-- File Prefix & Format -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="120" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="File Name Prefix:" FontWeight="SemiBold" Margin="0,0,0,4" />
                <TextBox x:Name="PrefixBox" Padding="6,4" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Format:" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox x:Name="FormatComboBox" SelectedIndex="0" Height="28">
                    <ComboBoxItem Content="PNG (*.png)" Tag="PNG" />
                    <ComboBoxItem Content="JPEG (*.jpg)" Tag="JPEG" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Resolution DPI -->
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <TextBlock Text="Resolution (DPI):" FontWeight="SemiBold" Margin="0,0,0,4" />
            <ComboBox x:Name="DpiComboBox" SelectedIndex="1" Height="28">
                <ComboBoxItem Content="150 DPI (Standard Screen)" Tag="150" />
                <ComboBoxItem Content="300 DPI (High Quality Print)" Tag="300" />
                <ComboBoxItem Content="600 DPI (Ultra Sharp)" Tag="600" />
            </ComboBox>
        </StackPanel>

        <!-- Page Range -->
        <GroupBox Grid.Row="4" Header="Page Range" Padding="8" Margin="0,0,0,20">
            <StackPanel>
                <RadioButton x:Name="AllPagesRadio" Content="All Pages" IsChecked="True" Margin="0,0,0,6" />
                <RadioButton x:Name="CurrentPageRadio" Content="Current Page Only" Margin="0,0,0,6" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RangeRadio" Content="Page Range:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="StartPageBox" Width="45" Padding="4,2" Text="1" TextAlignment="Center" Margin="0,0,4,0" />
                    <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="EndPageBox" Width="45" Padding="4,2" Text="1" TextAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="85" Height="32" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click" />
            <Button Content="Export" Width="85" Height="32" IsDefault="True" Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" Click="ExportButton_Click" />
        </StackPanel>
    </Grid>
</Window>
