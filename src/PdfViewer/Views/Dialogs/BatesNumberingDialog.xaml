<Window x:Class="PdfViewer.Views.Dialogs.BatesNumberingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:PdfViewer.Views.Dialogs"
        Title="{Binding Title}"
        Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="Bates Numbering" FontSize="16" FontWeight="Bold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"
                       Text="Numbers every page of the range in sequence, for legal and business documents: a prefix, a number of fixed digits and a suffix." />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Prefix" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,2" Text="{Binding Prefix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Prefix" />
                <TextBlock Grid.Row="1" Text="Suffix" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,2" Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Suffix" />
                <TextBlock Grid.Row="2" Text="Start number" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Width="100" HorizontalAlignment="Left" Margin="0,2" Text="{Binding Start, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Start number" />
                <TextBlock Grid.Row="3" Text="Digits" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Width="60" HorizontalAlignment="Left" Margin="0,2" Text="{Binding Digits, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Number of digits" />
                <TextBlock Grid.Row="4" Text="Position" VerticalAlignment="Center" />
                <ComboBox Grid.Row="4" Grid.Column="1" Width="180" HorizontalAlignment="Left" Margin="0,2" ItemsSource="{Binding Positions}" SelectedItem="{Binding Position}" AutomationProperties.Name="Position" />
                <TextBlock Grid.Row="5" Text="First number" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding Sample}" FontFamily="Consolas" FontWeight="SemiBold" />
            </Grid>

            <TextBlock Text="Font" FontWeight="SemiBold" Margin="0,14,0,4" />
            <StackPanel Orientation="Horizontal">
                <ComboBox Width="200" ItemsSource="{Binding FontFamilies}" Text="{Binding FontFamily}" IsEditable="True" AutomationProperties.Name="Font" />
                <TextBlock Text="Size" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Width="48" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Font size" />
                <TextBlock Text="Colour" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Width="80" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Text colour" />
            </StackPanel>

            <TextBlock Text="Margins (points)" FontWeight="SemiBold" Margin="0,12,0,4" />
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Top" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Width="48" Text="{Binding TopMargin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Top margin" />
                <TextBlock Text="Bottom" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Width="48" Text="{Binding BottomMargin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bottom margin" />
                <TextBlock Text="Left" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Width="48" Text="{Binding LeftMargin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Left margin" />
                <TextBlock Text="Right" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Width="48" Text="{Binding RightMargin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Right margin" />
            </StackPanel>
        </StackPanel>
        <d:PageMarkCommonPanel Grid.Column="2" />
    </Grid>
</Window>
