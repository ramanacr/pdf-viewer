<Window x:Class="PdfViewer.Views.Dialogs.PdfAWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfViewer.ViewModels"
        Title="PDF/A"
        Width="760" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding ClaimText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Standard" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox ItemsSource="{Binding Flavours}" SelectedItem="{Binding SelectedFlavour}" Width="120" AutomationProperties.Name="PDF/A part and level" />
                <Button Content="_Check" Margin="12,0,0,0" Padding="14,3" Click="Check_Click"
                        ToolTip="Checks every requirement of the chosen part and level, and lists what the document does not meet." />
                <Button Content="Convert and _Save..." Margin="8,0,0,0" Padding="14,3" Click="Convert_Click" IsEnabled="{Binding CanConvert}"
                        ToolTip="Writes a PDF/A copy (PDF/A-2b or -3b): fonts embedded, colour profiled, metadata written, scripts removed. The original is not changed." />
                <Button x:Name="OpenButton" Content="_Open Copy" Margin="8,0,0,0" Padding="14,3" Click="Open_Click" Visibility="Collapsed" />
            </StackPanel>
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Requirements not met" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <ListView Grid.Row="1" ItemsSource="{Binding Issues}" AutomationProperties.Name="Requirements not met" BorderThickness="1"
                      BorderBrush="{DynamicResource BorderBrush}" Background="Transparent">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Rule (ISO 19005)" Width="120" DisplayMemberBinding="{Binding Rule}" />
                        <GridViewColumn Header="What" Width="430">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type vm:PdfAIssueItem}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="420" />
                                        <TextBlock Text="{Binding Location}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Occurs" Width="80" DisplayMemberBinding="{Binding CountText}" />
                    </GridView>
                </ListView.View>
            </ListView>
            <TextBlock Grid.Row="2" Text="Changes made in the copy" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,4" />
            <ListBox Grid.Row="3" ItemsSource="{Binding Changes}" Height="130" AutomationProperties.Name="Changes made" BorderThickness="1"
                     BorderBrush="{DynamicResource BorderBrush}" Background="Transparent" />
        </Grid>
    </DockPanel>
</Window>
