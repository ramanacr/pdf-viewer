<Window x:Class="PdfViewer.Views.Dialogs.ScanWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PdfViewer.Views.Dialogs"
        Title="Create PDF from Scanner"
        Icon="pack://application:,,,/PdfViewer;component/assets/app_icon.png"
        Width="660" Height="560" MinWidth="520" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="Create PDF from Scanner" FontSize="18" FontWeight="SemiBold" />
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                       Text="Scans with Windows Image Acquisition and the scanner's own driver. Scan as often as you need: each scan adds its pages. The pages stay on this computer." />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="True" AutomationProperties.Name="Progress">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="_Scan" Padding="14,3" Margin="8,0,0,0" Click="Scan_Click" IsEnabled="{Binding CanScan}" />
                    <Button Content="_Create PDF..." Padding="14,3" Margin="8,0,0,0" IsDefault="True" Click="Create_Click" IsEnabled="{Binding CanCreate}" />
                    <Button x:Name="CancelButton" Content="Close" Padding="14,3" Margin="8,0,0,0" Click="Cancel_Click" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Scanner" Margin="0,0,0,4" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="_Refresh" Padding="8,2" Margin="6,0,0,0" Click="Refresh_Click" />
                    <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" DisplayMemberPath="Name" AutomationProperties.Name="Scanner" />
                </DockPanel>
                <TextBlock Text="Colour" Margin="0,12,0,4" />
                <ComboBox ItemsSource="{Binding ColorModes}" SelectedIndex="{Binding ColorModeIndex}" AutomationProperties.Name="Colour" />
                <TextBlock Text="Resolution (dpi)" Margin="0,12,0,4" />
                <ComboBox ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Dpi}" AutomationProperties.Name="Resolution in dots per inch" />
                <CheckBox Content="Use the document _feeder (every page in it)" IsChecked="{Binding UseFeeder}" IsEnabled="{Binding CanUseFeeder}" Margin="0,12,0,0" />
                <CheckBox Content="_Both sides (duplex)" IsChecked="{Binding Duplex}" IsEnabled="{Binding CanDuplex}" Margin="20,6,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <TextBlock Text="{Binding PagesText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Button Content="Remove _Last Page" Padding="8,2" Margin="12,0,0,0" Click="RemoveLast_Click" IsEnabled="{Binding CanCreate}" />
                </StackPanel>
            </StackPanel>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <dialogs:CreatePdfOptionsPanel DataContext="{Binding Options}" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
