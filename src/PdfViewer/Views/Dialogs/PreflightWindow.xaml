<Window x:Class="PdfViewer.Views.Dialogs.PreflightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfViewer.ViewModels"
        Title="Preflight"
        Width="920" Height="640"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,4">
                <Label Content="_Profile" Target="{Binding ElementName=ProfileBox}" Padding="0,0,8,0" VerticalAlignment="Center" />
                <ComboBox x:Name="ProfileBox" Width="260" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                          AutomationProperties.Name="Preflight profile" />
                <Button Content="_Analyze" Padding="14,3" Margin="8,0,0,0" Click="Run_Click" IsEnabled="{Binding CanRun}" IsDefault="True"
                        ToolTip="Checks the document against the profile. Nothing in the document is changed." />
            </StackPanel>
            <TextBlock Text="{Binding ProfileDescription}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" />
            <TextBlock x:Name="SummaryText" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"
                       AutomationProperties.Name="{Binding Summary}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Export as _Text..." Padding="14,3" Click="ExportText_Click" IsEnabled="{Binding HasReport}"
                    ToolTip="Saves the report as plain text: rules, pages, object numbers and measures, no page text." />
            <Button Content="Export as _JSON..." Padding="14,3" Margin="8,0,0,0" Click="ExportJson_Click" IsEnabled="{Binding HasReport}"
                    ToolTip="Saves the report as JSON for other tools: rules, pages, bounds, object numbers and measures, no page text." />
            <Button Content="Close" Padding="14,3" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Content="_Results by severity" Target="{Binding ElementName=FindingTree}" Padding="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TreeView x:Name="FindingTree" Grid.Row="1" ItemsSource="{Binding Groups}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent"
                      AutomationProperties.Name="Preflight results by severity"
                      AutomationProperties.HelpText="Use the arrow keys to move between results. Selecting a result on a page shows it in the document."
                      SelectedItemChanged="FindingTree_SelectedItemChanged" KeyDown="FindingTree_KeyDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <Setter Property="Padding" Value="2,3" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:PreflightFindingGroup}" ItemsSource="{Binding Findings}">
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type vm:PreflightFindingItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding RuleId}" Width="56" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="400" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
            <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="6" HorizontalAlignment="Center" Background="Transparent" Focusable="False" />
            <TextBlock Grid.Column="2" Text="Details" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <ScrollViewer Grid.Column="2" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel DataContext="{Binding SelectedFinding}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding SeverityText}" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="Result" Margin="0,0,0,10" />
                    <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding Measure}" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding RuleId, StringFormat='Rule {0}'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                    <Button Content="_Show on Page" HorizontalAlignment="Left" Padding="14,3" Click="Show_Click" IsEnabled="{Binding HasPage}"
                            ToolTip="Goes to the page and highlights the object, when its position is known." />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
