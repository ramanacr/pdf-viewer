<Window x:Class="PdfViewer.Views.Dialogs.PrivacyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Privacy &amp; Safety"
        Height="560" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBrush}"
        ResizeMode="NoResize"
        ShowInTaskbar="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Privacy &amp; Safety"
                       FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="StatementText"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       LineHeight="19"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="GuaranteeList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="13"
                                           Margin="0,2,10,0"
                                           Foreground="#2E9E5B" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Claim}"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Evidence}"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <CheckBox Grid.Row="2"
                  x:Name="UpdateCheckBox"
                  Margin="0,16,0,0"
                  Foreground="{DynamicResource TextPrimaryBrush}">
            <TextBlock TextWrapping="Wrap">
                Check GitHub for new versions when the application starts.
                <LineBreak />
                <Run Foreground="{DynamicResource TextSecondaryBrush}"
                     Text="This is the only network request the application can make. Leave it off to stay completely offline." />
            </TextBlock>
        </CheckBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="ConfirmButton"
                    Content="Save"
                    MinWidth="100" Padding="12,6"
                    IsDefault="True"
                    Click="ConfirmButton_Click" />
        </StackPanel>
    </Grid>
</Window>
