<Window x:Class="PdfViewer.Views.Dialogs.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PdfViewer.Views"
        xmlns:vm="clr-namespace:PdfViewer.ViewModels"
        Title="Compare Documents"
        Width="1400" Height="900"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Summary and options -->
        <Border Grid.ColumnSpan="3" Padding="14,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" Margin="0,0,16,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox x:Name="SyncCheck" Content="Scroll together" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
                <TextBlock Text="{Binding Summary}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>

        <!-- The list of differences -->
        <DockPanel Grid.Row="1" Grid.Column="0">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8">
                <Button Content="◀ Previous" Padding="8,2" Margin="0,0,6,0" Click="Previous_Click" AutomationProperties.Name="Previous difference" />
                <Button Content="Next ▶" Padding="8,2" Click="Next_Click" AutomationProperties.Name="Next difference" />
            </StackPanel>
            <ListBox x:Name="ChangeList" ItemsSource="{Binding Changes}" SelectedItem="{Binding SelectedChange}" BorderThickness="0"
                     Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Differences"
                     SelectionChanged="ChangeList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CompareChangeItem}">
                        <StackPanel Margin="4,4">
                            <TextBlock>
                                <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text=" · " />
                                <Run Text="{Binding Where, Mode=OneWay}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Old and new, side by side -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <TextBlock DockPanel.Dock="Top" Text="{Binding OldName, StringFormat='Old: {0}'}" Margin="10,8" FontWeight="SemiBold" />
            <ScrollViewer x:Name="OldScroll" Background="{DynamicResource DocumentViewportBgBrush}" ScrollChanged="OldScroll_ScrollChanged" AutomationProperties.Name="Old document">
                <ItemsControl x:Name="OldItems" ItemsSource="{Binding OldPages}" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:ComparePageView Page="{Binding}" DisplayWidth="{Binding DataContext.PageWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   SelectedChange="{Binding DataContext.SelectedChange.Index, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=-1}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
        <DockPanel Grid.Row="1" Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="{Binding NewName, StringFormat='New: {0}'}" Margin="10,8" FontWeight="SemiBold" />
            <ScrollViewer x:Name="NewScroll" Background="{DynamicResource DocumentViewportBgBrush}" ScrollChanged="NewScroll_ScrollChanged" AutomationProperties.Name="New document">
                <ItemsControl x:Name="NewItems" ItemsSource="{Binding NewPages}" Margin="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <views:ComparePageView Page="{Binding}" DisplayWidth="{Binding DataContext.PageWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   SelectedChange="{Binding DataContext.SelectedChange.Index, RelativeSource={RelativeSource AncestorType=Window}, FallbackValue=-1}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
