<Window x:Class="PdfViewer.Views.Dialogs.BackgroundDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:PdfViewer.Views.Dialogs"
        Title="{Binding Title}"
        Width="900" Height="620" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Background" FontSize="16" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"
                           Text="A colour, a picture or a page of a PDF behind each page's content." />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Source" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="120" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" AutomationProperties.Name="Source" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding IsColorSource, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Colour" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="100" Text="{Binding FillColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Background colour"
                             ToolTip="A colour as #RRGGBB, or a name such as LightYellow." />
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsFileSource, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="_Browse..." Padding="10,3" Margin="8,0,0,0" Click="Browse_Click" />
                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="File" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsPageSource, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="48" Text="{Binding SourcePage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Page of the PDF" />
                    </StackPanel>

                    <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,14,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="100" ItemsSource="{Binding HorizontalAlignments}" SelectedItem="{Binding Horizontal}" AutomationProperties.Name="Horizontal alignment" />
                        <ComboBox Width="100" Margin="8,0,0,0" ItemsSource="{Binding VerticalAlignments}" SelectedItem="{Binding Vertical}" AutomationProperties.Name="Vertical alignment" />
                        <TextBlock Text="Rotation" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Width="48" Text="{Binding Rotation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rotation in degrees" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Scale %" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="48" Text="{Binding ScalePercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scale" />
                        <CheckBox Content="Relative to the page:" IsChecked="{Binding UseRelativeScale}" VerticalAlignment="Center" Margin="16,0,6,0" />
                        <TextBox Width="48" Text="{Binding RelativeScalePercent, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseRelativeScale}"
                                 AutomationProperties.Name="Size relative to the page, percent" />
                        <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Opacity %" FontWeight="SemiBold" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                    <Slider Width="160" Minimum="0" Maximum="100" Value="{Binding OpacityPercent}" VerticalAlignment="Center" AutomationProperties.Name="Opacity" />
                    <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0:0}}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <d:PageMarkCommonPanel Grid.Column="2" />
    </Grid>
</Window>
