<Window x:Class="PdfViewer.Views.Dialogs.ProtectDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protect with Password"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,4,12,4" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="20">
        <TextBlock Text="Protect with Password" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />

        <!-- Open password -->
        <CheckBox x:Name="RequireOpenCheck" Content="Require a password to open the document" FontWeight="SemiBold"
                  Checked="Option_Changed" Unchecked="Option_Changed" />
        <Grid x:Name="OpenPasswordGrid" Margin="22,2,0,10" IsEnabled="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Open password" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="OpenPasswordBox" Grid.Column="1" AutomationProperties.Name="Open password" PasswordChanged="Password_Changed" />
            <TextBlock Grid.Row="1" Text="Confirm" Style="{StaticResource FieldLabel}" />
            <PasswordBox x:Name="OpenConfirmBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Confirm open password" PasswordChanged="Password_Changed" />
        </Grid>

        <!-- Permissions -->
        <CheckBox x:Name="RestrictCheck" Content="Restrict printing, editing and copying" FontWeight="SemiBold"
                  Checked="Option_Changed" Unchecked="Option_Changed" />
        <StackPanel x:Name="PermissionsPanel" Margin="22,2,0,10" IsEnabled="False">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Permissions password" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="OwnerPasswordBox" Grid.Column="1" AutomationProperties.Name="Permissions password" PasswordChanged="Password_Changed" />
                <TextBlock Grid.Row="1" Text="Confirm" Style="{StaticResource FieldLabel}" />
                <PasswordBox x:Name="OwnerConfirmBox" Grid.Row="1" Grid.Column="1" AutomationProperties.Name="Confirm permissions password" PasswordChanged="Password_Changed" />
                <TextBlock Grid.Row="2" Text="Printing allowed" Style="{StaticResource FieldLabel}" />
                <ComboBox x:Name="PrintingCombo" Grid.Row="2" Grid.Column="1" Height="28" Margin="0,4,0,4" SelectedIndex="2"
                          AutomationProperties.Name="Printing allowed">
                    <ComboBoxItem Content="None" />
                    <ComboBoxItem Content="Low resolution (150 dpi)" />
                    <ComboBoxItem Content="High resolution" />
                </ComboBox>
            </Grid>
            <CheckBox x:Name="ChangeCheck" Content="Changing the document" IsChecked="True" />
            <CheckBox x:Name="CopyCheck" Content="Copying text, images and other content" IsChecked="True" />
            <CheckBox x:Name="AccessibilityCheck" Content="Text access for screen readers" IsChecked="True" />
            <CheckBox x:Name="CommentCheck" Content="Commenting (also allows filling in forms)" IsChecked="True" />
            <CheckBox x:Name="FormsCheck" Content="Filling in forms and signing" IsChecked="True" />
            <CheckBox x:Name="AssembleCheck" Content="Inserting, deleting and rotating pages" IsChecked="True" />
        </StackPanel>

        <!-- Options -->
        <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Encryption" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="StrengthCombo" Grid.Column="1" Height="28" SelectedIndex="0" AutomationProperties.Name="Encryption">
                <ComboBoxItem Content="AES-256 (Acrobat X and later)" />
                <ComboBoxItem Content="AES-128 (Acrobat 7 and later)" />
            </ComboBox>
        </Grid>
        <CheckBox x:Name="EncryptMetadataCheck" IsChecked="True" Margin="0,8,0,0"
                  Content="Encrypt metadata (clear it to let search engines read the title and keywords)" />

        <TextBlock x:Name="ErrorText" Foreground="#D93025" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <Border Background="{DynamicResource SurfaceAltBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="10,8" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="A protected copy is saved under a new name. Keep the passwords safe: a forgotten open password cannot be recovered." />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ProtectButton" Content="Protect..." Width="100" Height="32" IsDefault="True" IsEnabled="False"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="Protect_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" Width="80" Height="32" IsCancel="True"
                    Background="{DynamicResource SurfaceAltBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />
        </StackPanel>
    </StackPanel>
</Window>
