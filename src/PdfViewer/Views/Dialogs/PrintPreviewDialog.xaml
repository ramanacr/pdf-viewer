<Window x:Class="PdfViewer.Views.Dialogs.PrintPreviewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfViewer.ViewModels"
        Title="Print Document"
        Icon="pack://application:,,,/assets/app_icon.png"
        Width="880"
        Height="640"
        MinHeight="550"
        MinWidth="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/LightTheme.xaml" />
                <ResourceDictionary Source="../../Themes/VectorIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Print Document" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="Configure printer settings and inspect live document print preview." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Main Content Area: Left = Live Preview, Right = Settings -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="380" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Live Interactive Print Preview -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Preview Top Banner -->
                    <TextBlock Grid.Row="0"
                               Text="PRINT PREVIEW"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8" />

                    <!-- Live Page Display -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource BorderBrush}"
                            CornerRadius="4"
                            ClipToBounds="True"
                            Padding="8">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- Paper Sheet Shadow -->
                            <Border Background="White"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    CornerRadius="2"
                                    Effect="{DynamicResource PageShadowEffect}">
                                <Image Source="{Binding PreviewImage}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <!-- Loading Spinner Indicator -->
                            <Border Background="#99000000"
                                    CornerRadius="4"
                                    Padding="16,8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Rendering Preview..."
                                           Foreground="White"
                                           FontWeight="SemiBold"
                                           FontSize="12" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Preview Pagination Bar -->
                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Style="{StaticResource ToolbarIconButton}"
                                Command="{Binding FirstPreviewPageCommand}"
                                ToolTip="First Page"
                                Margin="2,0">
                            <TextBlock Text="|&#x25C0;" FontWeight="Bold" FontSize="11" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}"
                                Command="{Binding PrevPreviewPageCommand}"
                                ToolTip="Previous Page"
                                Margin="2,0">
                            <Path Data="{StaticResource IconArrowLeft}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>

                        <TextBlock VerticalAlignment="Center" Margin="8,0">
                            <Run Text="Page" />
                            <Run Text="{Binding PreviewPageNumber, Mode=OneWay}" FontWeight="Bold" />
                            <Run Text="of" />
                            <Run Text="{Binding PreviewPageCount, Mode=OneWay}" FontWeight="Bold" />
                        </TextBlock>

                        <Button Style="{StaticResource ToolbarIconButton}"
                                Command="{Binding NextPreviewPageCommand}"
                                ToolTip="Next Page"
                                Margin="2,0">
                            <Path Data="{StaticResource IconArrowRight}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource ToolbarIconButton}"
                                Command="{Binding LastPreviewPageCommand}"
                                ToolTip="Last Page"
                                Margin="2,0">
                            <TextBlock Text="&#x25B6;|" FontWeight="Bold" FontSize="11" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- RIGHT: Print Settings & Controls -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,4,0">
                    <!-- 1. Destination Printer -->
                    <GroupBox Header="Destination Printer"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="0,0,0,12"
                              Padding="10">
                        <StackPanel>
                            <ComboBox ItemsSource="{Binding Printers}"
                                      SelectedItem="{Binding SelectedPrinter}"
                                      DisplayMemberPath="Name"
                                      Height="28"
                                      VerticalContentAlignment="Center" />
                            <TextBlock Text="{Binding SelectedPrinter.Status, StringFormat='Status: {0}'}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. Pages to Print -->
                    <GroupBox Header="Page Range"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="0,0,0,12"
                              Padding="10">
                        <StackPanel>
                            <RadioButton Content="All Pages"
                                         IsChecked="{Binding RangeMode, Converter={StaticResource EnumToBool}, ConverterParameter=AllPages}"
                                         Margin="0,0,0,6" />
                            <RadioButton Content="Current Page"
                                         IsChecked="{Binding RangeMode, Converter={StaticResource EnumToBool}, ConverterParameter=CurrentPage}"
                                         Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Content="Pages:"
                                             IsChecked="{Binding RangeMode, Converter={StaticResource EnumToBool}, ConverterParameter=CustomRange}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0" />
                                <TextBox Text="{Binding CustomPageRange, UpdateSourceTrigger=PropertyChanged}"
                                         Width="160"
                                         Height="24"
                                         VerticalContentAlignment="Center"
                                         IsEnabled="{Binding RangeMode, Converter={StaticResource EnumToBool}, ConverterParameter=CustomRange}"
                                         ToolTip="Example: 1-5, 8, 11-13" />
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- 3. Copies & Collate -->
                    <GroupBox Header="Copies"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="0,0,0,12"
                              Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Number of copies:" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBox Grid.Column="1"
                                     Text="{Binding Copies, UpdateSourceTrigger=PropertyChanged}"
                                     Height="24"
                                     VerticalContentAlignment="Center"
                                     TextAlignment="Center" />
                            <CheckBox Grid.Column="2"
                                      Content="Collate"
                                      IsChecked="{Binding Collate}"
                                      VerticalAlignment="Center"
                                      Margin="16,0,0,0" />
                        </Grid>
                    </GroupBox>

                    <!-- 4. Layout & Orientation -->
                    <GroupBox Header="Layout &amp; Orientation"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="0,0,0,12"
                              Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Auto-Orient"
                                         IsChecked="{Binding Orientation, Converter={StaticResource EnumToBool}, ConverterParameter=Auto}"
                                         Margin="0,0,16,0" />
                            <RadioButton Content="Portrait"
                                         IsChecked="{Binding Orientation, Converter={StaticResource EnumToBool}, ConverterParameter=Portrait}"
                                         Margin="0,0,16,0" />
                            <RadioButton Content="Landscape"
                                         IsChecked="{Binding Orientation, Converter={StaticResource EnumToBool}, ConverterParameter=Landscape}" />
                        </StackPanel>
                    </GroupBox>

                    <!-- 5. Color Mode -->
                    <GroupBox Header="Color Mode"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              Margin="0,0,0,12"
                              Padding="10">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Color"
                                         IsChecked="{Binding ColorMode, Converter={StaticResource EnumToBool}, ConverterParameter=Color}"
                                         Margin="0,0,24,0" />
                            <RadioButton Content="Grayscale / Black &amp; White"
                                         IsChecked="{Binding ColorMode, Converter={StaticResource EnumToBool}, ConverterParameter=Grayscale}" />
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusMessage}"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Width="90"
                            Height="30"
                            Margin="0,0,10,0"
                            Style="{StaticResource FlatButtonStyle}" />
                    <Button Content="Print"
                            Command="{Binding ExecutePrintCommand}"
                            Width="110"
                            Height="30"
                            FontWeight="SemiBold"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
