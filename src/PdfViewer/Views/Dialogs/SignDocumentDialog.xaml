<Window x:Class="PdfViewer.Views.Dialogs.SignDocumentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign Document"
        Width="520"
        SizeToContent="Height"
        MaxHeight="{x:Static SystemParameters.MaximizedPrimaryScreenHeight}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText" Text="Sign Document" FontSize="16" FontWeight="Bold" Margin="0,0,0,4" />
        <TextBlock x:Name="PlacementText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />

        <!-- Signing identity -->
        <TextBlock Text="Sign as" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
        <Grid Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="CertificateCombo" Height="44" AutomationProperties.Name="Signing certificate"
                      SelectionChanged="CertificateCombo_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,1">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="Certificate file..." Margin="8,0,0,0" Height="44"
                    Style="{StaticResource SecondaryButton}" Click="BrowseCertificate_Click"
                    ToolTip="Sign with a .pfx or .p12 file" />
        </Grid>
        <Grid x:Name="PfxPasswordRow" Visibility="Collapsed" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="File password" Style="{StaticResource FieldLabel}" />
            <PasswordBox Grid.Column="1" x:Name="PfxPasswordBox" Height="28" Padding="6,4"
                         AutomationProperties.Name="Certificate file password"
                         Background="{DynamicResource SurfaceAltBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}" />
        </Grid>
        <TextBlock x:Name="NoCertificateText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,4,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="No signing certificate was found in your personal certificate store. Use a certificate file, or install a digital ID from your organisation or a certificate authority." />

        <!-- Approval or certification -->
        <Grid x:Name="CertifyRow" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="Signature type" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Column="1" x:Name="CertifyCombo" Height="28" SelectedIndex="0" AutomationProperties.Name="Signature type">
                <ComboBoxItem Content="Approve - others can still fill in, sign and comment" />
                <ComboBoxItem Content="Certify - allow filling in forms and signing" />
                <ComboBoxItem Content="Certify - allow filling in, signing and commenting" />
                <ComboBoxItem Content="Certify - allow no changes" />
            </ComboBox>
        </Grid>

        <!-- Details recorded in the signature -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Reason" Style="{StaticResource FieldLabel}" />
            <ComboBox Grid.Column="1" x:Name="ReasonBox" IsEditable="True" Height="28" AutomationProperties.Name="Reason for signing">
                <ComboBoxItem Content="I am the author of this document" />
                <ComboBoxItem Content="I have reviewed this document" />
                <ComboBoxItem Content="I approve this document" />
                <ComboBoxItem Content="I agree to the terms defined by this document" />
            </ComboBox>
            <TextBlock Grid.Row="1" Text="Location" Style="{StaticResource FieldLabel}" Margin="0,8,10,0" />
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="LocationBox" Style="{StaticResource FieldBox}" Margin="0,8,0,0"
                     AutomationProperties.Name="Location" />
            <TextBlock Grid.Row="2" Text="Contact" Style="{StaticResource FieldLabel}" Margin="0,8,10,0" />
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ContactBox" Style="{StaticResource FieldBox}" Margin="0,8,0,0"
                     AutomationProperties.Name="Contact information" />
        </Grid>

        <!-- How the visible signature looks -->
        <StackPanel x:Name="AppearancePanel" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Appearance" Style="{StaticResource FieldLabel}" />
                <ComboBox Grid.Column="1" x:Name="LayoutCombo" Height="28" SelectedIndex="0" AutomationProperties.Name="Signature appearance"
                          SelectionChanged="LayoutCombo_SelectionChanged">
                    <ComboBoxItem Content="Details as text" Tag="TextOnly" />
                    <ComboBoxItem Content="Name and details" Tag="NameAndText" />
                    <ComboBoxItem Content="Signature image and details" Tag="ImageAndText" />
                    <ComboBoxItem Content="Signature image only" Tag="ImageOnly" />
                </ComboBox>
            </Grid>
            <StackPanel x:Name="ImagePanel" Visibility="Collapsed" Margin="110,8,0,0">
                <Border Height="96" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="White">
                    <Grid>
                        <Image x:Name="ImagePreview" Stretch="Uniform" Margin="6" AutomationProperties.Name="Signature image" />
                        <TextBlock x:Name="ImageHint" Text="Choose a picture of your signature, or draw it here."
                                   Foreground="#666666" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="8" />
                        <InkCanvas x:Name="DrawCanvas" Visibility="Collapsed" Background="Transparent"
                                   AutomationProperties.Name="Draw your signature with the mouse, a pen or a finger" />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Choose image..." Style="{StaticResource SecondaryButton}" Click="ChooseImage_Click"
                            ToolTip="A PNG (transparent background works best) or JPEG picture of your signature" />
                    <Button x:Name="DrawButton" Content="Draw" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Draw_Click"
                            ToolTip="Draw your signature with the mouse, a pen or a finger" />
                    <Button Content="Clear" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="ClearImage_Click" />
                </StackPanel>
                <CheckBox x:Name="RememberImageCheck" Margin="0,6,0,0" Foreground="{DynamicResource TextPrimaryBrush}"
                          Content="Remember this signature image on this computer"
                          ToolTip="Kept in your own profile on this computer, never in a document. Untick to delete it." />
            </StackPanel>
            <WrapPanel Margin="110,8,0,0">
                <CheckBox x:Name="ShowDateCheck" Content="Date" IsChecked="True" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                <CheckBox x:Name="ShowReasonCheck" Content="Reason" IsChecked="True" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                <CheckBox x:Name="ShowLocationCheck" Content="Location" IsChecked="True" Margin="0,0,12,0" Foreground="{DynamicResource TextPrimaryBrush}" />
                <CheckBox x:Name="ShowLabelsCheck" Content="Labels" IsChecked="True" Foreground="{DynamicResource TextPrimaryBrush}"
                          ToolTip="&quot;Digitally signed by&quot;, &quot;Date:&quot; and the like before the details" />
            </WrapPanel>
        </StackPanel>

        <!-- Timestamp -->
        <CheckBox x:Name="TimestampCheck" Margin="0,16,0,4" Content="Add a timestamp from a time-stamping authority"
                  Foreground="{DynamicResource TextPrimaryBrush}" Checked="TimestampCheck_Changed" Unchecked="TimestampCheck_Changed" />
        <TextBox x:Name="TimestampBox" Style="{StaticResource FieldBox}" AutomationProperties.Name="Timestamp server address"
                 ToolTip="The server's address, for example one your organisation provides" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"
                   Text="A timestamp proves when you signed. Only a fingerprint of the signature is sent to the server, never the document." />
        <CheckBox x:Name="DocTimestampCheck" Margin="0,8,0,0" IsChecked="False" IsEnabled="False"
                  Content="Also add a document timestamp (PAdES-B-LTA)"
                  AutomationProperties.Name="Also add a document timestamp"
                  ToolTip="Timestamps the whole signed document, with its validation data when that is added, so the signature stays verifiable after its certificates expire."
                  Foreground="{DynamicResource TextPrimaryBrush}" />

        <!-- Long-term validation: off unless ticked, because it goes to the network -->
        <CheckBox x:Name="LtvCheck" Margin="0,12,0,4" IsChecked="False"
                  Content="Add long-term validation data (contacts the certificate authority)"
                  AutomationProperties.Name="Add long-term validation data"
                  Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Embeds your certificate's revocation status so the signature can be validated after the certificate expires. Only certificate identifiers are sent, never the document." />

        <!-- Where the signed file goes -->
        <TextBlock Text="Save the signed document to" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="OutputBox" Style="{StaticResource FieldBox}" IsReadOnly="True" AutomationProperties.Name="Signed document location" />
            <Button Grid.Column="1" Content="Change..." Margin="8,0,0,0" Style="{StaticResource SecondaryButton}" Click="ChangeOutput_Click" />
        </Grid>

        <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#D93025" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="SignButton" Content="Sign" Width="100" Height="32" IsDefault="True"
                    Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" FontWeight="SemiBold"
                    Click="SignButton_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" Width="80" Height="32" IsCancel="True" Style="{StaticResource SecondaryButton}" />
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</Window>
