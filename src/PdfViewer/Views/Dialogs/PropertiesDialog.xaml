<Window x:Class="PdfViewer.Views.Dialogs.PropertiesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Document Properties"
        Icon="pack://application:,,,/assets/app_icon.png"
        Width="520"
        Height="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/LightTheme.xaml" />
                <ResourceDictionary Source="../../Themes/VectorIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="LabelStyle" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                <Setter Property="Margin" Value="0,4,12,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="ValueStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                <Setter Property="Margin" Value="0,4,0,4" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="PDF Document Properties"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Section 1: File Info -->
                <TextBlock Text="File Information" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="File Name:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding FileName, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="File Path:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding FilePath, Mode=OneWay}" Style="{StaticResource ValueStyle}" TextWrapping="Wrap" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="File Size:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding FileSizeFormatted, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Page Count:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding PageCount, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Page Dimensions:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding PageDimensionsFormatted, Mode=OneWay}" Style="{StaticResource ValueStyle}" />
                </Grid>

                <!-- Section 2: Metadata -->
                <TextBlock Text="Description &amp; Metadata" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Title:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Title, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Author:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Author, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Subject:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Subject, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Keywords:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Keywords, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Creator:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Creator, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Producer:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Producer, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Created:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding CreationDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}" Style="{StaticResource ValueStyle}" />
                </Grid>

                <!-- Section 3: Technical & Licensing -->
                <TextBlock Text="Technical &amp; Aspose Engine" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,8" />
                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,0,0,10" />

                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PDF Version:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PdfFormatVersion, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Encrypted:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IsEncrypted, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Fast Web View:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding IsLinearized, Mode=OneWay}" Style="{StaticResource ValueStyle}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Aspose License:" Style="{StaticResource LabelStyle}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding LicenseStatus, Mode=OneWay}" FontWeight="SemiBold" Style="{StaticResource ValueStyle}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Close"
                Width="90"
                Height="32"
                HorizontalAlignment="Right"
                IsDefault="True"
                IsCancel="True"
                Background="{DynamicResource AccentBrush}"
                Foreground="White"
                BorderThickness="0"
                Click="CloseButton_Click" />
    </Grid>
</Window>
