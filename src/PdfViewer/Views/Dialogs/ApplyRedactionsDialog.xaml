<Window x:Class="PdfViewer.Views.Dialogs.ApplyRedactionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apply Redactions"
        Width="500"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="Apply Redactions" FontSize="16" FontWeight="Bold" Margin="0,0,0,6" />
        <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />

        <CheckBox x:Name="OverlayCheck" Content="Label each box" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"
                  Checked="OverlayCheck_Changed" Unchecked="OverlayCheck_Changed" />
        <ComboBox x:Name="OverlayBox" IsEditable="True" Height="28" IsEnabled="False" AutomationProperties.Name="Label text" Margin="0,0,0,12">
            <ComboBoxItem Content="Redacted" />
            <ComboBoxItem Content="(b)(6)" />
            <ComboBoxItem Content="Confidential" />
        </ComboBox>

        <CheckBox x:Name="MetadataCheck" Content="Also remove the document's metadata (title, author, keywords)" IsChecked="True"
                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

        <TextBlock Text="Save the redacted copy to" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="OutputBox" Height="28" Padding="6,4" IsReadOnly="True" AutomationProperties.Name="Redacted copy location"
                     Background="{DynamicResource SurfaceAltBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />
            <Button Grid.Column="1" Content="Change..." Height="28" Padding="10,0" Margin="8,0,0,0" Click="ChangeOutput_Click"
                    Background="{DynamicResource SurfaceAltBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />
        </Grid>

        <Border Background="#FCE8E6" BorderBrush="#D93025" BorderThickness="1" Padding="10,8" Margin="0,16,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#202124"
                       Text="Redaction permanently removes the text, images and drawings under the marks from the new copy. It cannot be undone in that copy; your original document is not changed." />
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Redact" Width="100" Height="32" IsDefault="True" Background="#D93025" Foreground="White" BorderThickness="0"
                    FontWeight="SemiBold" Click="Apply_Click" Margin="0,0,8,0" />
            <Button Content="Cancel" Width="80" Height="32" IsCancel="True"
                    Background="{DynamicResource SurfaceAltBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />
        </StackPanel>
    </StackPanel>
</Window>
