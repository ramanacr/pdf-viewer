<Window x:Class="PdfViewer.Views.Dialogs.WatermarkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:PdfViewer.Views.Dialogs"
        Title="{Binding Title}"
        Width="960" Height="680" MinWidth="800" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="20" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Watermark" FontSize="16" FontWeight="Bold" />
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,12"
                           Text="Text, a picture or a page of a PDF across the pages, over the content or behind it." />

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Source" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="120" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" AutomationProperties.Name="Source" />
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsTextSource, Converter={StaticResource BoolToVis}}">
                    <TextBox Height="56" AcceptsReturn="True" TextWrapping="Wrap" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Watermark text" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ComboBox Width="200" ItemsSource="{Binding FontFamilies}" Text="{Binding FontFamily}" IsEditable="True" AutomationProperties.Name="Font" />
                        <TextBlock Text="Size" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Width="48" Text="{Binding FontSize, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Font size" />
                        <TextBlock Text="Colour" VerticalAlignment="Center" Margin="12,0,6,0" />
                        <TextBox Width="80" Text="{Binding TextColor, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Text colour" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Visibility="{Binding IsFileSource, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="_Browse..." Padding="10,3" Margin="8,0,0,0" Click="Browse_Click" />
                        <TextBox Text="{Binding SourcePath, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="File" />
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0" Visibility="{Binding IsPageSource, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Page" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="48" Text="{Binding SourcePage, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Page of the PDF" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="Appearance" FontWeight="SemiBold" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Rotation" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="48" Text="{Binding Rotation, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Rotation in degrees"
                             ToolTip="Degrees, counter-clockwise." />
                    <TextBlock Text="Opacity %" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <Slider Width="120" Minimum="0" Maximum="100" Value="{Binding OpacityPercent}" VerticalAlignment="Center" AutomationProperties.Name="Opacity" />
                    <TextBlock Text="{Binding OpacityPercent, StringFormat={}{0:0}}" VerticalAlignment="Center" Margin="6,0,0,0" Width="28" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <RadioButton Content="On top of the page" IsChecked="{Binding OnTop}" Margin="0,0,12,0" />
                    <RadioButton Content="Behind the page" IsChecked="{Binding Behind}" />
                </StackPanel>

                <TextBlock Text="Position" FontWeight="SemiBold" Margin="0,14,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Across" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding HorizontalAlignments}" SelectedItem="{Binding Horizontal}" AutomationProperties.Name="Horizontal alignment" Margin="0,2" />
                    <TextBlock Grid.Column="2" Text="offset (pt)" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <TextBox Grid.Column="3" Text="{Binding OffsetX, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horizontal offset" Margin="0,2" />
                    <TextBlock Grid.Row="1" Text="Down" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding VerticalAlignments}" SelectedItem="{Binding Vertical}" AutomationProperties.Name="Vertical alignment" Margin="0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="offset (pt)" VerticalAlignment="Center" Margin="10,0,6,0" />
                    <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding OffsetY, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Vertical offset" Margin="0,2" />
                </Grid>

                <TextBlock Text="Size" FontWeight="SemiBold" Margin="0,14,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Scale %" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="48" Text="{Binding ScalePercent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Scale" />
                    <CheckBox Content="Relative to the page:" IsChecked="{Binding UseRelativeScale}" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="48" Text="{Binding RelativeScalePercent, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseRelativeScale}"
                             AutomationProperties.Name="Size relative to the page, percent" />
                    <TextBlock Text="%" VerticalAlignment="Center" Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <d:PageMarkCommonPanel Grid.Column="2" />
    </Grid>
</Window>
