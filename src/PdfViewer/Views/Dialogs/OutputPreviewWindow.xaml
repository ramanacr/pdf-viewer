<Window x:Class="PdfViewer.Views.Dialogs.OutputPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Output Preview"
        Width="1100" Height="780"
        MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" x:Name="SummaryText" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"
                   AutomationProperties.Name="{Binding Summary}" AutomationProperties.LiveSetting="Polite" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel Margin="0,0,12,0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="&lt;" Width="28" Click="PreviousPage_Click" ToolTip="Previous page" AutomationProperties.Name="Previous page" />
                        <Label Content="_Page" Target="{Binding ElementName=PageBox}" Padding="8,0,4,0" VerticalAlignment="Center" />
                        <TextBox x:Name="PageBox" Width="48" Text="{Binding PageNumber, UpdateSourceTrigger=LostFocus}" KeyDown="PageBox_KeyDown"
                                 AutomationProperties.Name="Page number" />
                        <TextBlock Text="{Binding PageCount, StringFormat=' of {0}'}" VerticalAlignment="Center" Margin="4,0,8,0" />
                        <Button Content="&gt;" Width="28" Click="NextPage_Click" ToolTip="Next page" AutomationProperties.Name="Next page" />
                    </StackPanel>
                    <CheckBox Content="Simulate _overprinting" IsChecked="{Binding SimulateOverprint}" Margin="0,0,0,6"
                              ToolTip="Honours /OP, /op and /OPM: an overprinting object leaves the plates it does not use as they are." />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <CheckBox x:Name="InkCheck" Content="_Total ink over" IsChecked="{Binding ShowInkWarning}" VerticalAlignment="Center"
                                  ToolTip="Highlights the areas whose total ink (process and spot plates shown) is over the limit." />
                        <TextBox Width="48" Margin="6,0,4,0" Text="{Binding InkLimit, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Total ink limit, percent" />
                        <TextBlock Text="%" VerticalAlignment="Center" />
                    </StackPanel>
                    <Label Content="_Plates" Target="{Binding ElementName=PlateList}" Padding="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="Under the mouse" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,2" />
                    <TextBlock Text="{Binding Readout}" TextWrapping="Wrap" AutomationProperties.Name="{Binding Readout}" />
                    <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                               Text="Plates come from the vector engine. DeviceCMYK goes on the process plates as it is, gray on black only, RGB through the engine's SWOP model (approximate); spot colours are mixed for display only." />
                </StackPanel>
                <ListBox x:Name="PlateList" ItemsSource="{Binding Colorants}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent"
                         AutomationProperties.Name="Plates" KeyboardNavigation.TabNavigation="Continue">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsVisible}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name, StringFormat='Show the {0} plate'}" />
                                <Border Grid.Column="1" Width="14" Height="14" Margin="6,0" Background="{Binding Swatch}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Kind}" />
                                <TextBlock Grid.Column="3" Text="{Binding Readout}" Margin="8,0,0,0" MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="#FF808080">
                <Grid>
                    <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                        <Image x:Name="PreviewImage" Source="{Binding Preview}" Stretch="None" MouseMove="Preview_MouseMove" MouseLeave="Preview_MouseLeave"
                               RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Separated page preview" />
                    </Viewbox>
                    <TextBlock Text="Separating..." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
