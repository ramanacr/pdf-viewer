<Window x:Class="PdfViewer.Views.Dialogs.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Software Update"
        Icon="pack://application:,,,/assets/app_icon.png"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/LightTheme.xaml" />
                <ResourceDictionary Source="../../Themes/VectorIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="52"
                    Height="52"
                    CornerRadius="8"
                    Margin="0,0,16,0">
                <Image Source="pack://application:,,,/assets/app_icon.png"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="PDF Viewer Updates"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="HeaderSubtext"
                           Text="GitHub Releases Channel"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,1"
                Padding="0,16"
                Margin="0,0,0,16">
            <Grid>
                <!-- State 1: Checking -->
                <StackPanel x:Name="CheckingPanel" Visibility="Visible" HorizontalAlignment="Center" Margin="0,12">
                    <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,0,0,12" />
                    <TextBlock Text="Checking GitHub for the latest releases..."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <!-- State 2: Up to Date -->
                <StackPanel x:Name="UpToDatePanel" Visibility="Collapsed" Margin="0,8">
                    <Border Background="#100D8A3A"
                            BorderBrush="#0D8A3A"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✓" FontSize="20" FontWeight="Bold" Foreground="#0D8A3A" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock Text="You are running the latest version!" FontWeight="Bold" FontSize="14" Foreground="#0D8A3A" />
                                <TextBlock x:Name="CurrentVersionInfoText"
                                           Text="PDF Viewer v1.0.0 is currently the newest release available."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="Your application is completely up to date. New updates published to the GitHub repository will appear here automatically."
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <!-- State 3: Update Available -->
                <StackPanel x:Name="UpdateAvailablePanel" Visibility="Collapsed">
                    <!-- Version Comparison Banner -->
                    <Border Background="{DynamicResource AccentLightBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="🚀 A new version is available!" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource AccentBrush}" />
                                <TextBlock x:Name="ReleaseTitleText" Text="v1.1.0 - Feature Update" FontWeight="SemiBold" FontSize="12" Margin="0,2,0,0" />
                                <TextBlock x:Name="PublishedDateText" Text="Released on August 26, 2026" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource SurfaceBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,4"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="OldVersionBadge" Text="v1.0.0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" → " FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NewVersionBadge" Text="v1.1.0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Release Notes -->
                    <TextBlock Text="Release Notes &amp; Changelog:" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6" />
                    <Border Background="{DynamicResource HeaderBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Height="140"
                            Padding="8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="ReleaseNotesBox"
                                     Text="Release notes..."
                                     IsReadOnly="True"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     TextWrapping="Wrap"
                                     FontSize="11" />
                        </ScrollViewer>
                    </Border>

                    <TextBlock x:Name="DownloadSizeText"
                               Text="Download size: ~42.5 MB"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <!-- State 4: Downloading -->
                <StackPanel x:Name="DownloadingPanel" Visibility="Collapsed" Margin="0,8">
                    <TextBlock Text="Downloading update package..."
                               FontWeight="Bold"
                               FontSize="14"
                               Margin="0,0,0,8" />
                    <ProgressBar x:Name="DownloadProgressBar"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Margin="0,0,0,8" />
                    <Grid>
                        <TextBlock x:Name="DownloadBytesText"
                                   Text="0 MB / 42.5 MB"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Left" />
                        <TextBlock x:Name="DownloadPercentText"
                                   Text="0%"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <TextBlock Text="The application will automatically close, install the update, and relaunch with the latest version."
                               TextWrapping="Wrap"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,12,0,0" />
                </StackPanel>

                <!-- State 5: Error -->
                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,8">
                    <Border Background="#10D83B01"
                            BorderBrush="#D83B01"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="Unable to check for updates" FontWeight="Bold" FontSize="14" Foreground="#D83B01" />
                            <TextBlock x:Name="ErrorMessageText"
                                       Text="Please verify your internet connection or check the GitHub repository."
                                       TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="ViewOnGitHubButton"
                        Content="View on GitHub"
                        Height="32"
                        Padding="12,0"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Foreground="{DynamicResource AccentBrush}"
                        Click="ViewOnGitHubButton_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelActionButton"
                        Content="Close"
                        Width="85"
                        Height="32"
                        Margin="0,0,8,0"
                        IsCancel="True"
                        Click="CancelActionButton_Click" />

                <Button x:Name="PrimaryActionButton"
                        Content="Update Now"
                        Width="120"
                        Height="32"
                        IsDefault="True"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Click="PrimaryActionButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
