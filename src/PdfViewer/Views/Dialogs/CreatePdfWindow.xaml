<Window x:Class="PdfViewer.Views.Dialogs.CreatePdfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:PdfViewer.Views.Dialogs"
        Title="Create PDF"
        Icon="pack://application:,,,/PdfViewer;component/assets/app_icon.png"
        Width="760" Height="560" MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Intro}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar Height="6" Minimum="0" Maximum="100" Value="{Binding Progress}" IsIndeterminate="{Binding IsProgressIndeterminate}"
                         AutomationProperties.Name="Progress">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
            <DockPanel Margin="0,8,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="_Create PDF..." Padding="14,3" Margin="8,0,0,0" IsDefault="True" Click="Create_Click" IsEnabled="{Binding CanCreate}" />
                    <Button x:Name="CancelButton" Content="Cancel" Padding="14,3" Margin="8,0,0,0" Click="Cancel_Click" />
                </StackPanel>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="230" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding SummaryText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                <ListBox x:Name="FileList" ItemsSource="{Binding Items}" AllowDrop="True" SelectionMode="Single"
                         AutomationProperties.Name="Files, in order"
                         BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Background="Transparent"
                         PreviewMouseLeftButtonDown="FileList_PreviewMouseLeftButtonDown" PreviewMouseMove="FileList_PreviewMouseMove"
                         DragOver="FileList_DragOver" Drop="FileList_Drop" KeyDown="FileList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="{Binding Kind, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Folder, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <StackPanel Grid.Column="1" Margin="8,0,12,0" Width="96">
                <Button Content="_Add Files..." Padding="8,3" Click="Add_Click" />
                <Button Content="Move _Up" Padding="8,3" Margin="0,6,0,0" Click="Up_Click" />
                <Button Content="Move _Down" Padding="8,3" Margin="0,6,0,0" Click="Down_Click" />
                <Button Content="_Remove" Padding="8,3" Margin="0,6,0,0" Click="Remove_Click" />
            </StackPanel>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <dialogs:CreatePdfOptionsPanel DataContext="{Binding Options}" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
