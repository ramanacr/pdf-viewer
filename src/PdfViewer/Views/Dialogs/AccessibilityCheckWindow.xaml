<Window x:Class="PdfViewer.Views.Dialogs.AccessibilityCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PdfViewer.ViewModels"
        Title="Accessibility Check"
        Width="900" Height="640"
        MinWidth="560" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding FileName}" FontSize="16" FontWeight="Bold" />
            <TextBlock Text="{Binding ClaimText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,10" />
            <TextBlock x:Name="SummaryText" Text="{Binding Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10"
                       AutomationProperties.Name="{Binding Summary}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Check _Again" Padding="14,3" Click="Check_Click" IsEnabled="{Binding CanCheck}"
                    ToolTip="Checks the document again, for example after fixing it in another application." />
            <Button Content="Close" Padding="14,3" Margin="8,0,0,0" IsCancel="True" Click="Close_Click" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Label Content="_Issues by category" Target="{Binding ElementName=IssueTree}" Padding="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
            <TreeView x:Name="IssueTree" Grid.Row="1" ItemsSource="{Binding Groups}" BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}" Background="Transparent"
                      AutomationProperties.Name="Accessibility issues by category"
                      AutomationProperties.HelpText="Use the arrow keys to move between categories and issues. Selecting an issue on a page shows it in the document."
                      SelectedItemChanged="IssueTree_SelectedItemChanged" KeyDown="IssueTree_KeyDown">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <Setter Property="Padding" Value="2,3" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.Resources>
                    <HierarchicalDataTemplate DataType="{x:Type vm:AccessibilityIssueGroup}" ItemsSource="{Binding Issues}">
                        <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                    </HierarchicalDataTemplate>
                    <DataTemplate DataType="{x:Type vm:AccessibilityIssueItem}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SeverityText}" Width="92" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxWidth="380" />
                        </StackPanel>
                    </DataTemplate>
                </TreeView.Resources>
            </TreeView>
            <GridSplitter Grid.Column="1" Grid.RowSpan="2" Width="6" HorizontalAlignment="Center" Background="Transparent" Focusable="False" />
            <TextBlock Grid.Column="2" Text="Details" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
            <ScrollViewer Grid.Column="2" Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="Select an issue to see what is wrong and how to fix it." TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding HasNoSelection, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel DataContext="{Binding SelectedIssue}" Visibility="{Binding DataContext.HasSelection, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}">
                        <Label Content="_What is wrong" Target="{Binding ElementName=WhatBox}" Padding="0,0,0,2" FontWeight="SemiBold" />
                        <TextBox x:Name="WhatBox" Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="What is wrong" Margin="0,0,0,10" />
                        <Label Content="How to _fix it" Target="{Binding ElementName=FixBox}" Padding="0,0,0,2" FontWeight="SemiBold" />
                        <TextBox x:Name="FixBox" Text="{Binding Fix, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="How to fix it" Margin="0,0,0,10" />
                        <Label Content="Wh_ere" Target="{Binding ElementName=WhereBox}" Padding="0,0,0,2" FontWeight="SemiBold" />
                        <TextBox x:Name="WhereBox" Text="{Binding Location, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                 Foreground="{DynamicResource TextPrimaryBrush}" AutomationProperties.Name="Where" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding Reference}" TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" />
                        <Button Content="_Show on Page" HorizontalAlignment="Left" Padding="14,3" Click="Show_Click" IsEnabled="{Binding HasPage}"
                                ToolTip="Goes to the page and highlights the element, when its position is known." />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
