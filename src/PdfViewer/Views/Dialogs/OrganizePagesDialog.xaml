<Window x:Class="PdfViewer.Views.Dialogs.OrganizePagesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Organize Pages"
        Icon="pack://application:,,,/PdfViewer;component/assets/app_icon.png"
        Height="560" Width="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Organize Pages"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="SubtitleText"
                       Margin="0,4,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                <ListBox x:Name="PageList"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding PositionLabel}"
                                           MinWidth="42"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Description}"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Column="1" Margin="12,0,0,0" MinWidth="140">
                <Button Content="Move _Up" Padding="10,6" Margin="0,0,0,6" Click="MoveUp_Click" />
                <Button Content="Move _Down" Padding="10,6" Margin="0,0,0,14" Click="MoveDown_Click" />
                <Button Content="Rotate _Left" Padding="10,6" Margin="0,0,0,6" Click="RotateLeft_Click" />
                <Button Content="Rotate _Right" Padding="10,6" Margin="0,0,0,14" Click="RotateRight_Click" />
                <Button Content="_Remove" Padding="10,6" Margin="0,0,0,6" Click="Remove_Click" />
                <Button Content="Reset _All" Padding="10,6" Click="Reset_Click" />
                <TextBlock Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Text="Removing a page here leaves it out of the new document. Your original file is never modified." />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <TextBlock x:Name="SummaryText"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button x:Name="SaveButton"
                    Content="Save As..."
                    MinWidth="110" Padding="12,6"
                    IsDefault="True"
                    Click="SaveButton_Click" />
            <Button Content="Cancel"
                    MinWidth="90" Padding="12,6" Margin="8,0,0,0"
                    IsCancel="True"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Grid>
</Window>
