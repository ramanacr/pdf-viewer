<Window x:Class="PdfViewer.Views.Dialogs.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About PDF Viewer"
        Icon="pack://application:,,,/assets/app_icon.png"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ShowInTaskbar="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Themes/LightTheme.xaml" />
                <ResourceDictionary Source="../../Themes/VectorIcons.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header with Product Icon & Title -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="64"
                    Height="64"
                    CornerRadius="8"
                    Margin="0,0,16,0">
                <Image Source="pack://application:,,,/assets/app_icon.png"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="PDF Viewer Native"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Version "
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="VersionTextBlock"
                               Text="1.0.0"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock x:Name="CommitTextBlock"
                               Text=""
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="6,0,0,0" />
                </StackPanel>
                <TextBlock Text="Desktop Native PDF Application for Windows"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Margin="0,0,0,16" />

        <!-- Info Grid -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <!-- Engine Info Box -->
            <Border Background="{DynamicResource HeaderBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="12"
                    Margin="0,0,0,12">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="PDF Engine:"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Width="120" />
                        <TextBlock Text="Google PDFium (Native x64)"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Text="Engine Version:"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Width="120" />
                        <TextBlock Text="Chromium 8021 / 154.0"
                                   FontWeight="Bold"
                                   FontSize="12"
                                   Foreground="#0D8A3A" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Engine License:"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Width="120" />
                        <TextBlock Text="Open Source (Apache 2.0 / BSD 3-Clause)"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Technical Details -->
            <Grid Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Runtime Framework:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text=".NET 9.0 Windows (WPF x64)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Architecture &amp; Format:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="MVVM (.slnx Solution)" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Rendering Cache:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="Thread-Safe LRU Memory Cache" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2" />
            </Grid>
        </StackPanel>

        <!-- Footer Actions -->
        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="Check for Updates..."
                        Height="32"
                        Padding="12,0"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        Foreground="{DynamicResource AccentBrush}"
                        FontWeight="SemiBold"
                        Click="CheckForUpdates_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK"
                        Width="90"
                        Height="32"
                        IsDefault="True"
                        IsCancel="True"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Click="CloseButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
