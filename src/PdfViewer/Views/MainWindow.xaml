        <!-- 2. Main Ribbon Toolbar -->
        <Border x:Name="MainToolBar"
                Grid.Row="1"
                Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Open Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding OpenFileDialogCommand}"
                        ToolTip="Open PDF (Ctrl+O)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Open}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <!-- Copy Selected Text Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding CopySelectedTextCommand}"
                        IsEnabled="{Binding HasTextSelection}"
                        ToolTip="Copy Selected Text (Ctrl+C)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Copy}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <!-- Print Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding PrintCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Print Document (Ctrl+P)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Print}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <!-- Export Images Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ExportImagesCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Export Pages to Images">
                    <TextBlock Text="{x:Static themes:IconGlyphs.ExportImages}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Sidebar Toggle -->
                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding IsSidebarOpen}"
                              ToolTip="Toggle Navigation Sidebar (Ctrl+B)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Sidebar}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Page Navigation Controls -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding FirstPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="First Page (Home)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.FirstPage}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Previous Page (PageUp)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.PreviousPage}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <TextBox Width="42"
                             Height="26"
                             Text="{Binding CurrentPageNumber, UpdateSourceTrigger=LostFocus}"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding IsDocumentLoaded}"
                             KeyDown="PageInputBox_KeyDown" />
                    <TextBlock Text=" / " VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PageCount}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                </StackPanel>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Next Page (PageDown)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.NextPage}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding LastPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Last Page (End)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.LastPage}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Zoom Controls -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ZoomOutCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Zoom Out (Ctrl+-)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.ZoomOut}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <Slider Width="90"
                        Minimum="0.25"
                        Maximum="3.0"
                        Value="{Binding ZoomLevel}"
                        SmallChange="0.1"
                        LargeChange="0.25"
                        VerticalAlignment="Center"
                        Margin="4,0"
                        IsEnabled="{Binding IsDocumentLoaded}" />

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ZoomInCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Zoom In (Ctrl++)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.ZoomIn}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <TextBlock Text="{Binding ZoomPercentageText}"
                           Width="46"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="2,0,6,0" />

                <!-- Fit Width / Fit Page -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding FitWidthCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Fit to Width (Ctrl+1)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.FitWidth}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding FitPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Fit to Page (Ctrl+0)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.FitPage}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Rotation -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding RotateCounterClockwiseCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Rotate Counter-Clockwise (Ctrl+Shift+R)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Rotate}" Style="{StaticResource MirroredToolbarGlyph}" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding RotateClockwiseCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Rotate Clockwise (Ctrl+R)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Rotate}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- View Layout Mode & Pan Tool -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ToggleViewModeCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Toggle View Mode (Continuous / Single Page)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Continuous}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding IsPanningEnabled}"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Hand / Pan Tool">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Pan}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Annotation Tools -->
                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Highlight, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Highlight"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Highlight Tool">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Highlight}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Underline, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Underline"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Underline Tool">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Underline}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Note, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Note"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Sticky Note / Comment Tool">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Note}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=FreeText, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="FreeText"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="FreeText Box Tool">
                    <TextBlock Text="{x:Static themes:IconGlyphs.TextBox}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Ink, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Ink"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Freehand Ink / Pen Tool">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Ink}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Rectangle, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Rectangle"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Rectangle Shape Tool">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Shape}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Line, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Line"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Line Tool (drag)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Line}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Arrow, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Arrow"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Arrow Tool (drag)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Arrow}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Polygon, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Polygon"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Polygon Tool (click each point, double-click or Enter to finish)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Polygon}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=PolyLine, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="PolyLine"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Connected Lines Tool (click each point, double-click or Enter to finish)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.PolyLine}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <!-- Annotation Color Selector ComboBox with Color Swatches -->
                <ComboBox Width="54"
                          Height="28"
                          Margin="4,2"
                          ItemsSource="{Binding AnnotationColors}"
                          SelectedItem="{Binding SelectedAnnotationColor}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Select Annotation Color">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Converter={StaticResource HexToBrushConverter}}" BorderBrush="#888888" BorderThickness="1" Margin="1,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Annotation Thickness Selector -->
                <ComboBox Width="60"
                          Height="28"
                          Margin="2,2"
                          SelectedValue="{Binding SelectedAnnotationThickness}"
                          SelectedValuePath="Tag"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Annotation Stroke Thickness">
                    <ComboBoxItem Tag="1.0" Content="1 pt" />
                    <ComboBoxItem Tag="2.0" Content="2 pt" IsSelected="True" />
                    <ComboBoxItem Tag="3.0" Content="3 pt" />
                    <ComboBoxItem Tag="4.0" Content="4 pt" />
                    <ComboBoxItem Tag="6.0" Content="6 pt" />
                </ComboBox>

                <!-- Save Annotated As Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding SaveAnnotatedAsCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Save Annotated PDF As... (Ctrl+Shift+S)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.SaveAs}" Style="{StaticResource ToolbarGlyph}" Foreground="{DynamicResource IconAccentBrush}" />
                </Button>

                <!-- Undo and Redo, as in the Edit menu: one history for comments, content edits and page marks.
                     The tooltip names the step; it shows on a disabled button too, so "Undo" says why nothing happens. -->
                <Button x:Name="ToolbarUndoButton"
                        Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding UndoCommand}"
                        ToolTip="{Binding UndoToolTip}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="{Binding UndoName}">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Undo}" Style="{StaticResource ToolbarGlyph}" />
                </Button>
                <Button x:Name="ToolbarRedoButton"
                        Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding RedoCommand}"
                        ToolTip="{Binding RedoToolTip}"
                        ToolTipService.ShowOnDisabled="True"
                        AutomationProperties.Name="{Binding RedoName}">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Redo}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Search Toggle -->
                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding IsSearchOpen}"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Find Text (Ctrl+F)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Find}" Style="{StaticResource ToolbarGlyph}" />
                </ToggleButton>

                <!-- Theme Toggle -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="Toggle Light / Dark Mode">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Theme}" Style="{StaticResource ToolbarGlyph}" />
                </Button>

                <!-- Document Properties -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ShowPropertiesCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Document Properties (Ctrl+D)">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Properties}" Style="{StaticResource ToolbarGlyph}" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- 3. Collapsible In-Document Search Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />

                <TextBox Grid.Column="1"
                         x:Name="SearchInputBox"
                         Height="28"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchInputBox_KeyDown" />

                <Button Grid.Column="2"
                        Content="Search"
                        Height="28"
                        Padding="12,0"
                        Margin="6,0,4,0"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="{DynamicResource OnAccentTextBrush}"
                        BorderThickness="0"
                        Command="{Binding ExecuteSearchCommand}" />

                <CheckBox Grid.Column="3"
                          Content="Match Case"
                          IsChecked="{Binding SearchMatchCase}"
                          VerticalAlignment="Center"
                          Margin="8,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding PreviousSearchMatchCommand}"
                            ToolTip="Previous Match (Shift+F3)">
                        <TextBlock Text="{x:Static themes:IconGlyphs.PreviousMatch}" Style="{StaticResource SmallGlyph}" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding NextSearchMatchCommand}"
                            ToolTip="Next Match (F3)">
                        <TextBlock Text="{x:Static themes:IconGlyphs.NextMatch}" Style="{StaticResource SmallGlyph}" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="5"
                           Text="{Binding SearchSummaryText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="12,0" />

                <Button Grid.Column="6"
                        Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ToggleSearchCommand}"
                        ToolTip="Close Search">
                    <TextBlock Text="{x:Static themes:IconGlyphs.Close}" Style="{StaticResource SmallGlyph}" Foreground="{DynamicResource TextSecondaryBrush}" />
                </Button>
            </Grid>
        </Border>

        <!-- 4. Main Viewport & Collapsible Sidebar -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <!-- Sidebar Column -->
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="280"
                                  MinWidth="180"
                                  MaxWidth="450" />
                <!-- Splitter Column -->
                <ColumnDefinition x:Name="SidebarSplitterColumn"
                                  Width="Auto" />
                <!-- Viewport Column -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}">
                <TabControl SelectedIndex="{Binding SelectedSidebarTab}"
                            Background="Transparent"
                            BorderThickness="0">
                    <!-- Tab 1: Thumbnails -->
                    <TabItem Header="Pages" AutomationProperties.Name="Pages" themes:IconGlyphs.Glyph="{x:Static themes:IconGlyphs.Pages}" Style="{StaticResource SidebarTabItemStyle}">
                        <ScrollViewer x:Name="ThumbnailsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <ItemsControl ItemsSource="{Binding Thumbnails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThumbnailViewModel}">
                                        <Border Margin="0,0,0,12"
                                                Background="{DynamicResource SurfaceBgBrush}"
                                                BorderThickness="2"
                                                CornerRadius="4"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="Thumbnail_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Border.ToolTip>
                                                <ToolTip Background="{DynamicResource SurfaceBgBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                         BorderThickness="1"
                                                         Padding="8"
                                                         Placement="Right">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0} Preview'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   Margin="0,0,0,6"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                MaxWidth="320"
                                                                MaxHeight="450"
                                                                Background="White">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#000000" />
                                                            </Border.Effect>
                                                            <Image Source="{Binding ThumbnailImage}"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>

                                            <StackPanel Margin="6">
                                                <Border Height="160"
                                                        Background="{DynamicResource BorderBrush}"
                                                        CornerRadius="2"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailImage}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Bookmarks / Outline Tree -->
                    <TabItem Header="Bookmarks" AutomationProperties.Name="Bookmarks" themes:IconGlyphs.Glyph="{x:Static themes:IconGlyphs.Bookmarks}" Style="{StaticResource SidebarTabItemStyle}">
                        <Grid>
                            <TextBlock Text="No bookmarks found in this document."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="16"
                                       Visibility="{Binding Bookmarks.Count, Converter={StaticResource InverseBoolToVis}}" />

                            <TreeView ItemsSource="{Binding Bookmarks}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6"
                                      SelectedItemChanged="BookmarkTree_SelectedItemChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}" DataType="{x:Type models:BookmarkItem}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TargetPageNumber, StringFormat=' (p. {0})'}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Search Results -->
                    <TabItem Header="Search Results" AutomationProperties.Name="Search Results" themes:IconGlyphs.Glyph="{x:Static themes:IconGlyphs.SearchResults}" Style="{StaticResource SidebarTabItemStyle}">
                        <Grid>
                            <TextBlock Text="Search results will appear here."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SearchMatches.Count, Converter={StaticResource InverseBoolToVis}}" />

                            <ListBox x:Name="SearchResultsListBox"
                                     ItemsSource="{Binding SearchMatches}"
                                     SelectedItem="{Binding SelectedSearchMatch, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4"
                                     SelectionChanged="SearchResultsListBox_SelectionChanged"
                                     MouseDoubleClick="SearchMatch_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SearchResultItem_PreviewMouseLeftButtonUp" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SearchMatch}">
                                        <Border Padding="8,6"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding ContextSnippet}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- Tab 4: Annotations -->
                    <TabItem Header="Annotations" AutomationProperties.Name="Annotations" themes:IconGlyphs.Glyph="{x:Static themes:IconGlyphs.Annotations}" Style="{StaticResource SidebarTabItemStyle}">
                        <Grid>
                            <TextBlock Text="No annotations added yet."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding AllAnnotations.Count, Converter={StaticResource InverseBoolToVis}}" />

                            <!-- Comment threads (12.5.6.4): each comment with its status and replies, as Acrobat's comment pane lists them. -->
                            <ScrollViewer x:Name="CommentsPanel"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <ScrollViewer.Resources>
                                    <!-- Small text buttons for a comment's actions: themed, with a visible keyboard focus. -->
                                    <Style x:Key="CommentActionButton" TargetType="ButtonBase">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Padding" Value="5,1" />
                                        <Setter Property="Margin" Value="0,0,4,0" />
                                        <Setter Property="FontSize" Value="11" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ButtonBase">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter Property="Opacity" Value="0.4" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="CommentCardButton" TargetType="Button">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="BorderBrush" Value="Transparent" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Padding" Value="2" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Stretch" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                        </Trigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                    <Style x:Key="CommentStatusBadge" TargetType="Border">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="8" />
                                        <Setter Property="Padding" Value="6,0" />
                                        <Setter Property="Margin" Value="6,0,0,0" />
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </ScrollViewer.Resources>
                                <ItemsControl ItemsSource="{Binding CommentThreads}"
                                              Padding="4"
                                              KeyboardNavigation.TabNavigation="Continue"
                                              AutomationProperties.Name="Comments">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:CommentThreadViewModel}">
                                            <Border Padding="6,6"
                                                    BorderThickness="0,0,0,1"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    AutomationProperties.Name="{Binding AccessibleName}">
                                                <StackPanel>
                                                    <!-- The comment: Enter or a click goes to it on the page, a double-click edits it. -->
                                                    <Button Style="{StaticResource CommentCardButton}"
                                                            Tag="{Binding Root}"
                                                            Click="CommentThread_Click"
                                                            MouseDoubleClick="CommentThread_MouseDoubleClick"
                                                            AutomationProperties.Name="{Binding AccessibleName}"
                                                            ToolTip="Go to the comment on the page (double-click to edit it)">
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Root.PageNumber, StringFormat='Page {0}'}"
                                                                           FontWeight="Bold"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource AccentBrush}" />
                                                                <TextBlock Text=" • " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                                                <TextBlock Text="{Binding Root.Type}"
                                                                           FontWeight="SemiBold"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Root.ColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                                <Border Style="{StaticResource CommentStatusBadge}"
                                                                        ToolTip="{Binding ReviewHistory}"
                                                                        Visibility="{Binding ReviewState, Converter={StaticResource BoolToVis}}">
                                                                    <TextBlock Text="{Binding ReviewState}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Root.Author, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="  " />
                                                                <Run Text="{Binding Root.CreationDate, Mode=OneWay, StringFormat='{}{0:g}'}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Root.Contents, FallbackValue='(No comment text)'}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Margin="0,2,0,0" />
                                                        </StackPanel>
                                                    </Button>

                                                    <!-- The comment's actions. -->
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <Button x:Name="ReplyButton" Style="{StaticResource CommentActionButton}" Content="Reply"
                                                                Command="{Binding StartReplyCommand}" ToolTip="Reply to this comment" />
                                                        <Button Style="{StaticResource CommentActionButton}" Content="Status ▾"
                                                                Click="CommentStatusButton_Click"
                                                                AutomationProperties.Name="Set status"
                                                                ToolTip="Set the review status (Accepted, Rejected, Cancelled, Completed, None)">
                                                            <Button.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="_Accepted" Command="{Binding SetStatusCommand}" CommandParameter="Accepted"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Check}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                                                                    <MenuItem Header="_Rejected" Command="{Binding SetStatusCommand}" CommandParameter="Rejected"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Close}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                                                                    <MenuItem Header="_Cancelled" Command="{Binding SetStatusCommand}" CommandParameter="Cancelled"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Deselect}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                                                                    <MenuItem Header="C_ompleted" Command="{Binding SetStatusCommand}" CommandParameter="Completed"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Check}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                                                                    <Separator />
                                                                    <MenuItem Header="_None" Command="{Binding SetStatusCommand}" CommandParameter="None"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.ClearMarks}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                                                                </ContextMenu>
                                                            </Button.ContextMenu>
                                                        </Button>
                                                        <Button Style="{StaticResource CommentActionButton}" Content="Edit"
                                                                Click="EditAnnotationButton_Click" Tag="{Binding Root}" ToolTip="Edit the comment" />
                                                        <Button Style="{StaticResource CommentActionButton}" Content="Delete"
                                                                Command="{Binding DeleteCommand}" ToolTip="Delete the comment and its replies" />
                                                        <ToggleButton Style="{StaticResource CommentActionButton}"
                                                                      Content="{Binding ToggleText}"
                                                                      IsChecked="{Binding IsExpanded}"
                                                                      AutomationProperties.Name="{Binding ReplyCountText}"
                                                                      AutomationProperties.HelpText="Shows or hides the replies"
                                                                      Visibility="{Binding HasReplies, Converter={StaticResource BoolToVis}}" />
                                                    </WrapPanel>

                                                    <!-- The replies, each under the one it answers. -->
                                                    <ItemsControl ItemsSource="{Binding Replies}"
                                                                  Margin="8,4,0,0"
                                                                  KeyboardNavigation.TabNavigation="Continue"
                                                                  AutomationProperties.Name="{Binding ReplyCountText}"
                                                                  Visibility="{Binding ShowsReplies, Converter={StaticResource BoolToVis}}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="{x:Type vm:CommentReplyViewModel}">
                                                                <Border Margin="{Binding Indent}" Padding="8,3,0,3"
                                                                        BorderThickness="2,0,0,0" BorderBrush="{DynamicResource BorderBrush}"
                                                                        AutomationProperties.Name="{Binding AccessibleName}">
                                                                    <StackPanel>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis">
                                                                                <Run Text="{Binding Model.Author, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                                <Run Text="  " />
                                                                                <Run Text="{Binding Model.CreationDate, Mode=OneWay, StringFormat='{}{0:g}'}" />
                                                                            </TextBlock>
                                                                            <Border Style="{StaticResource CommentStatusBadge}"
                                                                                    Visibility="{Binding ReviewState, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="{Binding ReviewState}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <TextBlock Text="{Binding Model.Contents}" TextWrapping="Wrap" FontSize="11" Margin="0,1,0,0"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                   Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                                                                        <!-- Editing the user's own reply: Enter or Ctrl+Enter keeps it, Shift+Enter starts a new line, Esc leaves it. -->
                                                                        <TextBox Text="{Binding EditText, UpdateSourceTrigger=PropertyChanged}"
                                                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="160"
                                                                                 VerticalScrollBarVisibility="Auto" Margin="0,2,0,0" FontSize="11"
                                                                                 AutomationProperties.Name="Edit your reply"
                                                                                 AutomationProperties.HelpText="Enter saves, Shift+Enter starts a new line, Esc cancels"
                                                                                 Tag="{Binding ElementName=ReplyEditButton}"
                                                                                 IsVisibleChanged="CommentTextBox_IsVisibleChanged"
                                                                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                                                                            <TextBox.InputBindings>
                                                                                <KeyBinding Key="Enter" Command="{Binding SaveEditCommand}" />
                                                                                <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding SaveEditCommand}" />
                                                                                <KeyBinding Key="Escape" Command="{Binding CancelEditCommand}" />
                                                                            </TextBox.InputBindings>
                                                                        </TextBox>
                                                                        <WrapPanel Margin="0,2,0,0" Visibility="{Binding IsOwn, Converter={StaticResource BoolToVis}}">
                                                                            <Button x:Name="ReplyEditButton" Style="{StaticResource CommentActionButton}" Content="Edit"
                                                                                    Command="{Binding StartEditCommand}" ToolTip="Edit your reply"
                                                                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                                                                            <Button Style="{StaticResource CommentActionButton}" Content="Delete"
                                                                                    Command="{Binding DeleteCommand}" ToolTip="Delete your reply"
                                                                                    Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}" />
                                                                            <Button Style="{StaticResource CommentActionButton}" Content="Save"
                                                                                    Command="{Binding SaveEditCommand}" ToolTip="Keep the new text (Enter)"
                                                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                                                            <Button Style="{StaticResource CommentActionButton}" Content="Cancel"
                                                                                    Command="{Binding CancelEditCommand}" ToolTip="Leave the reply as it was (Esc)"
                                                                                    Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" />
                                                                        </WrapPanel>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <!-- The reply box: Enter or Ctrl+Enter posts, Shift+Enter starts a new line, Esc closes it. -->
                                                    <StackPanel Margin="8,4,0,0" Visibility="{Binding IsReplying, Converter={StaticResource BoolToVis}}">
                                                        <TextBox Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}"
                                                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxHeight="160"
                                                                 VerticalScrollBarVisibility="Auto" FontSize="11"
                                                                 AutomationProperties.Name="{Binding ReplyBoxName}"
                                                                 AutomationProperties.HelpText="Enter posts the reply, Shift+Enter starts a new line, Esc cancels"
                                                                 Tag="{Binding ElementName=ReplyButton}"
                                                                 IsVisibleChanged="CommentTextBox_IsVisibleChanged">
                                                            <TextBox.InputBindings>
                                                                <KeyBinding Key="Enter" Command="{Binding PostReplyCommand}" />
                                                                <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding PostReplyCommand}" />
                                                                <KeyBinding Key="Escape" Command="{Binding CancelReplyCommand}" />
                                                            </TextBox.InputBindings>
                                                        </TextBox>
                                                        <WrapPanel Margin="0,3,0,0">
                                                            <Button Style="{StaticResource CommentActionButton}" Content="Post"
                                                                    Command="{Binding PostReplyCommand}" ToolTip="Post the reply (Enter)" />
                                                            <Button Style="{StaticResource CommentActionButton}" Content="Cancel"
                                                                    Command="{Binding CancelReplyCommand}" ToolTip="Close without replying (Esc)" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Signatures" AutomationProperties.Name="Signatures" themes:IconGlyphs.Glyph="{x:Static themes:IconGlyphs.Signatures}" Style="{StaticResource SidebarTabItemStyle}">
                        <Grid>
                            <TextBlock Text="This document is not digitally signed."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding HasSignatures, Converter={StaticResource InverseBoolToVis}}" />
                            <Button Content="Add long-term validation data..." VerticalAlignment="Bottom" Margin="8" Height="28"
                                    Command="{Binding AddLongTermValidationCommand}" Visibility="{Binding HasSignatures, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Embeds the signers' certificate status from their certificate authorities (asks before contacting them)." />
                            <Button Content="Add document timestamp..." VerticalAlignment="Bottom" Margin="8,8,8,44" Height="28" Command="{Binding AddDocumentTimestampCommand}" Visibility="{Binding HasSignatures, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Protects the signatures and their validation data with a document timestamp (PAdES-B-LTA), or renews it (asks before contacting anyone)." />
                            <ListBox ItemsSource="{Binding Signatures}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4" Margin="0,0,0,80"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.Name="Signatures"
                                     MouseDoubleClick="SignatureItem_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SignatureItemViewModel}">
                                        <Border Padding="8,8" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse x:Name="Mark" Width="12" Height="12" Margin="0,3,8,0" VerticalAlignment="Top" Fill="#1E8E3E" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" x:Name="StatusLine" Foreground="#1E8E3E" />
                                                    <TextBlock Text="{Binding Summary}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Identity}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding When}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding Ltv}" ToolTip="{Binding LtvDetail}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <TextBlock Text="{Binding PadesLevel}" ToolTip="{Binding LtvDetail}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    <Expander Header="Details" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}">
                                                        <TextBlock Text="{Binding Details}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                                                    </Expander>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Level}" Value="warn">
                                                <Setter TargetName="Mark" Property="Fill" Value="#E37400" />
                                                <Setter TargetName="StatusLine" Property="Foreground" Value="#B06000" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Level}" Value="bad">
                                                <Setter TargetName="Mark" Property="Fill" Value="#D93025" />
                                                <Setter TargetName="StatusLine" Property="Foreground" Value="#D93025" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Splitter between Sidebar and Viewport -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}" />

            <!-- Document Viewport Area -->
            <Grid Grid.Column="2" Background="{DynamicResource DocumentViewportBgBrush}">

                <!-- Empty Document Welcome State -->
                <Grid Visibility="{Binding IsDocumentLoaded, Converter={StaticResource InverseBoolToVis}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="36"
                            MaxWidth="500">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/assets/app_icon.png"
                                   Width="96"
                                   Height="96"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />

                            <TextBlock Text="PDF Viewer Native"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Drag and drop a PDF file here or click below to open."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <Button Content="Open PDF File..."
                                        Width="150"
                                        Height="36"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentTextBrush}"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Command="{Binding OpenFileDialogCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Open Sample Demo"
                                        Width="150"
                                        Height="36"
                                        Background="{DynamicResource SurfaceAltBgBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        FontWeight="SemiBold"
                                        Command="{Binding OpenSampleDocumentCommand}" />
                            </StackPanel>

                            <!-- Recent Files Section -->
                            <TextBlock Text="Recently Opened:"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding RecentFiles.Count, Converter={StaticResource BoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding RecentFiles}"
                                          Visibility="{Binding RecentFiles.Count, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                                HorizontalContentAlignment="Left"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Padding="4,2"
                                                Margin="0,2"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.ActiveDocument.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Measurement info: live while a measuring tool is on -->
                <Border x:Name="MeasurementInfoPanel"
                        Visibility="{Binding IsMeasuring, Converter={StaticResource BoolToVis}}"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" Panel.ZIndex="25"
                        Width="260" Padding="12,10" CornerRadius="6"
                        Background="{DynamicResource SurfaceBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        AutomationProperties.Name="Measurement info" AutomationProperties.LiveSetting="Polite">
                    <StackPanel DataContext="{Binding Measurement}">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="Margin" Value="0,1" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="{Binding Tool}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{Binding Scale}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                        <TextBlock Text="{Binding Segments}" FontFamily="Consolas" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding Total}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Area}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Angle}" />
                        <TextBlock Text="{Binding Cursor}" FontFamily="Consolas" />
                        <TextBlock Text="{Binding Snap}" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                        <TextBlock Text="{Binding Hint}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" Margin="0,4,0,0" />
                        <Button Content="Set Scale and Units..." HorizontalAlignment="Left" Margin="0,6,0,0" Padding="8,2"
                                Command="{Binding DataContext.SetMeasureScaleCommand, ElementName=MeasurementInfoPanel}" />
                    </StackPanel>
                </Border>

                <!-- Signature banner: the verdict over every signature, over the top of the page -->
                <Border x:Name="SignatureBannerBar"
                        VerticalAlignment="Top"
                        Panel.ZIndex="20"
                        Padding="12,6"
                        BorderThickness="0,0,0,1"
                        AutomationProperties.Name="Signature status"
                        AutomationProperties.LiveSetting="Polite">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Background" Value="#E6F4EA" />
                            <Setter Property="BorderBrush" Value="#1E8E3E" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasSignatures}" Value="True" />
                                        <Condition Binding="{Binding IsSignatureBannerDismissed}" Value="False" />
                                        <Condition Binding="{Binding IsDocumentLoaded}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding SignatureBannerLevel}" Value="warn">
                                    <Setter Property="Background" Value="#FEF7E0" />
                                    <Setter Property="BorderBrush" Value="#E37400" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SignatureBannerLevel}" Value="bad">
                                    <Setter Property="Background" Value="#FCE8E6" />
                                    <Setter Property="BorderBrush" Value="#D93025" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="&#x2715;" Width="24" Height="24" Margin="6,0,0,0"
                                Background="Transparent" BorderThickness="0" Foreground="#202124" Cursor="Hand"
                                ToolTip="Hide" AutomationProperties.Name="Hide signature status"
                                Command="{Binding DismissSignatureBannerCommand}" />
                        <Button DockPanel.Dock="Right" Content="Signature Panel" Height="24" Padding="10,0"
                                Background="White" BorderBrush="#DADCE0" BorderThickness="1" Foreground="#202124" Cursor="Hand"
                                Command="{Binding ShowSignaturePanelCommand}" />
                        <TextBlock Text="{Binding SignatureBanner}" VerticalAlignment="Center" TextWrapping="Wrap"
                                   Foreground="#202124" FontWeight="SemiBold" Margin="0,0,8,0" />
                    </DockPanel>
                </Border>

                <!-- Document Loaded Viewport -->
                <ScrollViewer x:Name="DocumentScrollViewer"
                              Visibility="{Binding IsDocumentLoaded, Converter={StaticResource BoolToVis}}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="True"
                              PreviewMouseWheel="DocumentScrollViewer_PreviewMouseWheel"
                              PreviewMouseDown="DocumentScrollViewer_PreviewMouseDown"
                              PreviewMouseMove="DocumentScrollViewer_PreviewMouseMove"
                              PreviewMouseUp="DocumentScrollViewer_PreviewMouseUp"
                              ScrollChanged="DocumentScrollViewer_ScrollChanged">

                    <!-- At least as wide as the viewport, so a narrower page centres in it with
                         equal margins. The 24 px margin sits inside it, on the centred grid:
                         on this grid it made the content 48 px wider than the viewport, which
                         always showed a horizontal scroll bar and moved the page 24 px right. -->
                    <Grid x:Name="PageAreaGrid" MinWidth="{Binding ViewportWidth, ElementName=DocumentScrollViewer}" HorizontalAlignment="Left">
                    <Grid x:Name="PageArea" HorizontalAlignment="Center" Margin="24">

                        <!-- Mode 1: Continuous Scrolling Mode -->
                        <!-- Bound to rows, not to the flat page list: the grouping on screen is
                             then the same grouping the scroll maths uses, rather than two
                             pieces of code that have to agree. A row holds one page in
                             continuous mode and a facing pair in two-page mode. -->
                        <ItemsControl x:Name="ContinuousPagesItemsControl"
                                      ItemsSource="{Binding PageRows}"
                                      HorizontalAlignment="Center"
                                      Visibility="{Binding IsMultiPageLayout, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type vm:PageRowViewModel}">
                                <ItemsControl ItemsSource="{Binding Pages}" HorizontalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                    <Border HorizontalAlignment="Center"
                                            AutomationProperties.Name="{Binding PageNumber, StringFormat=Page {0}}"
                                            AutomationProperties.HelpText="Press Ctrl+4 for read mode, which a screen reader can read."
                                            Margin="10,0,10,20"
                                            Background="{DynamicResource PageBgBrush}"
                                            CornerRadius="2">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#20000000" BlurRadius="15" ShadowDepth="3" />
                                        </Border.Effect>

                                        <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                                            <!-- 1. Loading indicator -->
                                            <ProgressBar IsIndeterminate="True"
                                                         Width="120"
                                                         Height="4"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                                            <!-- 2. Rendered Page Image -->
                                            <Image Source="{Binding PageSurface}"
                                                   views:PageSurfaceCache.IsEnabled="True"
                                                   Stretch="Fill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                            <!-- Viewport detail tile: the visible part of a zoomed page at exact device resolution
                                                 (Direct2D host), laid over the coarser page bitmap. Also the page's visibility probe. -->
                                            <Canvas views:PageDetailHost.IsHost="True" IsHitTestVisible="False" ClipToBounds="True">
                                                <Image Source="{Binding DetailImage}"
                                                       Canvas.Left="{Binding DetailRect.X}" Canvas.Top="{Binding DetailRect.Y}"
                                                       Width="{Binding DetailRect.Width}" Height="{Binding DetailRect.Height}"
                                                       Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                            </Canvas>

                                            <!-- Everything drawn over the page lives in unrotated page space,
                                                 because that is the space text boxes and annotation rectangles
                                                 are reported in. Turning the whole layer stack at once puts it
                                                 back on the picture; without it, rotating the page left every
                                                 highlight, selection and pen stroke behind, stranded away from
                                                 the words they were made over. -->
                                            <Grid Width="{Binding UnrotatedDisplayWidth}"
                                                  Height="{Binding UnrotatedDisplayHeight}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                <Grid.LayoutTransform>
                                                    <RotateTransform Angle="{Binding OverlayRotationAngle}" />
                                                </Grid.LayoutTransform>

                                            <!-- 3. Text Selection Layer (Translucent Accent / Blue) -->
                                            <ItemsControl ItemsSource="{Binding SelectedSegments}"
                                                          Width="{Binding UnrotatedDisplayWidth}"
                                                          Height="{Binding UnrotatedDisplayHeight}"
                                                          IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="{Binding UnrotatedDisplayWidth}" Height="{Binding UnrotatedDisplayHeight}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="X" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Canvas.Top">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Y" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Width">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Width" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Height">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Height" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:PageTextSegment}">
                                                        <Border Background="#5A3390FF" SnapsToDevicePixels="True" /><!-- a word processor's selection: a flat band, no outline -->
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 4. Vector Search Highlights Layer (Lime-Green / Active Gold) -->
                                            <ItemsControl ItemsSource="{Binding MatchesOnPage}"
                                                          Width="{Binding UnrotatedDisplayWidth}"
                                                          Height="{Binding UnrotatedDisplayHeight}"
                                                          IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="{Binding UnrotatedDisplayWidth}" Height="{Binding UnrotatedDisplayHeight}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="X" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Canvas.Top">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Y" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Width">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Width" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Height">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Height" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:SearchMatch}">
                                                        <Border Background="{Binding IsCurrentMatch, Converter={StaticResource SearchHighlightBgConverter}}"
                                                                BorderBrush="{Binding IsCurrentMatch, Converter={StaticResource SearchHighlightBorderConverter}}"
                                                                BorderThickness="1.5"
                                                                CornerRadius="2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 5. Vector Annotations Layer -->
                                            <ItemsControl ItemsSource="{Binding AnnotationsOnPage}"
                                                          Width="{Binding UnrotatedDisplayWidth}"
                                                          Height="{Binding UnrotatedDisplayHeight}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="{Binding UnrotatedDisplayWidth}" Height="{Binding UnrotatedDisplayHeight}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="X" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Canvas.Top">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Y" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Width">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Width" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Height">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Height" />
                                                                    <Binding Path="DataContext.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:AnnotationModel}">
                                                        <Grid ToolTip="{Binding Contents}"
                                                              Cursor="Hand"
                                                              Background="Transparent"
                                                              MouseLeftButtonDown="Annotation_MouseLeftButtonDown">
                                                            <!-- Highlight: one box, or one band per line of a multi-line highlight -->
                                                            <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Highlight}" Opacity="{Binding HighlightOverlayOpacity}">
                                                                <Grid Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="2"
                                                                            Visibility="{Binding HasQuads, Converter={StaticResource InverseBoolToVis}}" />
                                                                    <Path Data="{Binding HighlightGeometry}" Stretch="Fill" Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          Visibility="{Binding HasQuads, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>
                                                            </Grid>

                                                            <!-- Underline -->
                                                            <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Underline}">
                                                                <Grid Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" BorderThickness="0,0,0,2"
                                                                            Visibility="{Binding HasQuads, Converter={StaticResource InverseBoolToVis}}" />
                                                                    <Path Data="{Binding UnderlineGeometry}" Stretch="Fill" Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          Visibility="{Binding HasQuads, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>
                                                            </Grid>

                                                            <!-- StrikeOut -->
                                                            <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=StrikeOut}">
                                                                <Grid Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Line X1="0" Y1="0.5" X2="1" Y2="0.5" Stretch="Fill"
                                                                          Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          StrokeThickness="2"
                                                                          VerticalAlignment="Center"
                                                                          Visibility="{Binding HasQuads, Converter={StaticResource InverseBoolToVis}}" />
                                                                    <Path Data="{Binding StrikeOutGeometry}" Stretch="Fill" Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          Visibility="{Binding HasQuads, Converter={StaticResource BoolToVis}}" />
                                                                </Grid>
                                                            </Grid>

                                                            <!-- Note -->
                                                            <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    CornerRadius="4"
                                                                    Padding="2"
                                                                    Width="24"
                                                                    Height="24"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Note}">
                                                                <TextBlock Text="{x:Static themes:IconGlyphs.Note}" Style="{StaticResource GlyphBase}" Foreground="White" FontSize="14" />
                                                            </Border>

                                                            <!-- FreeText -->
                                                            <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    BorderThickness="1"
                                                                    Background="#20FFFFFF"
                                                                    Padding="4"
                                                                    Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=FreeText}">
                                                                <!-- Upright as the page is shown: turned back by its /Rotate (or the page's) -->
                                                                <Border.LayoutTransform>
                                                                    <MultiBinding Converter="{StaticResource TextTurnConverter}">
                                                                        <Binding Path="TextRotation" />
                                                                        <Binding Path="DataContext.IntrinsicRotation" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </Border.LayoutTransform>
                                                                <TextBlock Text="{Binding Contents}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap" />
                                                            </Border>

                                                            <!-- Rectangle Shape (one read from the file is drawn by the page until it is changed) -->
                                                            <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Rectangle}">
                                                                <Rectangle Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                           StrokeDashArray="{Binding StrokeDashArray}"
                                                                           Fill="{Binding FillColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                           Opacity="{Binding Opacity}"
                                                                           Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Rectangle.StrokeThickness>
                                                                        <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                                            <Binding Path="StrokeThickness" />
                                                                            <Binding Path="DataContext.DisplayScale" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        </MultiBinding>
                                                                    </Rectangle.StrokeThickness>
                                                                </Rectangle>
                                                            </Grid>

                                                            <!-- Ellipse Shape -->
                                                            <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Ellipse}">
                                                                <Ellipse Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         StrokeDashArray="{Binding StrokeDashArray}"
                                                                         Fill="{Binding FillColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                         Opacity="{Binding Opacity}"
                                                                         Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Ellipse.StrokeThickness>
                                                                        <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                                            <Binding Path="StrokeThickness" />
                                                                            <Binding Path="DataContext.DisplayScale" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        </MultiBinding>
                                                                    </Ellipse.StrokeThickness>
                                                                </Ellipse>
                                                            </Grid>

                                                            <!-- Freehand Ink. Without this the pen tool stored a stroke
                                                                 that was never drawn: the drawing disappeared on mouse-up. -->
                                                            <Path Data="{Binding InkStrokes, Converter={StaticResource InkStrokesConverter}}"
                                                                  Stretch="Fill"
                                                                  Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                  StrokeLineJoin="Round"
                                                                  StrokeStartLineCap="Round"
                                                                  StrokeEndLineCap="Round"
                                                                  Opacity="{Binding Opacity}"
                                                                  Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Ink}">
                                                                <Path.StrokeThickness>
                                                                    <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                                        <Binding Path="StrokeThickness" />
                                                                        <Binding Path="DataContext.DisplayScale" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    </MultiBinding>
                                                                </Path.StrokeThickness>
                                                            </Path>

                                                            <!-- Measurement: its line or outline and its result (one read from the file is drawn by the page) -->
                                                            <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Measurement}">
                                                                <Grid Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Path Data="{Binding MeasureGeometry}" Stretch="Fill"
                                                                          Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                          StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                                    <Border Background="#E6FFFFFF" CornerRadius="2" Padding="3,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                            BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" BorderThickness="0.5">
                                                                        <TextBlock Text="{Binding Contents}" FontSize="10" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                                                    </Border>
                                                                </Grid>
                                                            </Grid>

                                                            <!-- Line, arrow, polygon and connected lines: drawn from their points (one read from the file is drawn by the page) -->
                                                            <Grid Visibility="{Binding IsVertexShape, Converter={StaticResource BoolToVis}}">
                                                                <Path Stretch="None" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                      StrokeDashArray="{Binding StrokeDashArray}"
                                                                      Fill="{Binding InteriorColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                      Opacity="{Binding Opacity}"
                                                                      Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Path.StrokeThickness>
                                                                        <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                                            <Binding Path="StrokeThickness" />
                                                                            <Binding Path="DataContext.DisplayScale" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        </MultiBinding>
                                                                    </Path.StrokeThickness>
                                                                    <Path.Data>
                                                                        <MultiBinding Converter="{StaticResource ShapeGeometryConverter}" ConverterParameter="Body">
                                                                            <Binding />
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                            <Binding Path="Vertices" />
                                                                            <Binding Path="StrokeThickness" />
                                                                            <Binding Path="Width" />
                                                                            <Binding Path="Height" />
                                                                            <Binding Path="LineEndings" />
                                                                            <Binding Path="InteriorColorHex" />
                                                                            <Binding Path="Type" />
                                                                            <Binding Path="DataContext.DisplayScale" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        </MultiBinding>
                                                                    </Path.Data>
                                                                </Path>
                                                                <!-- The line endings: drawn solid, as the engine draws them on a dashed line -->
                                                                <Path Stretch="None" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                      Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                      Fill="{Binding InteriorColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                      Opacity="{Binding Opacity}"
                                                                      Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                                    <Path.StrokeThickness>
                                                                        <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                                            <Binding Path="StrokeThickness" />
                                                                            <Binding Path="DataContext.DisplayScale" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        </MultiBinding>
                                                                    </Path.StrokeThickness>
                                                                    <Path.Data>
                                                                        <MultiBinding Converter="{StaticResource ShapeGeometryConverter}" ConverterParameter="Ends">
                                                                            <Binding />
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                            <Binding Path="Vertices" />
                                                                            <Binding Path="StrokeThickness" />
                                                                            <Binding Path="Width" />
                                                                            <Binding Path="Height" />
                                                                            <Binding Path="LineEndings" />
                                                                            <Binding Path="InteriorColorHex" />
                                                                            <Binding Path="Type" />
                                                                            <Binding Path="DataContext.DisplayScale" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        </MultiBinding>
                                                                    </Path.Data>
                                                                </Path>
                                                            </Grid>

                                                            <!-- Stamp: drawn by the engine as it will be in the document -->
                                                            <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Stamp}">
                                                                <Image Source="{Binding StampPreview}" Stretch="Fill"
                                                                       Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}" />
                                                            </Grid>
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 6. Interactive Canvas for Selection & Drawing Annotations -->
                                            <Canvas Width="{Binding UnrotatedDisplayWidth}"
                                                    Height="{Binding UnrotatedDisplayHeight}"
                                                    Background="Transparent"
                                                    Tag="{Binding}"
                                                    MouseDown="PageCanvas_MouseDown"
                                                    MouseMove="PageCanvas_MouseMove"
                                                    MouseUp="PageCanvas_MouseUp"
                                                    MouseLeave="PageCanvas_MouseLeave"
                                                    ContextMenuOpening="PageCanvas_ContextMenuOpening">
                                                <Canvas.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="_Copy Text" Command="{Binding Owner.CopySelectedTextCommand}" InputGestureText="Ctrl+C" IsEnabled="{Binding Owner.HasTextSelection}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="{x:Static themes:IconGlyphs.Copy}" Style="{StaticResource MenuGlyph}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="_Highlight Selection" Command="{Binding Owner.HighlightSelectedTextCommand}" IsEnabled="{Binding Owner.HasTextSelection}">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="{x:Static themes:IconGlyphs.Highlight}" Style="{StaticResource MenuGlyph}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="Select _All Text on Page" Command="{Binding Owner.SelectAllTextCommand}" InputGestureText="Ctrl+A">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="{x:Static themes:IconGlyphs.SelectAll}" Style="{StaticResource MenuGlyph}" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="_Deselect All" Command="{Binding Owner.ClearSelectionCommand}" InputGestureText="Esc" IsEnabled="{Binding Owner.HasTextSelection}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Deselect}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                                                    </ContextMenu>
                                                </Canvas.ContextMenu>
                                            </Canvas>
                                            <views:FormFieldsLayer Page="{Binding}" Width="{Binding UnrotatedDisplayWidth}" Height="{Binding UnrotatedDisplayHeight}" /><!-- 7. form fields: real editors over the page -->
                                            <views:PageLinksLayer Page="{Binding}" Width="{Binding UnrotatedDisplayWidth}" Height="{Binding UnrotatedDisplayHeight}" /><!-- 7b. links, for screen readers -->
                                            <views:RedactionMarksLayer Page="{Binding}" Width="{Binding UnrotatedDisplayWidth}" Height="{Binding UnrotatedDisplayHeight}" /><!-- 8. areas marked for redaction -->
                                            <views:ContentEditLayer Page="{Binding}" Width="{Binding UnrotatedDisplayWidth}" Height="{Binding UnrotatedDisplayHeight}" /><!-- 9. paragraphs and images being edited -->
                                            <views:AnnotationEditLayer Page="{Binding}" Width="{Binding UnrotatedDisplayWidth}" Height="{Binding UnrotatedDisplayHeight}" /><!-- 10. the selected annotation's handles -->
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mode 2: Single Page View Mode -->
                        <Border Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=SinglePage}"
                                Background="{DynamicResource PageBgBrush}"
                                CornerRadius="2"
                                Width="{Binding SingleCurrentPage.DisplayWidth}"
                                Height="{Binding SingleCurrentPage.DisplayHeight}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#20000000" BlurRadius="15" ShadowDepth="3" />
                            </Border.Effect>

                            <Grid Width="{Binding SingleCurrentPage.DisplayWidth}" Height="{Binding SingleCurrentPage.DisplayHeight}">
                                <!-- Loading indicator -->
                                <ProgressBar IsIndeterminate="True"
                                             Width="120"
                                             Height="4"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding SingleCurrentPage.IsLoading, Converter={StaticResource BoolToVis}}" />

                                <!-- Rendered Page Image -->
                                <Image Source="{Binding SingleCurrentPage.PageSurface}"
                                                   views:PageSurfaceCache.IsEnabled="True"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <!-- Viewport detail tile: the visible part of a zoomed page at exact device resolution
                                     (Direct2D host), laid over the coarser page bitmap. Also the page's visibility probe. -->
                                <Canvas views:PageDetailHost.IsHost="True" IsHitTestVisible="False" ClipToBounds="True" DataContext="{Binding SingleCurrentPage}">
                                    <Image Source="{Binding DetailImage}"
                                           Canvas.Left="{Binding DetailRect.X}" Canvas.Top="{Binding DetailRect.Y}"
                                           Width="{Binding DetailRect.Width}" Height="{Binding DetailRect.Height}"
                                           Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                </Canvas>

                                <!-- The overlay stack, in unrotated page space and then turned to
                                     sit on the picture. Same as the continuous view. -->
                                <Grid Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}"
                                      Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center">
                                    <Grid.LayoutTransform>
                                        <RotateTransform Angle="{Binding SingleCurrentPage.OverlayRotationAngle}" />
                                    </Grid.LayoutTransform>

                                <!-- Text Selection Layer (Translucent Accent / Blue) -->
                                <ItemsControl ItemsSource="{Binding SingleCurrentPage.SelectedSegments}"
                                              Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}"
                                              Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}"
                                              IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}" Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="X" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Width">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Width" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Height">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Height" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:PageTextSegment}">
                                            <Border Background="#5A3390FF" SnapsToDevicePixels="True" /><!-- a word processor's selection: a flat band, no outline -->
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Vector Search Highlights Layer -->
                                <ItemsControl ItemsSource="{Binding SingleCurrentPage.MatchesOnPage}"
                                              Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}"
                                              Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}"
                                              IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}" Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="X" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Width">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Width" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Height">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Height" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SearchMatch}">
                                            <Border Background="{Binding IsCurrentMatch, Converter={StaticResource SearchHighlightBgConverter}}"
                                                    BorderBrush="{Binding IsCurrentMatch, Converter={StaticResource SearchHighlightBorderConverter}}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Vector Annotations Layer -->
                                <ItemsControl ItemsSource="{Binding SingleCurrentPage.AnnotationsOnPage}"
                                              Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}"
                                              Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}" Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="X" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Width">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Width" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Height">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Height" />
                                                        <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.UnrotatedDisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:AnnotationModel}">
                                            <Grid ToolTip="{Binding Contents}"
                                                  Cursor="Hand"
                                                  Background="Transparent"
                                                  MouseLeftButtonDown="Annotation_MouseLeftButtonDown">
                                                <!-- Highlight: one box, or one band per line of a multi-line highlight -->
                                                <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Highlight}" Opacity="{Binding HighlightOverlayOpacity}">
                                                    <Grid Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                        <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="2"
                                                                Visibility="{Binding HasQuads, Converter={StaticResource InverseBoolToVis}}" />
                                                        <Path Data="{Binding HighlightGeometry}" Stretch="Fill" Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                              Visibility="{Binding HasQuads, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Grid>

                                                <!-- Underline -->
                                                <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Underline}">
                                                    <Grid Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                        <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" BorderThickness="0,0,0,2"
                                                                Visibility="{Binding HasQuads, Converter={StaticResource InverseBoolToVis}}" />
                                                        <Path Data="{Binding UnderlineGeometry}" Stretch="Fill" Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                              Visibility="{Binding HasQuads, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Grid>

                                                <!-- StrikeOut -->
                                                <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=StrikeOut}">
                                                    <Grid Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                        <Line X1="0" Y1="0.5" X2="1" Y2="0.5" Stretch="Fill"
                                                              Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                              StrokeThickness="2"
                                                              VerticalAlignment="Center"
                                                              Visibility="{Binding HasQuads, Converter={StaticResource InverseBoolToVis}}" />
                                                        <Path Data="{Binding StrikeOutGeometry}" Stretch="Fill" Fill="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                              Visibility="{Binding HasQuads, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </Grid>

                                                <!-- Note -->
                                                <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                        CornerRadius="4"
                                                        Padding="2"
                                                        Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Note}">
                                                    <TextBlock Text="{x:Static themes:IconGlyphs.Note}" Style="{StaticResource GlyphBase}" Foreground="White" FontSize="14" />
                                                </Border>

                                                <!-- FreeText -->
                                                <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderThickness="1"
                                                        Background="#20FFFFFF"
                                                        Padding="4"
                                                        Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=FreeText}">
                                                    <!-- Upright as the page is shown: turned back by its /Rotate (or the page's) -->
                                                    <Border.LayoutTransform>
                                                        <MultiBinding Converter="{StaticResource TextTurnConverter}">
                                                            <Binding Path="TextRotation" />
                                                            <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.IntrinsicRotation" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </MultiBinding>
                                                    </Border.LayoutTransform>
                                                    <TextBlock Text="{Binding Contents}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </Border>

                                                <!-- Rectangle Shape (one read from the file is drawn by the page until it is changed) -->
                                                <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Rectangle}">
                                                    <Rectangle Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                               StrokeDashArray="{Binding StrokeDashArray}"
                                                               Fill="{Binding FillColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                               Opacity="{Binding Opacity}"
                                                               Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                        <Rectangle.StrokeThickness>
                                                            <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                                <Binding Path="StrokeThickness" />
                                                                <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.DisplayScale" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Rectangle.StrokeThickness>
                                                    </Rectangle>
                                                </Grid>

                                                <!-- Ellipse Shape -->
                                                <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Ellipse}">
                                                    <Ellipse Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                             StrokeDashArray="{Binding StrokeDashArray}"
                                                             Fill="{Binding FillColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                             Opacity="{Binding Opacity}"
                                                             Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                        <Ellipse.StrokeThickness>
                                                            <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                                <Binding Path="StrokeThickness" />
                                                                <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.DisplayScale" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Ellipse.StrokeThickness>
                                                    </Ellipse>
                                                </Grid>

                                                <!-- Freehand Ink -->
                                                <Path Data="{Binding InkStrokes, Converter={StaticResource InkStrokesConverter}}"
                                                      Stretch="Fill"
                                                      Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                      StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      Opacity="{Binding Opacity}"
                                                      Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Ink}">
                                                    <Path.StrokeThickness>
                                                        <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                            <Binding Path="StrokeThickness" />
                                                            <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.DisplayScale" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                        </MultiBinding>
                                                    </Path.StrokeThickness>
                                                </Path>

                                                <!-- Measurement: its line or outline and its result (one read from the file is drawn by the page) -->
                                                <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Measurement}">
                                                    <Grid Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                        <Path Data="{Binding MeasureGeometry}" Stretch="Fill"
                                                              Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                              StrokeThickness="1.5" StrokeLineJoin="Round" />
                                                        <Border Background="#E6FFFFFF" CornerRadius="2" Padding="3,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" BorderThickness="0.5">
                                                            <TextBlock Text="{Binding Contents}" FontSize="10" Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" />
                                                        </Border>
                                                    </Grid>
                                                </Grid>

                                                <!-- Line, arrow, polygon and connected lines: drawn from their points (one read from the file is drawn by the page) -->
                                                <Grid Visibility="{Binding IsVertexShape, Converter={StaticResource BoolToVis}}">
                                                    <Path Stretch="None" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                          StrokeDashArray="{Binding StrokeDashArray}"
                                                          Fill="{Binding InteriorColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                          Opacity="{Binding Opacity}"
                                                          Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                        <Path.StrokeThickness>
                                                            <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                                <Binding Path="StrokeThickness" />
                                                                <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.DisplayScale" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Path.StrokeThickness>
                                                        <Path.Data>
                                                            <MultiBinding Converter="{StaticResource ShapeGeometryConverter}" ConverterParameter="Body">
                                                                <Binding />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                <Binding Path="Vertices" />
                                                                <Binding Path="StrokeThickness" />
                                                                <Binding Path="Width" />
                                                                <Binding Path="Height" />
                                                                <Binding Path="LineEndings" />
                                                                <Binding Path="InteriorColorHex" />
                                                                <Binding Path="Type" />
                                                                <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.DisplayScale" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Path.Data>
                                                    </Path>
                                                    <!-- The line endings: drawn solid, as the engine draws them on a dashed line -->
                                                    <Path Stretch="None" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                          Fill="{Binding InteriorColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                          Opacity="{Binding Opacity}"
                                                          Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}">
                                                        <Path.StrokeThickness>
                                                            <MultiBinding Converter="{StaticResource ScaledStrokeConverter}">
                                                                <Binding Path="StrokeThickness" />
                                                                <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.DisplayScale" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Path.StrokeThickness>
                                                        <Path.Data>
                                                            <MultiBinding Converter="{StaticResource ShapeGeometryConverter}" ConverterParameter="Ends">
                                                                <Binding />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=Grid}" />
                                                                <Binding Path="Vertices" />
                                                                <Binding Path="StrokeThickness" />
                                                                <Binding Path="Width" />
                                                                <Binding Path="Height" />
                                                                <Binding Path="LineEndings" />
                                                                <Binding Path="InteriorColorHex" />
                                                                <Binding Path="Type" />
                                                                <Binding Path="DataContext.ActiveDocument.SingleCurrentPage.DisplayScale" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                            </MultiBinding>
                                                        </Path.Data>
                                                    </Path>
                                                </Grid>

                                                <!-- Stamp: drawn by the engine as it will be in the document -->
                                                <Grid Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Stamp}">
                                                    <Image Source="{Binding StampPreview}" Stretch="Fill"
                                                           Visibility="{Binding IsDrawnByPage, Converter={StaticResource InverseBoolToVis}}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Interactive Canvas for Selection & Drawing Annotations -->
                                <Canvas Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}"
                                        Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}"
                                        Background="Transparent"
                                        Tag="{Binding SingleCurrentPage}"
                                        MouseDown="PageCanvas_MouseDown"
                                        MouseMove="PageCanvas_MouseMove"
                                        MouseUp="PageCanvas_MouseUp"
                                        MouseLeave="PageCanvas_MouseLeave"
                                                    ContextMenuOpening="PageCanvas_ContextMenuOpening">
                                    <Canvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="_Copy Text" Command="{Binding CopySelectedTextCommand}" InputGestureText="Ctrl+C" IsEnabled="{Binding HasTextSelection}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="{x:Static themes:IconGlyphs.Copy}" Style="{StaticResource MenuGlyph}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="_Highlight Selection" Command="{Binding HighlightSelectedTextCommand}" IsEnabled="{Binding HasTextSelection}">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="{x:Static themes:IconGlyphs.Highlight}" Style="{StaticResource MenuGlyph}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Select _All Text on Page" Command="{Binding SelectAllTextCommand}" InputGestureText="Ctrl+A">
                                                <MenuItem.Icon>
                                                    <TextBlock Text="{x:Static themes:IconGlyphs.SelectAll}" Style="{StaticResource MenuGlyph}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="_Deselect All" Command="{Binding ClearSelectionCommand}" InputGestureText="Esc" IsEnabled="{Binding HasTextSelection}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Deselect}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                                        </ContextMenu>
                                    </Canvas.ContextMenu>
                                </Canvas>
                                <views:FormFieldsLayer Page="{Binding SingleCurrentPage}" Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}" Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}" />
                                <views:PageLinksLayer Page="{Binding SingleCurrentPage}" Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}" Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}" />
                                <views:RedactionMarksLayer Page="{Binding SingleCurrentPage}" Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}" Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}" />
                                <views:ContentEditLayer Page="{Binding SingleCurrentPage}" Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}" Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}" />
                                <views:AnnotationEditLayer Page="{Binding SingleCurrentPage}" Width="{Binding SingleCurrentPage.UnrotatedDisplayWidth}" Height="{Binding SingleCurrentPage.UnrotatedDisplayHeight}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 5. Bottom Status Bar -->
        <StatusBar x:Name="MainStatusBar"
                   Grid.Row="5"
                   Background="{DynamicResource ToolbarBgBrush}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>

            <!-- A print job being sent in the background can be stopped here. -->
            <StatusBarItem Visibility="{Binding IsPrinting, Converter={StaticResource BoolToVis}}">
                <Button Content="Cancel printing"
                        Command="{Binding CancelPrintCommand}"
                        Padding="8,0"
                        ToolTip="Stop sending this document to the printer" />
            </StatusBarItem>

            <!--
                Secured-document indicator: the document restricts printing, copying, commenting,
                form filling, editing or page assembly for this reader (ISO 32000-2 Table 22).
            -->
            <!-- The PDF/A conformance the document claims, as Acrobat's PDF/A banner shows it. -->
            <StatusBarItem Visibility="{Binding HasPdfAClaim, Converter={StaticResource BoolToVis}}"
                           ToolTip="The document claims PDF/A (archival) conformance. Tools > PDF/A checks it.">
                <TextBlock Text="{Binding PdfAClaim}" />
            </StatusBarItem>

            <StatusBarItem Visibility="{Binding IsSecured, Converter={StaticResource BoolToVis}}"
                           ToolTip="Opened without the owner password: the author restricted these actions.">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F512;" Margin="0,0,6,0" FontSize="12" />
                    <TextBlock Text="{Binding SecuritySummary}" />
                </StackPanel>
            </StatusBarItem>

            <!--
                Document safety indicator. Shown only when the document carries active
                content, so it means something when it appears. Clicking opens the detail.
            -->
            <StatusBarItem Visibility="{Binding HasElevatedRisk, Converter={StaticResource BoolToVis}}">
                <Button Command="{Binding ShowDocumentSafetyCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="8,0"
                        ToolTip="This document carries active content. Click for details.">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x26A0;" Margin="0,0,6,0" Foreground="#E6A700" FontSize="13" />
                        <TextBlock Text="{Binding SafetySummary}" Foreground="#E6A700" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageCount, StringFormat='Pages: {0}'}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding ZoomPercentageText, StringFormat='Zoom: {0}'}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding ApplicationVersion, StringFormat='v{0}'}" Margin="0,0,16,0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    <Border Background="#10E8910B"
                            BorderBrush="#E8910B"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="UpdateBadge_Click"
                            ToolTip="Click to update"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding AvailableUpdateVersion, StringFormat='⬆ v{0} available'}"
                                   Foreground="#E8910B"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                    <Border Background="{DynamicResource AccentLightBrush}"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="0,0,10,0"
                            Cursor="Help"
                            ToolTip="{Binding CurrentPageEngineTooltip}">
                        <TextBlock Text="{Binding CurrentPageEngineBadge}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                    <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="3" Padding="6,1">
                        <TextBlock Text="{Binding Metadata.LicenseStatus, FallbackValue='Vector engine'}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
