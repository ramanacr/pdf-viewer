<Window x:Class="PdfViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PdfViewer.ViewModels"
        xmlns:models="clr-namespace:PdfViewer.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/assets/app_icon.png"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenFileDialogCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding SaveAnnotatedAsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding CopySelectedTextCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="A" Command="{Binding SelectAllTextCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ClearSelectionCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="F" Command="{Binding ToggleSearchCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D" Command="{Binding ShowPropertiesCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad1" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="R" Command="{Binding RotateClockwiseCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="R" Command="{Binding RotateCounterClockwiseCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
        <KeyBinding Key="Home" Command="{Binding FirstPageCommand}" />
        <KeyBinding Key="End" Command="{Binding LastPageCommand}" />
        <KeyBinding Key="F3" Command="{Binding NextSearchMatchCommand}" />
        <KeyBinding Modifiers="Shift" Key="F3" Command="{Binding PreviousSearchMatchCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Menu -->
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Search Bar -->
            <RowDefinition Height="*" />    <!-- Main Viewport + Sidebar -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Main Menu -->
        <Menu Grid.Row="0"
              Background="{DynamicResource ToolbarBgBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileDialogCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open _Sample Demo Document" Command="{Binding OpenSampleDocumentCommand}" />
                <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Close Document" Command="{Binding CloseDocumentCommand}" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="Save _Annotated As..." Command="{Binding SaveAnnotatedAsCommand}" InputGestureText="Ctrl+Shift+S" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="_Export to Images..." Command="{Binding ExportImagesCommand}" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="_Print..." Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" IsEnabled="{Binding IsDocumentLoaded}" />
                <Separator />
                <MenuItem Header="Document _Properties..." Command="{Binding ShowPropertiesCommand}" InputGestureText="Ctrl+D" IsEnabled="{Binding IsDocumentLoaded}" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" InputGestureText="Alt+F4" />
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="_Copy Selected Text" Command="{Binding CopySelectedTextCommand}" InputGestureText="Ctrl+C" IsEnabled="{Binding HasTextSelection}" />
                <MenuItem Header="_Highlight Selection" Command="{Binding HighlightSelectedTextCommand}" IsEnabled="{Binding HasTextSelection}" />
                <Separator />
                <MenuItem Header="Select _All Text on Page" Command="{Binding SelectAllTextCommand}" InputGestureText="Ctrl+A" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="_Deselect All" Command="{Binding ClearSelectionCommand}" InputGestureText="Esc" IsEnabled="{Binding HasTextSelection}" />
                <Separator />
                <MenuItem Header="_Redact Selected Text..."
                          Command="{Binding RedactSelectionCommand}"
                          IsEnabled="{Binding HasTextSelection}"
                          ToolTip="Permanently removes the selected text and saves the result as a new document." />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Continuous Scrolling" Command="{Binding ToggleViewModeCommand}" IsCheckable="True" IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Continuous, Mode=OneWay}" />
                <MenuItem Header="Single Page View" Command="{Binding ToggleViewModeCommand}" IsCheckable="True" IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=SinglePage, Mode=OneWay}" />
                <Separator />
                <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="Fit to _Width" Command="{Binding FitWidthCommand}" InputGestureText="Ctrl+1" />
                <MenuItem Header="Fit to _Page" Command="{Binding FitPageCommand}" InputGestureText="Ctrl+0" />
                <Separator />
                <MenuItem Header="Rotate _Clockwise" Command="{Binding RotateClockwiseCommand}" InputGestureText="Ctrl+R" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="Rotate Counter-Clockwise" Command="{Binding RotateCounterClockwiseCommand}" InputGestureText="Ctrl+Shift+R" IsEnabled="{Binding IsDocumentLoaded}" />
                <Separator />
                <MenuItem Header="Toggle _Sidebar" Command="{Binding ToggleSidebarCommand}" InputGestureText="Ctrl+B" IsCheckable="True" IsChecked="{Binding IsSidebarOpen}" />
                <MenuItem Header="Toggle Light / _Dark Theme" Command="{Binding ToggleThemeCommand}" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_Find Text..." Command="{Binding ToggleSearchCommand}" InputGestureText="Ctrl+F" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="_Hand / Pan Tool" Command="{Binding TogglePanToolCommand}" IsCheckable="True" IsChecked="{Binding IsPanningEnabled}" IsEnabled="{Binding IsDocumentLoaded}" />
                <Separator />
                <MenuItem Header="Recognise _Text on Page (OCR)"
                          Command="{Binding RecognizeTextOnPageCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Reads the page's text, using optical recognition for scanned pages, and copies it to the clipboard." />
                <MenuItem Header="Verify Digital _Signatures..."
                          Command="{Binding VerifySignaturesCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Cryptographically verifies every signature in the document." />
                <Separator />
                <MenuItem Header="_Merge PDFs..."
                          Command="{Binding MergeDocumentsCommand}"
                          ToolTip="Combines several PDF documents into a single file." />
                <MenuItem Header="Spl_it Into Pages..."
                          Command="{Binding SplitDocumentCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Writes each page of this document to its own PDF file." />
                <MenuItem Header="E_xtract Current Page..."
                          Command="{Binding ExtractCurrentPageCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Saves the page you are viewing as its own PDF." />
                <Separator />
                <MenuItem Header="Fill _Form Fields..."
                          Command="{Binding EditFormFieldsCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Lists the document's form fields and writes edited values to a new document." />
                <MenuItem Header="_Compare With Document..."
                          Command="{Binding CompareWithDocumentCommand}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Compares this document against another and reports the pages that differ." />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="_Check for Updates..." Click="CheckForUpdatesMenuItem_Click" />
                <Separator />
                <MenuItem Header="_GitHub Repository" Click="GitHubRepoMenuItem_Click" />
                <MenuItem Header="View _Releases..." Click="ViewReleasesMenuItem_Click" />
                <Separator />
                <MenuItem Header="_About PDF Viewer..." Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!-- 2. Main Ribbon Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Open Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding OpenFileDialogCommand}"
                        ToolTip="Open PDF (Ctrl+O)">
                    <Path Data="{StaticResource IconOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Copy Selected Text Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding CopySelectedTextCommand}"
                        IsEnabled="{Binding HasTextSelection}"
                        ToolTip="Copy Selected Text (Ctrl+C)">
                    <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Print Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding PrintCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Print Document (Ctrl+P)">
                    <Path Data="{StaticResource IconPrint}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Export Images Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ExportImagesCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Export Pages to Images">
                    <Path Data="{StaticResource IconExport}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Sidebar Toggle -->
                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding IsSidebarOpen}"
                              ToolTip="Toggle Navigation Sidebar (Ctrl+B)">
                    <Path Data="{StaticResource IconSidebar}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Page Navigation Controls -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding FirstPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="First Page (Home)">
                    <TextBlock Text="|&#x25C0;" FontWeight="Bold" FontSize="11" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Previous Page (PageUp)">
                    <Path Data="{StaticResource IconArrowLeft}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <TextBox Width="42"
                             Height="26"
                             Text="{Binding CurrentPageNumber, UpdateSourceTrigger=LostFocus}"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding IsDocumentLoaded}"
                             KeyDown="PageInputBox_KeyDown" />
                    <TextBlock Text=" / " VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PageCount}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                </StackPanel>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Next Page (PageDown)">
                    <Path Data="{StaticResource IconArrowRight}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding LastPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Last Page (End)">
                    <TextBlock Text="&#x25B6;|" FontWeight="Bold" FontSize="11" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Zoom Controls -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ZoomOutCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Zoom Out (Ctrl+-)">
                    <Path Data="{StaticResource IconZoomOut}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Slider Width="90"
                        Minimum="0.25"
                        Maximum="3.0"
                        Value="{Binding ZoomLevel}"
                        SmallChange="0.1"
                        LargeChange="0.25"
                        VerticalAlignment="Center"
                        Margin="4,0"
                        IsEnabled="{Binding IsDocumentLoaded}" />

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ZoomInCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Zoom In (Ctrl++)">
                    <Path Data="{StaticResource IconZoomIn}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <TextBlock Text="{Binding ZoomPercentageText}"
                           Width="46"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="2,0,6,0" />

                <!-- Fit Width / Fit Page -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding FitWidthCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Fit to Width (Ctrl+1)">
                    <Path Data="{StaticResource IconFitWidth}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding FitPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Fit to Page (Ctrl+0)">
                    <Path Data="{StaticResource IconFitPage}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Rotation -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding RotateCounterClockwiseCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Rotate Counter-Clockwise (Ctrl+Shift+R)">
                    <Path Data="{StaticResource IconRotateCCW}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding RotateClockwiseCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Rotate Clockwise (Ctrl+R)">
                    <Path Data="{StaticResource IconRotateCW}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- View Layout Mode & Pan Tool -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ToggleViewModeCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Toggle View Mode (Continuous / Single Page)">
                    <Path Data="{StaticResource IconViewMode}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding IsPanningEnabled}"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Hand / Pan Tool">
                    <Path Data="{StaticResource IconPan}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Annotation Tools -->
                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Highlight, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Highlight"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Highlight Tool">
                    <Path Data="{StaticResource IconHighlight}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Underline, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Underline"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Underline Tool">
                    <Path Data="{StaticResource IconUnderline}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Note, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Note"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Sticky Note / Comment Tool">
                    <Path Data="{StaticResource IconNote}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=FreeText, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="FreeText"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="FreeText Box Tool">
                    <Path Data="{StaticResource IconText}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Ink, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Ink"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Freehand Ink / Pen Tool">
                    <Path Data="{StaticResource IconPen}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Rectangle, Mode=OneWay}"
                              Command="{Binding ToggleAnnotationToolCommand}"
                              CommandParameter="Rectangle"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Rectangle Shape Tool">
                    <Path Data="{StaticResource IconRectangle}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <!-- Annotation Color Selector ComboBox with Color Swatches -->
                <ComboBox Width="54"
                          Height="28"
                          Margin="4,2"
                          ItemsSource="{Binding AnnotationColors}"
                          SelectedItem="{Binding SelectedAnnotationColor}"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Select Annotation Color">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="16" Height="16" CornerRadius="8" Background="{Binding Converter={StaticResource HexToBrushConverter}}" BorderBrush="#888888" BorderThickness="1" Margin="1,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Annotation Thickness Selector -->
                <ComboBox Width="60"
                          Height="28"
                          Margin="2,2"
                          SelectedValue="{Binding SelectedAnnotationThickness}"
                          SelectedValuePath="Tag"
                          IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Annotation Stroke Thickness">
                    <ComboBoxItem Tag="1.0" Content="1 pt" />
                    <ComboBoxItem Tag="2.0" Content="2 pt" IsSelected="True" />
                    <ComboBoxItem Tag="3.0" Content="3 pt" />
                    <ComboBoxItem Tag="4.0" Content="4 pt" />
                    <ComboBoxItem Tag="6.0" Content="6 pt" />
                </ComboBox>

                <!-- Save Annotated As Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding SaveAnnotatedAsCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Save Annotated PDF As... (Ctrl+Shift+S)">
                    <Path Data="{StaticResource IconSaveAs}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Search Toggle -->
                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding IsSearchOpen}"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Find Text (Ctrl+F)">
                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <!-- Theme Toggle -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="Toggle Light / Dark Mode">
                    <Path Data="{StaticResource IconTheme}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Document Properties -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ShowPropertiesCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Document Properties (Ctrl+D)">
                    <Path Data="{StaticResource IconProperties}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- 3. Collapsible In-Document Search Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />

                <TextBox Grid.Column="1"
                         x:Name="SearchInputBox"
                         Height="28"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchInputBox_KeyDown" />

                <Button Grid.Column="2"
                        Content="Search"
                        Height="28"
                        Padding="12,0"
                        Margin="6,0,4,0"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding ExecuteSearchCommand}" />

                <CheckBox Grid.Column="3"
                          Content="Match Case"
                          IsChecked="{Binding SearchMatchCase}"
                          VerticalAlignment="Center"
                          Margin="8,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding PreviousSearchMatchCommand}"
                            ToolTip="Previous Match (Shift+F3)">
                        <Path Data="{StaticResource IconArrowUp}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding NextSearchMatchCommand}"
                            ToolTip="Next Match (F3)">
                        <Path Data="{StaticResource IconArrowDown}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="5"
                           Text="{Binding SearchSummaryText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="12,0" />

                <Button Grid.Column="6"
                        Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ToggleSearchCommand}"
                        ToolTip="Close Search">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <!-- 4. Main Viewport & Collapsible Sidebar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Sidebar Column -->
                <ColumnDefinition x:Name="SidebarColumn"
                                  Width="280"
                                  MinWidth="180"
                                  MaxWidth="450" />
                <!-- Splitter Column -->
                <ColumnDefinition x:Name="SidebarSplitterColumn"
                                  Width="Auto" />
                <!-- Viewport Column -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}">
                <TabControl SelectedIndex="{Binding SelectedSidebarTab}"
                            Background="Transparent"
                            BorderThickness="0">
                    <!-- Tab 1: Thumbnails -->
                    <TabItem Header="Pages" Style="{StaticResource SidebarTabItemStyle}">
                        <ScrollViewer x:Name="ThumbnailsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <ItemsControl ItemsSource="{Binding Thumbnails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThumbnailViewModel}">
                                        <Border Margin="0,0,0,12"
                                                Background="{DynamicResource SurfaceBgBrush}"
                                                BorderThickness="2"
                                                CornerRadius="4"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="Thumbnail_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <Border.ToolTip>
                                                <ToolTip Background="{DynamicResource SurfaceBgBrush}"
                                                         BorderBrush="{DynamicResource BorderBrush}"
                                                         BorderThickness="1"
                                                         Padding="8"
                                                         Placement="Right">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0} Preview'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   Margin="0,0,0,6"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Border BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                MaxWidth="320"
                                                                MaxHeight="450"
                                                                Background="White">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.25" Color="#000000" />
                                                            </Border.Effect>
                                                            <Image Source="{Binding ThumbnailImage}"
                                                                   Stretch="Uniform"
                                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                                        </Border>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Border.ToolTip>

                                            <StackPanel Margin="6">
                                                <Border Height="160"
                                                        Background="{DynamicResource BorderBrush}"
                                                        CornerRadius="2"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailImage}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Bookmarks / Outline Tree -->
                    <TabItem Header="Bookmarks" Style="{StaticResource SidebarTabItemStyle}">
                        <Grid>
                            <TextBlock Text="No bookmarks found in this document."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="16"
                                       Visibility="{Binding Bookmarks.Count, Converter={StaticResource InverseBoolToVis}}" />

                            <TreeView ItemsSource="{Binding Bookmarks}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6"
                                      SelectedItemChanged="BookmarkTree_SelectedItemChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}" DataType="{x:Type models:BookmarkItem}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TargetPageNumber, StringFormat=' (p. {0})'}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Search Results -->
                    <TabItem Header="Search Results" Style="{StaticResource SidebarTabItemStyle}">
                        <Grid>
                            <TextBlock Text="Search results will appear here."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SearchMatches.Count, Converter={StaticResource InverseBoolToVis}}" />

                            <ListBox x:Name="SearchResultsListBox"
                                     ItemsSource="{Binding SearchMatches}"
                                     SelectedItem="{Binding SelectedSearchMatch, Mode=TwoWay}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4"
                                     SelectionChanged="SearchResultsListBox_SelectionChanged"
                                     MouseDoubleClick="SearchMatch_MouseDoubleClick">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,4" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="SearchResultItem_PreviewMouseLeftButtonUp" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SearchMatch}">
                                        <Border Padding="8,6"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding ContextSnippet}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>

                    <!-- Tab 4: Annotations -->
                    <TabItem Header="Annotations" Style="{StaticResource SidebarTabItemStyle}">
                        <Grid>
                            <TextBlock Text="No annotations added yet."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding AllAnnotations.Count, Converter={StaticResource InverseBoolToVis}}" />

                            <ListBox ItemsSource="{Binding AllAnnotations}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4"
                                     MouseDoubleClick="AnnotationItem_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:AnnotationModel}">
                                        <Border Padding="8,6"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                                   FontWeight="Bold"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                        <TextBlock Text=" • " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                                        <TextBlock Text="{Binding Type}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                                        <Border Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Contents, FallbackValue='(No comment text)'}"
                                                               TextWrapping="Wrap"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,2,0,0" />
                                                    <TextBlock Text="{Binding CreationDate, StringFormat='{}{0:g}'}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Style="{StaticResource ToolbarIconButton}"
                                                            Click="EditAnnotationButton_Click"
                                                            Tag="{Binding}"
                                                            ToolTip="Edit Comment"
                                                            Margin="0,0,4,0">
                                                        <Path Data="{StaticResource IconText}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                    <Button Style="{StaticResource ToolbarIconButton}"
                                                            Command="{Binding DataContext.DeleteAnnotationCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="Delete Annotation">
                                                        <Path Data="{StaticResource IconDelete}" Fill="#D83B01" Width="12" Height="12" Stretch="Uniform" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Splitter between Sidebar and Viewport -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}" />

            <!-- Document Viewport Area -->
            <Grid Grid.Column="2" Background="{DynamicResource DocumentViewportBgBrush}">

                <!-- Empty Document Welcome State -->
                <Grid Visibility="{Binding IsDocumentLoaded, Converter={StaticResource InverseBoolToVis}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="36"
                            MaxWidth="500">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/assets/app_icon.png"
                                   Width="96"
                                   Height="96"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />

                            <TextBlock Text="PDF Viewer Native"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Drag and drop a PDF file here or click below to open."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <Button Content="Open PDF File..."
                                        Width="150"
                                        Height="36"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Command="{Binding OpenFileDialogCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Open Sample Demo"
                                        Width="150"
                                        Height="36"
                                        Background="{DynamicResource SurfaceAltBgBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        FontWeight="SemiBold"
                                        Command="{Binding OpenSampleDocumentCommand}" />
                            </StackPanel>

                            <!-- Recent Files Section -->
                            <TextBlock Text="Recently Opened:"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding RecentFiles.Count, Converter={StaticResource BoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding RecentFiles}"
                                          Visibility="{Binding RecentFiles.Count, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                                HorizontalContentAlignment="Left"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Padding="4,2"
                                                Margin="0,2"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Document Loaded Viewport -->
                <ScrollViewer x:Name="DocumentScrollViewer"
                              Visibility="{Binding IsDocumentLoaded, Converter={StaticResource BoolToVis}}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="True"
                              PreviewMouseWheel="DocumentScrollViewer_PreviewMouseWheel"
                              PreviewMouseDown="DocumentScrollViewer_PreviewMouseDown"
                              PreviewMouseMove="DocumentScrollViewer_PreviewMouseMove"
                              PreviewMouseUp="DocumentScrollViewer_PreviewMouseUp"
                              ScrollChanged="DocumentScrollViewer_ScrollChanged">

                    <Grid MinWidth="{Binding ViewportWidth, ElementName=DocumentScrollViewer}" HorizontalAlignment="Left" Margin="24">

                        <!-- Mode 1: Continuous Scrolling Mode -->
                        <ItemsControl x:Name="ContinuousPagesItemsControl"
                                      ItemsSource="{Binding Pages}"
                                      HorizontalAlignment="Stretch"
                                      Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Continuous}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                    <Border HorizontalAlignment="Center"
                                            Margin="0,0,0,20"
                                            Background="{DynamicResource PageBgBrush}"
                                            CornerRadius="2">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#20000000" BlurRadius="15" ShadowDepth="3" />
                                        </Border.Effect>

                                        <Grid Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}">
                                            <!-- 1. Loading indicator -->
                                            <ProgressBar IsIndeterminate="True"
                                                         Width="120"
                                                         Height="4"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                                            <!-- 2. Rendered Page Image -->
                                            <Image Source="{Binding RenderedImage}"
                                                   Stretch="Fill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />

                                            <!-- 3. Text Selection Layer (Translucent Accent / Blue) -->
                                            <ItemsControl ItemsSource="{Binding SelectedSegments}"
                                                          Width="{Binding DisplayWidth}"
                                                          Height="{Binding DisplayHeight}"
                                                          IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="X" />
                                                                    <Binding Path="DataContext.DisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Canvas.Top">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Y" />
                                                                    <Binding Path="DataContext.DisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Width">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Width" />
                                                                    <Binding Path="DataContext.DisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Height">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Height" />
                                                                    <Binding Path="DataContext.DisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:PageTextSegment}">
                                                        <Border Background="#440078D7"
                                                                BorderBrush="#880078D7"
                                                                BorderThickness="1"
                                                                CornerRadius="2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 4. Vector Search Highlights Layer (Lime-Green / Active Gold) -->
                                            <ItemsControl ItemsSource="{Binding MatchesOnPage}"
                                                          Width="{Binding DisplayWidth}"
                                                          Height="{Binding DisplayHeight}"
                                                          IsHitTestVisible="False">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="X" />
                                                                    <Binding Path="DataContext.DisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Canvas.Top">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Y" />
                                                                    <Binding Path="DataContext.DisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Width">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Width" />
                                                                    <Binding Path="DataContext.DisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Height">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Height" />
                                                                    <Binding Path="DataContext.DisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:SearchMatch}">
                                                        <Border Background="{Binding IsCurrentMatch, Converter={StaticResource SearchHighlightBgConverter}}"
                                                                BorderBrush="{Binding IsCurrentMatch, Converter={StaticResource SearchHighlightBorderConverter}}"
                                                                BorderThickness="1.5"
                                                                CornerRadius="2" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 5. Vector Annotations Layer -->
                                            <ItemsControl ItemsSource="{Binding AnnotationsOnPage}"
                                                          Width="{Binding DisplayWidth}"
                                                          Height="{Binding DisplayHeight}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <Canvas Width="{Binding DisplayWidth}" Height="{Binding DisplayHeight}" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemContainerStyle>
                                                    <Style TargetType="ContentPresenter">
                                                        <Setter Property="Canvas.Left">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="X" />
                                                                    <Binding Path="DataContext.DisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Canvas.Top">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Y" />
                                                                    <Binding Path="DataContext.DisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Width">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Width" />
                                                                    <Binding Path="DataContext.DisplayWidth" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter Property="Height">
                                                            <Setter.Value>
                                                                <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                                    <Binding Path="Height" />
                                                                    <Binding Path="DataContext.DisplayHeight" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                </MultiBinding>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ItemsControl.ItemContainerStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:AnnotationModel}">
                                                        <Grid ToolTip="{Binding Contents}"
                                                              Cursor="Hand"
                                                              Background="Transparent"
                                                              MouseLeftButtonDown="Annotation_MouseLeftButtonDown">
                                                            <!-- Highlight -->
                                                            <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    Opacity="{Binding Opacity}"
                                                                    CornerRadius="2"
                                                                    Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Highlight}" />

                                                            <!-- Underline -->
                                                            <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    BorderThickness="0,0,0,2"
                                                                    Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Underline}" />

                                                            <!-- StrikeOut -->
                                                            <Line X1="0" Y1="0.5" X2="1" Y2="0.5" Stretch="Fill"
                                                                  Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                  StrokeThickness="2"
                                                                  VerticalAlignment="Center"
                                                                  Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=StrikeOut}" />

                                                            <!-- Note -->
                                                            <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    CornerRadius="4"
                                                                    Padding="2"
                                                                    Width="24"
                                                                    Height="24"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Note}">
                                                                <Path Data="{StaticResource IconNote}" Fill="White" Width="14" Height="14" Stretch="Uniform" />
                                                            </Border>

                                                            <!-- FreeText -->
                                                            <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    BorderThickness="1"
                                                                    Background="#20FFFFFF"
                                                                    Padding="4"
                                                                    Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=FreeText}">
                                                                <TextBlock Text="{Binding Contents}"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           FontSize="11"
                                                                           TextWrapping="Wrap" />
                                                            </Border>

                                                            <!-- Rectangle Shape -->
                                                            <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                    BorderThickness="{Binding StrokeThickness}"
                                                                    Background="Transparent"
                                                                    Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Rectangle}" />

                                                            <!-- Ellipse Shape -->
                                                            <Ellipse Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                                     StrokeThickness="{Binding StrokeThickness}"
                                                                     Fill="Transparent"
                                                                     Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Ellipse}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 6. Interactive Canvas for Selection & Drawing Annotations -->
                                            <Canvas Width="{Binding DisplayWidth}"
                                                    Height="{Binding DisplayHeight}"
                                                    Background="Transparent"
                                                    Tag="{Binding}"
                                                    MouseDown="PageCanvas_MouseDown"
                                                    MouseMove="PageCanvas_MouseMove"
                                                    MouseUp="PageCanvas_MouseUp"
                                                    MouseLeave="PageCanvas_MouseLeave">
                                                <Canvas.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="_Copy Text" Command="{Binding DataContext.CopySelectedTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" InputGestureText="Ctrl+C" IsEnabled="{Binding DataContext.HasTextSelection, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <MenuItem.Icon>
                                                                <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="_Highlight Selection" Command="{Binding DataContext.HighlightSelectedTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.HasTextSelection, RelativeSource={RelativeSource AncestorType=Window}}">
                                                            <MenuItem.Icon>
                                                                <Path Data="{StaticResource IconHighlight}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="Select _All Text on Page" Command="{Binding DataContext.SelectAllTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" InputGestureText="Ctrl+A">
                                                            <MenuItem.Icon>
                                                                <Path Data="{StaticResource IconSelectAll}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="_Deselect All" Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" InputGestureText="Esc" IsEnabled="{Binding DataContext.HasTextSelection, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </ContextMenu>
                                                </Canvas.ContextMenu>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mode 2: Single Page View Mode -->
                        <Border Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=SinglePage}"
                                Background="{DynamicResource PageBgBrush}"
                                CornerRadius="2"
                                Width="{Binding SingleCurrentPage.DisplayWidth}"
                                Height="{Binding SingleCurrentPage.DisplayHeight}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#20000000" BlurRadius="15" ShadowDepth="3" />
                            </Border.Effect>

                            <Grid Width="{Binding SingleCurrentPage.DisplayWidth}" Height="{Binding SingleCurrentPage.DisplayHeight}">
                                <!-- Loading indicator -->
                                <ProgressBar IsIndeterminate="True"
                                             Width="120"
                                             Height="4"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding SingleCurrentPage.IsLoading, Converter={StaticResource BoolToVis}}" />

                                <!-- Rendered Page Image -->
                                <Image Source="{Binding SingleCurrentPage.RenderedImage}"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />

                                <!-- Text Selection Layer (Translucent Accent / Blue) -->
                                <ItemsControl ItemsSource="{Binding SingleCurrentPage.SelectedSegments}"
                                              Width="{Binding SingleCurrentPage.DisplayWidth}"
                                              Height="{Binding SingleCurrentPage.DisplayHeight}"
                                              IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding SingleCurrentPage.DisplayWidth}" Height="{Binding SingleCurrentPage.DisplayHeight}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="X" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Width">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Width" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Height">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Height" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:PageTextSegment}">
                                            <Border Background="#440078D7"
                                                    BorderBrush="#880078D7"
                                                    BorderThickness="1"
                                                    CornerRadius="2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Vector Search Highlights Layer -->
                                <ItemsControl ItemsSource="{Binding SingleCurrentPage.MatchesOnPage}"
                                              Width="{Binding SingleCurrentPage.DisplayWidth}"
                                              Height="{Binding SingleCurrentPage.DisplayHeight}"
                                              IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding SingleCurrentPage.DisplayWidth}" Height="{Binding SingleCurrentPage.DisplayHeight}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="X" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Width">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Width" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Height">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Height" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:SearchMatch}">
                                            <Border Background="{Binding IsCurrentMatch, Converter={StaticResource SearchHighlightBgConverter}}"
                                                    BorderBrush="{Binding IsCurrentMatch, Converter={StaticResource SearchHighlightBorderConverter}}"
                                                    BorderThickness="1.5"
                                                    CornerRadius="2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Vector Annotations Layer -->
                                <ItemsControl ItemsSource="{Binding SingleCurrentPage.AnnotationsOnPage}"
                                              Width="{Binding SingleCurrentPage.DisplayWidth}"
                                              Height="{Binding SingleCurrentPage.DisplayHeight}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding SingleCurrentPage.DisplayWidth}" Height="{Binding SingleCurrentPage.DisplayHeight}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="X" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Canvas.Top">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Y" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Width">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Width" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayWidth" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Height">
                                                <Setter.Value>
                                                    <MultiBinding Converter="{StaticResource NormalizedCoordConverter}">
                                                        <Binding Path="Height" />
                                                        <Binding Path="DataContext.SingleCurrentPage.DisplayHeight" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                    </MultiBinding>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:AnnotationModel}">
                                            <Grid ToolTip="{Binding Contents}"
                                                  Cursor="Hand"
                                                  Background="Transparent"
                                                  MouseLeftButtonDown="Annotation_MouseLeftButtonDown">
                                                <!-- Highlight -->
                                                <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                        Opacity="{Binding Opacity}"
                                                        CornerRadius="2"
                                                        Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Highlight}" />

                                                <!-- Underline -->
                                                <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderThickness="0,0,0,2"
                                                        Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Underline}" />

                                                <!-- StrikeOut -->
                                                <Line X1="0" Y1="0.5" X2="1" Y2="0.5" Stretch="Fill"
                                                      Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                      StrokeThickness="2"
                                                      VerticalAlignment="Center"
                                                      Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=StrikeOut}" />

                                                <!-- Note -->
                                                <Border Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                        CornerRadius="4"
                                                        Padding="2"
                                                        Width="24"
                                                        Height="24"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Note}">
                                                    <Path Data="{StaticResource IconNote}" Fill="White" Width="14" Height="14" Stretch="Uniform" />
                                                </Border>

                                                <!-- FreeText -->
                                                <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderThickness="1"
                                                        Background="#20FFFFFF"
                                                        Padding="4"
                                                        Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=FreeText}">
                                                    <TextBlock Text="{Binding Contents}"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap" />
                                                </Border>

                                                <!-- Rectangle Shape -->
                                                <Border BorderBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                        BorderThickness="{Binding StrokeThickness}"
                                                        Background="Transparent"
                                                        Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Rectangle}" />

                                                <!-- Ellipse Shape -->
                                                <Ellipse Stroke="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                         StrokeThickness="{Binding StrokeThickness}"
                                                         Fill="Transparent"
                                                         Visibility="{Binding Type, Converter={StaticResource EnumToVis}, ConverterParameter=Ellipse}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Interactive Canvas for Selection & Drawing Annotations -->
                                <Canvas Width="{Binding SingleCurrentPage.DisplayWidth}"
                                        Height="{Binding SingleCurrentPage.DisplayHeight}"
                                        Background="Transparent"
                                        Tag="{Binding SingleCurrentPage}"
                                        MouseDown="PageCanvas_MouseDown"
                                        MouseMove="PageCanvas_MouseMove"
                                        MouseUp="PageCanvas_MouseUp"
                                        MouseLeave="PageCanvas_MouseLeave">
                                    <Canvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="_Copy Text" Command="{Binding DataContext.CopySelectedTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" InputGestureText="Ctrl+C" IsEnabled="{Binding DataContext.HasTextSelection, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <MenuItem.Icon>
                                                    <Path Data="{StaticResource IconCopy}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="_Highlight Selection" Command="{Binding DataContext.HighlightSelectedTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" IsEnabled="{Binding DataContext.HasTextSelection, RelativeSource={RelativeSource AncestorType=Window}}">
                                                <MenuItem.Icon>
                                                    <Path Data="{StaticResource IconHighlight}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Select _All Text on Page" Command="{Binding DataContext.SelectAllTextCommand, RelativeSource={RelativeSource AncestorType=Window}}" InputGestureText="Ctrl+A">
                                                <MenuItem.Icon>
                                                    <Path Data="{StaticResource IconSelectAll}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="_Deselect All" Command="{Binding DataContext.ClearSelectionCommand, RelativeSource={RelativeSource AncestorType=Window}}" InputGestureText="Esc" IsEnabled="{Binding DataContext.HasTextSelection, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </ContextMenu>
                                    </Canvas.ContextMenu>
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 5. Bottom Status Bar -->
        <StatusBar Grid.Row="4"
                   Background="{DynamicResource ToolbarBgBrush}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageCount, StringFormat='Pages: {0}'}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding ZoomPercentageText, StringFormat='Zoom: {0}'}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding ApplicationVersion, StringFormat='v{0}'}" Margin="0,0,16,0" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" />
                    <Border Background="#10E8910B"
                            BorderBrush="#E8910B"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="6,1"
                            Margin="0,0,10,0"
                            Cursor="Hand"
                            MouseLeftButtonUp="UpdateBadge_Click"
                            ToolTip="Click to update"
                            Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding AvailableUpdateVersion, StringFormat='⬆ v{0} available'}"
                                   Foreground="#E8910B"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                    <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="3" Padding="6,1">
                        <TextBlock Text="{Binding Metadata.LicenseStatus, FallbackValue='Google PDFium'}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
