<Window x:Class="PdfViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PdfViewer.ViewModels"
        xmlns:models="clr-namespace:PdfViewer.Models"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/assets/app_icon.png"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding OpenFileDialogCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding PrintCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="F" Command="{Binding ToggleSearchCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D" Command="{Binding ShowPropertiesCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad0" Command="{Binding FitPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad1" Command="{Binding FitWidthCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="R" Command="{Binding RotateClockwiseCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="R" Command="{Binding RotateCounterClockwiseCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="B" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousPageCommand}" />
        <KeyBinding Key="Home" Command="{Binding FirstPageCommand}" />
        <KeyBinding Key="End" Command="{Binding LastPageCommand}" />
        <KeyBinding Key="F3" Command="{Binding NextSearchMatchCommand}" />
        <KeyBinding Modifiers="Shift" Key="F3" Command="{Binding PreviousSearchMatchCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Menu -->
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Search Bar -->
            <RowDefinition Height="*" />    <!-- Main Viewport + Sidebar -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Main Menu -->
        <Menu Grid.Row="0"
              Background="{DynamicResource ToolbarBgBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileDialogCommand}" InputGestureText="Ctrl+O" />
                <MenuItem Header="Open _Sample Demo Document" Command="{Binding OpenSampleDocumentCommand}" />
                <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Close Document" Command="{Binding CloseDocumentCommand}" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="_Export to Images..." Command="{Binding ExportImagesCommand}" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="_Print..." Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" IsEnabled="{Binding IsDocumentLoaded}" />
                <Separator />
                <MenuItem Header="Document _Properties..." Command="{Binding ShowPropertiesCommand}" InputGestureText="Ctrl+D" IsEnabled="{Binding IsDocumentLoaded}" />
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" InputGestureText="Alt+F4" />
            </MenuItem>

            <MenuItem Header="_View">
                <MenuItem Header="Continuous Scrolling" Command="{Binding ToggleViewModeCommand}" IsCheckable="True" IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=Continuous, Mode=OneWay}" />
                <MenuItem Header="Single Page View" Command="{Binding ToggleViewModeCommand}" IsCheckable="True" IsChecked="{Binding ViewMode, Converter={StaticResource EnumToBool}, ConverterParameter=SinglePage, Mode=OneWay}" />
                <Separator />
                <MenuItem Header="Zoom _In" Command="{Binding ZoomInCommand}" InputGestureText="Ctrl++" />
                <MenuItem Header="Zoom _Out" Command="{Binding ZoomOutCommand}" InputGestureText="Ctrl+-" />
                <MenuItem Header="Fit to _Width" Command="{Binding FitWidthCommand}" InputGestureText="Ctrl+1" />
                <MenuItem Header="Fit to _Page" Command="{Binding FitPageCommand}" InputGestureText="Ctrl+0" />
                <Separator />
                <MenuItem Header="Rotate _Clockwise" Command="{Binding RotateClockwiseCommand}" InputGestureText="Ctrl+R" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="Rotate Counter-Clockwise" Command="{Binding RotateCounterClockwiseCommand}" InputGestureText="Ctrl+Shift+R" IsEnabled="{Binding IsDocumentLoaded}" />
                <Separator />
                <MenuItem Header="Toggle _Sidebar" Command="{Binding ToggleSidebarCommand}" InputGestureText="Ctrl+B" IsCheckable="True" IsChecked="{Binding IsSidebarOpen}" />
                <MenuItem Header="Toggle Light / _Dark Theme" Command="{Binding ToggleThemeCommand}" />
            </MenuItem>

            <MenuItem Header="_Tools">
                <MenuItem Header="_Find Text..." Command="{Binding ToggleSearchCommand}" InputGestureText="Ctrl+F" IsEnabled="{Binding IsDocumentLoaded}" />
                <MenuItem Header="_Hand / Pan Tool" Command="{Binding TogglePanToolCommand}" IsCheckable="True" IsChecked="{Binding IsPanningEnabled}" IsEnabled="{Binding IsDocumentLoaded}" />
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Header="Aspose License &amp; _About..." Click="AboutMenuItem_Click" />
            </MenuItem>
        </Menu>

        <!-- 2. Main Ribbon Toolbar -->
        <Border Grid.Row="1"
                Background="{DynamicResource ToolbarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,4">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Open Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding OpenFileDialogCommand}"
                        ToolTip="Open PDF (Ctrl+O)">
                    <Path Data="{StaticResource IconOpen}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Print Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding PrintCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Print Document (Ctrl+P)">
                    <Path Data="{StaticResource IconPrint}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Export Images Button -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ExportImagesCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Export Pages to Images">
                    <Path Data="{StaticResource IconExport}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Sidebar Toggle -->
                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding IsSidebarOpen}"
                              ToolTip="Toggle Navigation Sidebar (Ctrl+B)">
                    <Path Data="{StaticResource IconSidebar}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Page Navigation Controls -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding FirstPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="First Page (Home)">
                    <TextBlock Text="|&#x25C0;" FontWeight="Bold" FontSize="11" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding PreviousPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Previous Page (PageUp)">
                    <Path Data="{StaticResource IconArrowLeft}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </Button>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <TextBox Width="42"
                             Height="26"
                             Text="{Binding CurrentPageNumber, UpdateSourceTrigger=LostFocus}"
                             TextAlignment="Center"
                             VerticalContentAlignment="Center"
                             IsEnabled="{Binding IsDocumentLoaded}"
                             KeyDown="PageInputBox_KeyDown" />
                    <TextBlock Text=" / " VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding PageCount}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,4,0" />
                </StackPanel>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Next Page (PageDown)">
                    <Path Data="{StaticResource IconArrowRight}" Fill="{DynamicResource TextPrimaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding LastPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Last Page (End)">
                    <TextBlock Text="&#x25B6;|" FontWeight="Bold" FontSize="11" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Zoom Controls -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ZoomOutCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Zoom Out (Ctrl+-)">
                    <Path Data="{StaticResource IconZoomOut}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Slider Width="90"
                        Minimum="0.25"
                        Maximum="3.0"
                        Value="{Binding ZoomLevel}"
                        SmallChange="0.1"
                        LargeChange="0.25"
                        VerticalAlignment="Center"
                        Margin="4,0"
                        IsEnabled="{Binding IsDocumentLoaded}" />

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ZoomInCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Zoom In (Ctrl++)">
                    <Path Data="{StaticResource IconZoomIn}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <TextBlock Text="{Binding ZoomPercentageText}"
                           Width="46"
                           TextAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Margin="2,0,6,0" />

                <!-- Fit Width / Fit Page -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding FitWidthCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Fit to Width (Ctrl+1)">
                    <Path Data="{StaticResource IconFitWidth}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding FitPageCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Fit to Page (Ctrl+0)">
                    <Path Data="{StaticResource IconFitPage}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Rotation -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding RotateCounterClockwiseCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Rotate Counter-Clockwise (Ctrl+Shift+R)">
                    <Path Data="{StaticResource IconRotateCCW}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding RotateClockwiseCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Rotate Clockwise (Ctrl+R)">
                    <Path Data="{StaticResource IconRotateCW}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- View Layout Mode & Pan Tool -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ToggleViewModeCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Toggle View Mode (Continuous / Single Page)">
                    <Path Data="{StaticResource IconViewMode}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding IsPanningEnabled}"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Hand / Pan Tool">
                    <Path Data="{StaticResource IconPan}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="6,2" />

                <!-- Search Toggle -->
                <ToggleButton Style="{StaticResource ToolbarToggleButton}"
                              IsChecked="{Binding IsSearchOpen}"
                              IsEnabled="{Binding IsDocumentLoaded}"
                              ToolTip="Find Text (Ctrl+F)">
                    <Path Data="{StaticResource IconSearch}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </ToggleButton>

                <!-- Theme Toggle -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="Toggle Light / Dark Mode">
                    <Path Data="{StaticResource IconTheme}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>

                <!-- Document Properties -->
                <Button Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ShowPropertiesCommand}"
                        IsEnabled="{Binding IsDocumentLoaded}"
                        ToolTip="Document Properties (Ctrl+D)">
                    <Path Data="{StaticResource IconProperties}" Fill="{DynamicResource TextPrimaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- 3. Collapsible In-Document Search Bar -->
        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceAltBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,6"
                Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Find:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0" />

                <TextBox Grid.Column="1"
                         x:Name="SearchInputBox"
                         Height="28"
                         Padding="6,4"
                         VerticalContentAlignment="Center"
                         Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="SearchInputBox_KeyDown" />

                <Button Grid.Column="2"
                        Content="Search"
                        Height="28"
                        Padding="12,0"
                        Margin="6,0,4,0"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"
                        Command="{Binding ExecuteSearchCommand}" />

                <CheckBox Grid.Column="3"
                          Content="Match Case"
                          IsChecked="{Binding SearchMatchCase}"
                          VerticalAlignment="Center"
                          Margin="8,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding PreviousSearchMatchCommand}"
                            ToolTip="Previous Match (Shift+F3)">
                        <Path Data="{StaticResource IconArrowUp}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource ToolbarIconButton}"
                            Command="{Binding NextSearchMatchCommand}"
                            ToolTip="Next Match (F3)">
                        <Path Data="{StaticResource IconArrowDown}" Fill="{DynamicResource TextPrimaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="5"
                           Text="{Binding SearchSummaryText}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="12,0" />

                <Button Grid.Column="6"
                        Style="{StaticResource ToolbarIconButton}"
                        Command="{Binding ToggleSearchCommand}"
                        ToolTip="Close Search">
                    <Path Data="{StaticResource IconClose}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <!-- 4. Main Viewport & Collapsible Sidebar -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <!-- Sidebar Column -->
                <ColumnDefinition Width="280"
                                  MinWidth="180"
                                  MaxWidth="450" />
                <!-- Splitter Column -->
                <ColumnDefinition Width="Auto" />
                <!-- Viewport Column -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Navigation Sidebar -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SidebarBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}">
                <TabControl SelectedIndex="{Binding SelectedSidebarTab}"
                            Background="Transparent"
                            BorderThickness="0">
                    <!-- Tab 1: Thumbnails -->
                    <TabItem Header="Pages" Style="{StaticResource SidebarTabItemStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8">
                            <ItemsControl ItemsSource="{Binding Thumbnails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ThumbnailViewModel}">
                                        <Border Margin="0,0,0,12"
                                                Background="{DynamicResource SurfaceBgBrush}"
                                                BorderThickness="2"
                                                CornerRadius="4"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="Thumbnail_Click">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCurrentPage}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>

                                            <StackPanel Margin="6">
                                                <Border Height="160"
                                                        Background="{DynamicResource BorderBrush}"
                                                        CornerRadius="2"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailImage}"
                                                           Stretch="Uniform"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           HorizontalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           FontSize="11"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Bookmarks / Outline Tree -->
                    <TabItem Header="Bookmarks" Style="{StaticResource SidebarTabItemStyle}">
                        <Grid>
                            <TextBlock Text="No bookmarks found in this document."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="16"
                                       Visibility="{Binding Bookmarks.Count, Converter={StaticResource InverseBoolToVis}}" />

                            <TreeView ItemsSource="{Binding Bookmarks}"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      Padding="6"
                                      SelectedItemChanged="BookmarkTree_SelectedItemChanged">
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}" DataType="{x:Type models:BookmarkItem}">
                                        <StackPanel Orientation="Horizontal" Margin="2">
                                            <TextBlock Text="{Binding Title}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TargetPageNumber, StringFormat=' (p. {0})'}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </Grid>
                    </TabItem>

                    <!-- Tab 3: Search Results -->
                    <TabItem Header="Search Results" Style="{StaticResource SidebarTabItemStyle}">
                        <Grid>
                            <TextBlock Text="Search results will appear here."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding SearchMatches.Count, Converter={StaticResource InverseBoolToVis}}" />

                            <ListBox ItemsSource="{Binding SearchMatches}"
                                     SelectedItem="{Binding CurrentSearchMatch}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="4"
                                     MouseDoubleClick="SearchMatch_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:SearchMatch}">
                                        <Border Padding="8,6"
                                                BorderThickness="0,0,0,1"
                                                BorderBrush="{DynamicResource BorderBrush}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding PageNumber, StringFormat='Page {0}'}"
                                                           FontWeight="Bold"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding ContextSnippet}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- Splitter between Sidebar and Viewport -->
            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}"
                          Visibility="{Binding IsSidebarOpen, Converter={StaticResource BoolToVis}}" />

            <!-- Document Viewport Area -->
            <Grid Grid.Column="2" Background="{DynamicResource DocumentViewportBgBrush}">

                <!-- Empty Document Welcome State -->
                <Grid Visibility="{Binding IsDocumentLoaded, Converter={StaticResource InverseBoolToVis}}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">
                    <Border Background="{DynamicResource SurfaceBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="36"
                            MaxWidth="500">
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="pack://application:,,,/assets/app_icon.png"
                                   Width="96"
                                   Height="96"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,16" />

                            <TextBlock Text="PDF Viewer Native"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />

                            <TextBlock Text="Drag and drop a PDF file here or click below to open."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0,0,0,20" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                                <Button Content="Open PDF File..."
                                        Width="150"
                                        Height="36"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        Command="{Binding OpenFileDialogCommand}"
                                        Margin="0,0,8,0" />
                                <Button Content="Open Sample Demo"
                                        Width="150"
                                        Height="36"
                                        Background="{DynamicResource SurfaceAltBgBrush}"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        FontWeight="SemiBold"
                                        Command="{Binding OpenSampleDocumentCommand}" />
                            </StackPanel>

                            <!-- Recent Files Section -->
                            <TextBlock Text="Recently Opened:"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding RecentFiles.Count, Converter={StaticResource BoolToVis}}" />

                            <ItemsControl ItemsSource="{Binding RecentFiles}"
                                          Visibility="{Binding RecentFiles.Count, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                                HorizontalContentAlignment="Left"
                                                Foreground="{DynamicResource AccentBrush}"
                                                Padding="4,2"
                                                Margin="0,2"
                                                Cursor="Hand"
                                                Command="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Document Loaded Viewport -->
                <ScrollViewer x:Name="DocumentScrollViewer"
                              Visibility="{Binding IsDocumentLoaded, Converter={StaticResource BoolToVis}}"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Focusable="True"
                              PreviewMouseWheel="DocumentScrollViewer_PreviewMouseWheel"
                              PreviewMouseDown="DocumentScrollViewer_PreviewMouseDown"
                              PreviewMouseMove="DocumentScrollViewer_PreviewMouseMove"
                              PreviewMouseUp="DocumentScrollViewer_PreviewMouseUp"
                              ScrollChanged="DocumentScrollViewer_ScrollChanged">

                    <Grid HorizontalAlignment="Center" Margin="24">

                        <!-- Mode 1: Continuous Scrolling Mode -->
                        <ItemsControl x:Name="ContinuousPagesItemsControl"
                                      ItemsSource="{Binding Pages}"
                                      Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=Continuous}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PageViewModel}">
                                    <Border Margin="0,0,0,20"
                                            Background="{DynamicResource PageBgBrush}"
                                            CornerRadius="2"
                                            Width="{Binding DisplayWidth}"
                                            Height="{Binding DisplayHeight}">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#20000000" BlurRadius="15" ShadowDepth="3" />
                                        </Border.Effect>

                                        <Grid>
                                            <!-- Loading indicator -->
                                            <ProgressBar IsIndeterminate="True"
                                                         Width="120"
                                                         Height="4"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                                            <!-- Rendered Page Image -->
                                            <Image Source="{Binding RenderedImage}"
                                                   Stretch="Fill"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Mode 2: Single Page View Mode -->
                        <Border Visibility="{Binding ViewMode, Converter={StaticResource EnumToVis}, ConverterParameter=SinglePage}"
                                Background="{DynamicResource PageBgBrush}"
                                CornerRadius="2"
                                Width="{Binding SingleCurrentPage.DisplayWidth}"
                                Height="{Binding SingleCurrentPage.DisplayHeight}"
                                VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect Color="#20000000" BlurRadius="15" ShadowDepth="3" />
                            </Border.Effect>

                            <Grid>
                                <ProgressBar IsIndeterminate="True"
                                             Width="120"
                                             Height="4"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Visibility="{Binding SingleCurrentPage.IsLoading, Converter={StaticResource BoolToVis}}" />

                                <Image Source="{Binding SingleCurrentPage.RenderedImage}"
                                       Stretch="Fill"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 5. Bottom Status Bar -->
        <StatusBar Grid.Row="4"
                   Background="{DynamicResource ToolbarBgBrush}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   BorderBrush="{DynamicResource BorderBrush}"
                   BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>

            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding PageCount, StringFormat='Pages: {0}'}" Margin="0,0,16,0" />
                    <TextBlock Text="{Binding ZoomPercentageText, StringFormat='Zoom: {0}'}" Margin="0,0,16,0" />
                    <Border Background="{DynamicResource AccentLightBrush}" CornerRadius="3" Padding="6,1">
                        <TextBlock Text="{Binding Metadata.LicenseStatus, FallbackValue='Aspose.Total'}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="11" />
                    </Border>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
