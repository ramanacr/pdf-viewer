<Window x:Class="PdfViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PdfViewer.ViewModels"
        xmlns:views="clr-namespace:PdfViewer.Views"
        xmlns:models="clr-namespace:PdfViewer.Models"
        xmlns:themes="clr-namespace:PdfViewer.Themes"
        mc:Ignorable="d"
        Title="PDF Viewer"
        Icon="pack://application:,,,/assets/app_icon.png"
        Height="800"
        Width="1200"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!--
        The window binds to the shell, which owns the open documents. Everything below the
        root Grid binds through the active one, so the entire document UI - menus, toolbar,
        viewport and status bar - keeps the bindings it had before tabs existed.
    -->
    <Window.DataContext>
        <vm:ShellViewModel />
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="O" Command="{Binding ActiveDocument.OpenFileDialogCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="P" Command="{Binding ActiveDocument.PrintCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding ActiveDocument.SaveCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="N" Command="{Binding ActiveDocument.ToggleNightModeCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="S" Command="{Binding ActiveDocument.SaveAnnotatedAsCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="C" Command="{Binding ActiveDocument.CopySelectedTextCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="A" Command="{Binding ActiveDocument.SelectAllTextCommand}" />
        <KeyBinding Key="Escape" Command="{Binding ActiveDocument.ClearSelectionCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="F" Command="{Binding ActiveDocument.ToggleSearchCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D" Command="{Binding ActiveDocument.ShowPropertiesCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="E" Command="{Binding ActiveDocument.ToggleContentEditingCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemPlus" Command="{Binding ActiveDocument.ZoomInCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Add" Command="{Binding ActiveDocument.ZoomInCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="OemMinus" Command="{Binding ActiveDocument.ZoomOutCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Subtract" Command="{Binding ActiveDocument.ZoomOutCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D0" Command="{Binding ActiveDocument.FitPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad0" Command="{Binding ActiveDocument.FitPageCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding ActiveDocument.FitWidthCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding ActiveDocument.ShowReadModeCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad4" Command="{Binding ActiveDocument.ShowReadModeCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="NumPad1" Command="{Binding ActiveDocument.FitWidthCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="R" Command="{Binding ActiveDocument.RotateClockwiseCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="R" Command="{Binding ActiveDocument.RotateCounterClockwiseCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="B" Command="{Binding ActiveDocument.ToggleSidebarCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding ActiveDocument.NextPageCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding ActiveDocument.PreviousPageCommand}" />
        <KeyBinding Key="Home" Command="{Binding ActiveDocument.FirstPageCommand}" />
        <KeyBinding Key="End" Command="{Binding ActiveDocument.LastPageCommand}" />
        <KeyBinding Key="F3" Command="{Binding ActiveDocument.NextSearchMatchCommand}" />
        <KeyBinding Modifiers="Shift" Key="F3" Command="{Binding ActiveDocument.PreviousSearchMatchCommand}" />

        <!-- Tabs. These reach the shell rather than a document. -->
        <KeyBinding Modifiers="Ctrl" Key="W" Command="{Binding CloseActiveDocumentCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="Tab" Command="{Binding NextDocumentCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift" Key="Tab" Command="{Binding PreviousDocumentCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="PageDown" Command="{Binding NextDocumentCommand}" />
        <KeyBinding Modifiers="Ctrl" Key="PageUp" Command="{Binding PreviousDocumentCommand}" />
    </Window.InputBindings>

    <Grid DataContext="{Binding ActiveDocument}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Menu -->
            <RowDefinition Height="Auto" /> <!-- Toolbar -->
            <RowDefinition Height="Auto" /> <!-- Search Bar -->
            <RowDefinition Height="Auto" /> <!-- Document Tabs -->
            <RowDefinition Height="*" />    <!-- Main Viewport + Sidebar -->
            <RowDefinition Height="Auto" /> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!--
            Document tabs. Bound to the shell rather than to the active document, so it reaches
            past this Grid's DataContext. Hidden until there is more than one document, since a
            single tab is a strip of chrome that tells the user nothing.
        -->
        <ItemsControl Grid.Row="3"
                      x:Name="DocumentTabStrip"
                      ItemsSource="{Binding DataContext.Documents, RelativeSource={RelativeSource AncestorType=Window}}"
                      Visibility="{Binding DataContext.ShowTabStrip, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                      Background="{DynamicResource SurfaceAltBgBrush}"
                      BorderBrush="{DynamicResource BorderBrush}"
                      Padding="4,3">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MainViewModel}">
                    <Border x:Name="TabBorder"
                            Margin="0,0,4,0"
                            Padding="10,5"
                            CornerRadius="4,4,0,0"
                            Background="Transparent"
                            Cursor="Hand"
                            MouseLeftButtonDown="DocumentTab_Click"
                            ToolTip="{Binding Metadata.FilePath}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TabTitle}"
                                       MaxWidth="180"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="{x:Static themes:IconGlyphs.Close}"
                                    FontFamily="{x:Static themes:IconGlyphs.IconFont}"
                                    FontSize="9"
                                    Margin="8,0,0,0"
                                    Padding="3"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    ToolTip="Close this document"
                                    Click="CloseDocumentTab_Click" />
                        </StackPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <MultiBinding Converter="{StaticResource SameInstanceConverter}">
                                    <Binding />
                                    <Binding Path="DataContext.ActiveDocument" RelativeSource="{RelativeSource AncestorType=Window}" />
                                </MultiBinding>
                            </DataTrigger.Binding>
                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceBgBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="TabBorder" Property="BorderThickness" Value="0,2,0,0" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 1. Main Menu -->
        <Menu x:Name="MainMenuBar"
              Grid.Row="0"
              Background="{DynamicResource ToolbarBgBrush}"
              Foreground="{DynamicResource TextPrimaryBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              Padding="4,2">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." Command="{Binding OpenFileDialogCommand}" InputGestureText="Ctrl+O"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Open}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="Open _Sample Demo Document" Command="{Binding OpenSampleDocumentCommand}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.OpenSample}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="Open _Recent" ItemsSource="{Binding RecentFiles}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Recent}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Foreground" Value="{DynamicResource MenuPopupTextBrush}" />
                            <Setter Property="Header" Value="{Binding}" />
                            <Setter Property="Command" Value="{Binding DataContext.OpenRecentFileCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="Create P_DF"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.CreatePdf}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                    <MenuItem Header="From _Images..." Command="{Binding CreatePdfFromImagesCommand}"
                              ToolTip="Makes a PDF from pictures (JPEG, PNG, TIFF, BMP, GIF and any other kind Windows can read), a page each. JPEGs keep their quality. Everything happens on this computer."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.CreateFromImages}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="From _Scanner..." Command="{Binding CreatePdfFromScannerCommand}"
                              ToolTip="Scans pages with Windows Image Acquisition, from the glass or the document feeder, into a new PDF, searchable if you like."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.CreateFromScanner}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="From _File..." Command="{Binding CreatePdfFromFileCommand}"
                              ToolTip="Converts a Word, Excel or PowerPoint file, a text, RTF or HTML file, or a picture to PDF on this computer (Office files need Microsoft Office). Choose it again while it runs to stop."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.CreateFromFile}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <Separator />
                    <MenuItem Header="_Combine Files..." Command="{Binding CombineFilesCommand}"
                              ToolTip="Puts PDFs, pictures and Office files together in one PDF, in the order you choose, with a bookmark for each file."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.CombineFiles}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="_Close Document"
                          Command="{Binding DataContext.CloseActiveDocumentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          InputGestureText="Ctrl+W"
                          IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.CloseDocument}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="_Save" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S"
                          ToolTip="Writes your annotations into this document, keeping them editable."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Save}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="Save _Annotated As..." Command="{Binding SaveAnnotatedAsCommand}" InputGestureText="Ctrl+Shift+S" IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.SaveAs}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="_Export to Images..." Command="{Binding ExportImagesCommand}" IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.ExportImages}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="Export _Text..." Command="{Binding ExportTextCommand}" IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Writes the document's text layer to a plain text file."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.ExportText}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="E_xport"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Export}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon><MenuItem Header="_Word Document (.docx)..." Command="{Binding ExportWordCommand}" IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Saves an editable Word document whose text flows, keeping the layout. Choose it again while it runs to stop."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.WordDocument}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Excel Workbook (.xlsx)..." Command="{Binding ExportExcelCommand}" IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Saves the tables as an Excel workbook, a sheet a table, with numbers and dates as values. Choose it again while it runs to stop."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.ExcelWorkbook}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_PowerPoint Presentation (.pptx)..." Command="{Binding ExportPowerPointCommand}" IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Saves a slide a page, with the text in editable text boxes where it is, and the pictures, shapes and tables. Choose it again while it runs to stop."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.PowerPointPresentation}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem></MenuItem>
                <MenuItem Header="_Organize Pages..." Command="{Binding OrganizePagesCommand}" IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Reorder, rotate or leave out pages and save the result as a new document."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.OrganizePages}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="Embedded _Files..." Command="{Binding ShowAttachmentsCommand}" IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Lists the files embedded in this document and extracts one if you ask. Nothing is ever run."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Attachments}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="_Print..." Command="{Binding PrintCommand}" InputGestureText="Ctrl+P" IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Print}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Header="Document _Properties..." Command="{Binding ShowPropertiesCommand}" InputGestureText="Ctrl+D" IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Properties}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click" InputGestureText="Alt+F4"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Exit}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
            </MenuItem>

            <MenuItem Header="_Edit">
                <MenuItem Header="{Binding UndoHeader}" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Undo}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="{Binding RedoHeader}" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Redo}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Header="_Copy Selected Text" Command="{Binding CopySelectedTextCommand}" InputGestureText="Ctrl+C" IsEnabled="{Binding HasTextSelection}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Copy}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="_Highlight Selection" Command="{Binding HighlightSelectedTextCommand}" IsEnabled="{Binding HasTextSelection}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Highlight}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Header="Select _All Text on Page" Command="{Binding SelectAllTextCommand}" InputGestureText="Ctrl+A" IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.SelectAll}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="_Deselect All" Command="{Binding ClearSelectionCommand}" InputGestureText="Esc" IsEnabled="{Binding HasTextSelection}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Deselect}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <Separator />
                <MenuItem Header="_Redact" IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Redact}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                    <MenuItem Header="Mark Selected _Text" Command="{Binding MarkSelectionForRedactionCommand}" IsEnabled="{Binding HasTextSelection}"
                              ToolTip="Marks the selected text for redaction."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.SelectText}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Mark an _Area" Command="{Binding BeginMarkRedactionAreaCommand}"
                              ToolTip="Drag over any part of a page (text, pictures, drawings) to mark it."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.MarkArea}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Mark All _Search Results" Command="{Binding MarkSearchResultsForRedactionCommand}"
                              ToolTip="Marks every match of the current search, on every page."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Find}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <Separator />
                    <MenuItem Header="_Apply Redactions..." Command="{Binding ApplyRedactionsCommand}"
                              ToolTip="Removes everything under the marks in a new copy. The original is not changed."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.ApplyRedactions}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Clear Marks" Command="{Binding ClearRedactionMarksCommand}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.ClearMarks}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <Separator />
                    <MenuItem Header="_Redact Selected Text Now..." Command="{Binding RedactSelectionCommand}" IsEnabled="{Binding HasTextSelection}"
                              ToolTip="Marks the selected text and applies it straight away."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.RedactNow}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                </MenuItem>
                <Separator />
                <MenuItem Header="Edit _Text &amp; Images" Command="{Binding ToggleContentEditingCommand}" IsCheckable="True" IsChecked="{Binding IsEditingContent, Mode=OneWay}"
                          IsEnabled="{Binding IsDocumentLoaded}" InputGestureText="Ctrl+E"
                          ToolTip="Select a paragraph or image on the page: double-click text to change it, drag to move, drag an image's corner to resize, Delete to remove."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.EditContent}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="Add Te_xt" Command="{Binding BeginAddTextCommand}" IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Click on the page where the new text should start."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.AddText}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="Add _Image..." Command="{Binding AddImageCommand}" IsEnabled="{Binding IsDocumentLoaded}"
                          ToolTip="Places a picture in the middle of the current page; drag it where it belongs."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.AddImage}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                <MenuItem Header="Page _Marks" IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.PageMarks}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                    <MenuItem Header="_Header &amp; Footer..." Command="{Binding ShowHeaderFooterCommand}" ToolTip="Adds, updates or removes page numbers, dates and text at the top and bottom of the pages."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.HeaderFooter}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Watermark..." Command="{Binding ShowWatermarkCommand}" ToolTip="Adds, updates or removes text, a picture or a PDF page across the pages."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Watermark}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Background..." Command="{Binding ShowBackgroundCommand}" ToolTip="Adds, updates or removes a colour, picture or PDF page behind the pages."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Background}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="Bates _Numbering..." Command="{Binding ShowBatesNumberingCommand}" ToolTip="Adds, updates or removes sequence numbers for legal documents."><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.BatesNumbering}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Comment">
                <MenuItem Header="_Draw" IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Shape}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                    <MenuItem Header="_Rectangle" Command="{Binding ToggleAnnotationToolCommand}" CommandParameter="Rectangle" IsCheckable="True" IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Rectangle, Mode=OneWay}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Shape}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Ellipse" Command="{Binding ToggleAnnotationToolCommand}" CommandParameter="Ellipse" IsCheckable="True" IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Ellipse, Mode=OneWay}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Shape}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Line" Command="{Binding ToggleAnnotationToolCommand}" CommandParameter="Line" IsCheckable="True" IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Line, Mode=OneWay}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Line}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Arrow" Command="{Binding ToggleAnnotationToolCommand}" CommandParameter="Arrow" IsCheckable="True" IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Arrow, Mode=OneWay}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Arrow}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Polygon" Command="{Binding ToggleAnnotationToolCommand}" CommandParameter="Polygon" IsCheckable="True" IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=Polygon, Mode=OneWay}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Polygon}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    <MenuItem Header="_Connected Lines" Command="{Binding ToggleAnnotationToolCommand}" CommandParameter="PolyLine" IsCheckable="True" IsChecked="{Binding ActiveAnnotationTool, Converter={StaticResource EnumToBool}, ConverterParameter=PolyLine, Mode=OneWay}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.PolyLine}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                </MenuItem>
                <MenuItem Header="_Stamp" IsEnabled="{Binding IsDocumentLoaded}"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                    <MenuItem Header="_Dynamic (name, date and time)"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                        <MenuItem Header="_Approved" Command="{Binding ChooseStampCommand}" CommandParameter="D:Approved"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="_Confidential" Command="{Binding ChooseStampCommand}" CommandParameter="D:Confidential"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="_Received" Command="{Binding ChooseStampCommand}" CommandParameter="D:Received"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Re_viewed" Command="{Binding ChooseStampCommand}" CommandParameter="D:SBReviewed"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Rev_ised" Command="{Binding ChooseStampCommand}" CommandParameter="D:SBRevised"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                    </MenuItem>
                    <MenuItem Header="Standard _Business"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon>
                        <MenuItem Header="_Approved" Command="{Binding ChooseStampCommand}" CommandParameter="S:Approved"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="_Completed" Command="{Binding ChooseStampCommand}" CommandParameter="S:SBCompleted"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Con_fidential" Command="{Binding ChooseStampCommand}" CommandParameter="S:Confidential"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="_Draft" Command="{Binding ChooseStampCommand}" CommandParameter="S:Draft"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="F_inal" Command="{Binding ChooseStampCommand}" CommandParameter="S:Final"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="For Co_mment" Command="{Binding ChooseStampCommand}" CommandParameter="S:ForComment"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="For _Public Release" Command="{Binding ChooseStampCommand}" CommandParameter="S:ForPublicRelease"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Information _Only" Command="{Binding ChooseStampCommand}" CommandParameter="S:SBInformationOnly"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="_Not Approved" Command="{Binding ChooseStampCommand}" CommandParameter="S:NotApproved"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Not For Public Release" Command="{Binding ChooseStampCommand}" CommandParameter="S:NotForPublicRelease"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Pre_liminary Results" Command="{Binding ChooseStampCommand}" CommandParameter="S:SBPreliminaryResults"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="_Received" Command="{Binding ChooseStampCommand}" CommandParameter="S:Received"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Revi_ewed" Command="{Binding ChooseStampCommand}" CommandParameter="S:SBReviewed"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="Revised" Command="{Binding ChooseStampCommand}" CommandParameter="S:SBRevised"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="_Void" Command="{Binding ChooseStampCommand}" CommandParameter="S:SBVoid"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
                        <MenuItem Header="E_xpired" Command="{Binding ChooseStampCommand}" CommandParameter="S:Expired"><MenuItem.Icon><TextBlock Text="{x:Static themes:IconGlyphs.Stamp}" Style="{StaticResource MenuGlyph}" /></MenuItem.Icon></MenuItem>
