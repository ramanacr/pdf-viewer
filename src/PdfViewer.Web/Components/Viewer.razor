@using PdfViewer.Web.Engine
@using PdfViewer.Web.Engine.Annotations
@using PdfViewer.Web.Engine.Embed

<div class="app @(_sidebarOpen && _doc != null && _config.HasSidePanel ? "with-sidebar" : "") @(Embedded ? "embedded" : "")">
    <header class="toolbar@(_searchOpen ? " search-open" : "")" role="toolbar" aria-label="Viewer controls">
        <div class="group">
            @if (_config.HasSidePanel)
            {
                <button type="button" class="icon-button" title="Side panel (O)" aria-label="Show or hide the side panel"
                        aria-pressed="@(_sidebarOpen ? "true" : "false")" disabled="@(_doc == null)" @onclick="ToggleSidebar">
                    <Icon Name="sidebar" />
                </button>
            }
            @if (!Embedded)
            {
                <span class="brand" title="PDF Viewer Native, web demo">PDF Viewer <span class="brand-tag">web demo</span></span>
            }
            else if (_doc != null && _config.Mode == EmbedMode.FullWindow)
            {
                <span class="brand file-title" title="@_fileName">@_fileName</span>
            }
        </div>

        @if (!Embedded)
        {
            <div class="group">
                <button type="button" class="button" title="Open a PDF file (Ctrl+O)" @onclick="PickFile"><Icon Name="open" /><span class="label">Open</span></button>
                <button type="button" class="button quiet tour-button" title="Open the built-in engine tour" @onclick="OpenSampleAsync"><Icon Name="sample" /><span class="label">Tour</span></button>
            </div>
        }

        @if (_doc != null)
        {
            <div class="group" role="group" aria-label="Pages">
                @if (CanGoBackByLink)
                {
                    <button type="button" class="icon-button link-back" title="Back to where the link was followed from (Alt+Left)" aria-label="Back" @onclick="GoBackByLink"><Icon Name="left" /></button>
                }
                <button type="button" class="icon-button page-step" title="Previous page (Left arrow)" aria-label="Previous page" disabled="@(_currentPage <= 1)" @onclick="() => GoToPage(_currentPage - 1)"><Icon Name="up" /></button>
                <label class="page-box">
                    <span class="visually-hidden">Page number</span>
                    <input id="page-input" type="text" inputmode="numeric" value="@_currentPage" size="3" aria-describedby="page-count"
                           @onchange="OnPageInput" @onfocus="SelectPageInput" />
                    <span id="page-count" class="muted">of @_doc.PageCount</span>
                </label>
                <button type="button" class="icon-button page-step" title="Next page (Right arrow)" aria-label="Next page" disabled="@(_currentPage >= _doc.PageCount)" @onclick="() => GoToPage(_currentPage + 1)"><Icon Name="down" /></button>
            </div>

            @if (_config.ShowZoomControl)
            {
                <div class="group" role="group" aria-label="Zoom">
                    <button type="button" class="icon-button zoom-step" title="Zoom out (Ctrl+minus)" aria-label="Zoom out" @onclick="ZoomOut"><Icon Name="minus" /></button>
                    <label>
                        <span class="visually-hidden">Zoom</span>
                        <select class="zoom-select" @onchange="OnZoomSelect" aria-label="Zoom level">
                            <option value="fit-width" selected="@(_zoomMode == ZoomMode.FitWidth)">Fit width</option>
                            @if (!IsInline)
                            {
                                <option value="fit-page" selected="@(_zoomMode == ZoomMode.FitPage)">Fit page</option>
                            }
                            @foreach (var preset in ZoomPresets)
                            {
                                <option value="@preset" selected="@(_zoomMode == ZoomMode.Custom && Math.Abs(_zoom - preset) < 0.001)">@Percent(preset)</option>
                            }
                            @if (_zoomMode != ZoomMode.Custom || !ZoomPresets.Any(p => Math.Abs(_zoom - p) < 0.001))
                            {
                                <option value="current" selected="@(_zoomMode == ZoomMode.Custom)" disabled>@Percent(_zoom)</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="icon-button zoom-step" title="Zoom in (Ctrl+plus)" aria-label="Zoom in" @onclick="ZoomIn"><Icon Name="plus" /></button>
                </div>
            }

            <form class="group search" role="search" @onsubmit="SearchOrNextAsync" @onsubmit:preventDefault>
                @* Phones (app.css): the search is behind a button in the toolbar; this closes it again. *@
                <button type="button" class="icon-button phone-only" id="search-close" aria-label="Close the search" title="Close the search (Esc)" @onclick="CloseSearchAsync"><Icon Name="close" /></button>
                <label class="search-box">
                    <Icon Name="search" />
                    <span class="visually-hidden">Find in document</span>
                    <input id="search-input" type="search" placeholder="Find in document" autocomplete="off" spellcheck="false"
                           @bind="_query" @bind:event="oninput" @onkeydown="OnSearchKey" aria-describedby="search-status" />
                </label>
                <span id="search-status" class="muted search-count" aria-live="polite">@SearchStatus</span>
                <button type="button" class="icon-button" title="Previous match (Shift+F3)" aria-label="Previous match" disabled="@(_hits.Count == 0)" @onclick="() => StepHit(-1)"><Icon Name="up" /></button>
                <button type="button" class="icon-button" title="Next match (F3 or Enter)" aria-label="Next match" disabled="@(_hits.Count == 0)" @onclick="() => StepHit(1)"><Icon Name="down" /></button>
                <label class="check" title="Match case"><input type="checkbox" @bind="_matchCase" @bind:after="RestartSearchAsync" /> <span>Aa</span><span class="visually-hidden">Match case</span></label>
            </form>
        }

        <div class="group end">
            @if (ShowsSaveButton)
            {
                <button type="button" class="button@(IsDirty ? " primary" : "")" title="Save (Ctrl+S)" disabled="@(Saving || !IsDirty)" @onclick="SaveFromButton">
                    <Icon Name="save" /><span class="label">@(Saving ? "Saving…" : "Save")</span>
                </button>
            }
            @if (_doc != null && _config.ShowDownload)
            {
                <button type="button" class="icon-button" title="Download the PDF" aria-label="Download the PDF" @onclick="Download"><Icon Name="download" /></button>
            }
            @if (_doc != null && _config.ShowPrint)
            {
                <button type="button" class="icon-button" title="@(_doc.CanPrint ? "Print" : "This document does not allow printing")" aria-label="Print"
                        disabled="@(_printing || !_doc.CanPrint)" @onclick="PrintAsync"><Icon Name="print" /></button>
            }
            @if (Embedded && _config.Mode == EmbedMode.SizedContainer && _config.ShowFullScreen && _canFullscreen)
            {
                <button type="button" class="icon-button" title="Full screen" aria-label="Full screen" @onclick="ToggleFullscreen"><Icon Name="fullscreen" /></button>
            }
            <button type="button" class="icon-button" title="Night pages: invert page colours (I)" aria-label="Night pages" aria-pressed="@(_night ? "true" : "false")" @onclick="ToggleNight"><Icon Name="invert" /></button>
            @if (!Embedded)
            {
                <button type="button" class="icon-button" title="@($"Theme: {_theme} (D)")" aria-label="@($"Colour theme: {_theme}")" @onclick="CycleTheme"><Icon Name="@ThemeIcon" /></button>
                <button type="button" class="icon-button" title="Keyboard shortcuts and about (?)" aria-label="Help and about" @onclick="() => _dialog = Dialog.Help"><Icon Name="help" /></button>
            }
        </div>

        @* Phones only (app.css): one toolbar row. Search opens into the row; the end group's commands are in the "More" menu. *@
        <div class="group phone-only phone-actions">
            @if (_doc != null)
            {
                <button type="button" class="icon-button" id="search-toggle" title="Find in document" aria-label="Find in document"
                        aria-expanded="@(_searchOpen ? "true" : "false")" @onclick="OpenSearch"><Icon Name="search" /></button>
            }
            <button type="button" class="icon-button" id="more-button" title="More" aria-label="More commands" aria-haspopup="menu"
                    aria-expanded="@(_moreOpen ? "true" : "false")" aria-controls="@(_moreOpen ? "more-menu" : null)" @onclick="ToggleMoreMenu"><Icon Name="more" /></button>
        </div>
        @if (_moreOpen)
        {
            <div class="menu-backdrop" aria-hidden="true" @onclick="() => CloseMoreMenu()"></div>
            <div class="more-menu" id="more-menu" role="menu" aria-label="More commands" @onkeydown="OnMoreMenuKey">
                @if (!Embedded)
                {
                    <button type="button" role="menuitem" class="menu-item" @onclick="async () => { CloseMoreMenu(); await OpenSampleAsync(); }"><Icon Name="sample" /> Open the engine tour</button>
                }
                @if (ShowsSaveButton)
                {
                    <button type="button" role="menuitem" class="menu-item" disabled="@(Saving || !IsDirty)" @onclick="async () => { CloseMoreMenu(); await SaveFromButton(); }"><Icon Name="save" /> @(Saving ? "Saving…" : "Save")</button>
                }
                @if (_doc != null && _config.ShowDownload)
                {
                    <button type="button" role="menuitem" class="menu-item" @onclick="async () => { CloseMoreMenu(); await Download(); }"><Icon Name="download" /> Download the PDF</button>
                }
                @if (_doc != null && _config.ShowPrint)
                {
                    <button type="button" role="menuitem" class="menu-item" disabled="@(_printing || !_doc.CanPrint)" @onclick="async () => { CloseMoreMenu(); await PrintAsync(); }"><Icon Name="print" /> Print</button>
                }
                @if (Embedded && _config.Mode == EmbedMode.SizedContainer && _config.ShowFullScreen && _canFullscreen)
                {
                    <button type="button" role="menuitem" class="menu-item" @onclick="() => { CloseMoreMenu(); ToggleFullscreen(); }"><Icon Name="fullscreen" /> Full screen</button>
                }
                <button type="button" role="menuitemcheckbox" class="menu-item" aria-checked="@(_night ? "true" : "false")" @onclick="() => { CloseMoreMenu(); ToggleNight(); }"><Icon Name="invert" /> Night pages</button>
                @if (!Embedded)
                {
                    <button type="button" role="menuitem" class="menu-item" @onclick="() => { CloseMoreMenu(); CycleTheme(); }"><Icon Name="@ThemeIcon" /> @($"Theme: {_theme}")</button>
                    <button type="button" role="menuitem" class="menu-item" @onclick="() => { CloseMoreMenu(focusButton: false); _dialog = Dialog.Help; }"><Icon Name="help" /> Help and about</button>
                }
            </div>
        }
    </header>

    @if (_doc != null && ShowsAnnotationToolbar)
    {
        <div class="annot-toolbar" role="toolbar" aria-label="Comment and markup tools">
            <div class="group" role="group" aria-label="Tools">
                @foreach (var (tool, icon, label) in ToolButtons)
                {
                    var t = tool;
                    <button type="button" class="icon-button" title="@label" aria-label="@label" aria-pressed="@(_tool == t || t == Tool.Stamp && _tool == Tool.CustomStamp ? "true" : "false")" @onclick="() => SetTool(t)"><Icon Name="@icon" /></button>
                }
                @if (_tool is Tool.Stamp or Tool.CustomStamp)
                {
                    <select aria-label="Stamp" value="@StampValue" @onchange="PickStampAsync">
                        @foreach (var stamp in PdfEngine.Vector.Annotations.PdfStamps.Standard)
                        {
                            <option value="@stamp.Name">@stamp.Label</option>
                        }
                        @if (_savedStamps.Count > 0)
                        {
                            <optgroup label="Saved stamps">
                                @foreach (var saved in _savedStamps)
                                {
                                    <option value="@($"C:{saved.Id}")">@saved.Name</option>
                                }
                            </optgroup>
                        }
                        @if (StampValue == CurrentStampOption)
                        {
                            <option value="@CurrentStampOption">@_customStampName</option>
                        }
                        <option value="@CustomStampOption">Custom stamp…</option>
                    </select>
                }
            </div>
            <div class="group swatches" role="group" aria-label="Colour">
                @foreach (var colour in Palette)
                {
                    var c = colour;
                    <button type="button" class="swatch" style="background:@c" title="@($"Colour {c}")" aria-label="@($"Colour {c}")"
                            aria-pressed="@(string.Equals(CurrentColor, c, StringComparison.OrdinalIgnoreCase) ? "true" : "false")" @onclick="() => PickColor(c)"></button>
                }
            </div>
            @if (CurrentShapeStyle is { } style)
            {
                var fill = FillValue(style.Fill);
                var dash = DashValue(style.Dash);
                <div class="group shape-style" role="group" aria-label="Shape style">
                    <select aria-label="Fill" title="Fill" value="@fill" @onchange="PickFill">
                        <option value="none">No fill</option>
                        @foreach (var (value, label) in PaletteNames)
                        {
                            <option value="@value">@($"{label} fill")</option>
                        }
                        @if (fill == "current")
                        {
                            <option value="current">Current fill</option>
                        }
                    </select>
                    <select aria-label="Line style" title="Line style" value="@dash" @onchange="PickDash">
                        <option value="solid">Solid</option>
                        <option value="dashed">Dashed</option>
                        <option value="dotted">Dotted</option>
                        @if (dash == "current")
                        {
                            <option value="current">Current dash</option>
                        }
                    </select>
                    @if (CurrentHasEndings)
                    {
                        <select aria-label="Line start" title="Line start" value="@style.Start" @onchange="e => PickEnding(true, e)">
                            @foreach (var (name, label) in EndingNames)
                            {
                                <option value="@name">@($"Start: {label}")</option>
                            }
                        </select>
                        <select aria-label="Line end" title="Line end" value="@style.End" @onchange="e => PickEnding(false, e)">
                            @foreach (var (name, label) in EndingNames)
                            {
                                <option value="@name">@($"End: {label}")</option>
                            }
                        </select>
                    }
                </div>
            }
            <div class="group" role="group" aria-label="Edit">
                <button type="button" class="icon-button" title="Undo (Ctrl+Z)" aria-label="Undo" disabled="@(_session?.CanUndo != true)" @onclick="Undo"><Icon Name="undo" /></button>
                <button type="button" class="icon-button" title="Redo (Ctrl+Y)" aria-label="Redo" disabled="@(_session?.CanRedo != true)" @onclick="Redo"><Icon Name="redo" /></button>
                @if (Selected is { } sel)
                {
                    @if (sel.Kind is ViewerAnnotationKind.Note or ViewerAnnotationKind.FreeText or ViewerAnnotationKind.Reply)
                    {
                        <button type="button" class="icon-button" title="Edit the text" aria-label="Edit the text" @onclick="() => StartEditing(sel, isNew: false)"><Icon Name="text" /></button>
                    }
                    <button type="button" class="icon-button" title="Delete the annotation (Delete)" aria-label="Delete the annotation" @onclick="DeleteSelected"><Icon Name="trash" /></button>
                }
            </div>
        </div>
    }

    @if (!Embedded)
    {
        <p class="privacy-bar"><Icon Name="shield" /> Everything runs in this browser tab. Files you open are never uploaded. No analytics, no cookies, no tracking.</p>
    }

    @if (_error != null)
    {
        <div class="banner error" role="alert">
            <Icon Name="info" />
            <p>@_error</p>
            <button type="button" class="icon-button" aria-label="Dismiss" @onclick="() => _error = null"><Icon Name="close" /></button>
        </div>
    }
    @if (_notice != null && _error == null)
    {
        <div class="banner notice" role="status">
            <Icon Name="@(_noticeIsFonts ? "font" : "info")" />
            <p>@_notice</p>
            @if (_canUseLocalFonts && !_localFontsLoaded && _noticeIsFonts)
            {
                <button type="button" class="button" @onclick="UseLocalFontsAsync">Use this device's fonts</button>
            }
            <button type="button" class="icon-button" aria-label="Dismiss" @onclick="DismissNotice"><Icon Name="close" /></button>
        </div>
    }
    @if (_restBackoff.GaveUp && _doc is { IsComplete: false } && _error == null)
    {
        <div class="banner notice" role="status">
            <Icon Name="info" />
            <p>The rest of the file could not be read. Pages already read still show.</p>
            <button type="button" class="button" @onclick="RetryLoadRestAsync">Try again</button>
        </div>
    }

    <div class="body">
        @if (_doc != null && _sidebarOpen && _config.HasSidePanel)
        {
            <aside class="sidebar" aria-label="Side panel">
                <div class="tabs" role="tablist">
                    @if (_config.ShowBookmarks)
                    {
                        <button type="button" role="tab" id="tab-outline" aria-selected="@(_panel == Panel.Outline ? "true" : "false")" aria-controls="panel-outline" @onclick="() => _panel = Panel.Outline">Outline</button>
                    }
                    @if (_config.ShowThumbnails)
                    {
                        <button type="button" role="tab" id="tab-thumbnails" aria-selected="@(_panel == Panel.Thumbnails ? "true" : "false")" aria-controls="panel-thumbnails" @onclick="ShowThumbnails">Pages</button>
                    }
                    <button type="button" role="tab" id="tab-results" aria-selected="@(_panel == Panel.Results ? "true" : "false")" aria-controls="panel-results" @onclick="() => _panel = Panel.Results">Results @(_hits.Count > 0 ? $"({_hits.Count})" : "")</button>
                    @if (ShowsCommentsPanel)
                    {
                        <button type="button" role="tab" id="tab-comments" aria-selected="@(_panel == Panel.Comments ? "true" : "false")" aria-controls="panel-comments" @onclick="() => _panel = Panel.Comments">Comments @(CommentCount > 0 ? $"({CommentCount})" : "")</button>
                    }
                </div>
                @if (_panel == Panel.Comments && ShowsCommentsPanel)
                {
                    var comments = _session!.List();
                    <div id="panel-comments" role="tabpanel" aria-labelledby="tab-comments" class="panel">
                        @if (comments.Count == 0)
                        {
                            <p class="muted empty">@(CanEditAnnotations && _config.HasAnnotationTools ? "No comments yet. Use the tools above the pages to add one." : "This document has no comments.")</p>
                        }
                        else
                        {
                            <ol class="results comments">
                                @foreach (var item in comments.Take(2000))
                                {
                                    var a = item.Annotation;
                                    int level = item.Level;
                                    <li style="@(level > 0 ? $"margin-left:{Math.Min(level, 6) * 14}px;border-left:2px solid var(--border)" : null)">
                                        <button type="button" class="result@(a.Id == _selectedId ? " current" : "")" aria-current="@(a.Id == _selectedId ? "true" : null)" @onclick="() => SelectFromPanel(a)">
                                            <span class="result-page"><span class="dot" style="background:@a.Color"></span>@item.Label@(level == 0 ? $", page {a.Page}" : "")@(a.Author.Length > 0 ? $", {a.Author}" : "")@(item.Status != null ? $", {item.Status}" : "")</span>
                                            @if (a.Contents.Length > 0)
                                            {
                                                <span class="result-text">@(a.Contents.Length > 200 ? a.Contents[..200] + "…" : a.Contents)</span>
                                            }
                                        </button>
                                        @if (a.Id == _selectedId && CanEditAnnotations && level == 0)
                                        {
                                            <div class="reply-form">
                                                <select aria-label="Review status" title="Review status" value="@(item.Status ?? "None")" @onchange="e => SetReviewState(a, e)">
                                                    @foreach (var state in ViewerEditSession.ReviewStates)
                                                    {
                                                        <option value="@state">@(state == "None" ? "No status" : state)</option>
                                                    }
                                                </select>
                                            </div>
                                        }
                                        @if (a.Id == _selectedId && CanEditAnnotations)
                                        {
                                            @if (_replyTo == a.Id)
                                            {
                                                <div class="reply-form">
                                                    <textarea rows="2" aria-label="Reply" placeholder="Write a reply" maxlength="@ViewerAnnotationStore.MaxContentsLength" @bind="_replyText" @bind:event="oninput"></textarea>
                                                    <button type="button" class="button primary" disabled="@(_replyText.Trim().Length == 0)" @onclick="SendReply">Reply</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="reply-form"><button type="button" class="button" @onclick="() => StartReply(a)">Reply</button></div>
                                            }
                                        }
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                }
                else if (_panel == Panel.Thumbnails && _config.ShowThumbnails)
                {
                    <div id="panel-thumbnails" role="tabpanel" aria-labelledby="tab-thumbnails" class="panel">
                        <ol class="thumbs">
                            @foreach (var pv in _doc.Pages)
                            {
                                var (tw, th) = ThumbSize(pv);
                                int number = pv.Number;
                                <li>
                                    <button type="button" class="thumb@(number == _currentPage ? " current" : "")" id="thumb-@number" data-thumb="@number"
                                            aria-label="@($"Page {number}")" aria-current="@(number == _currentPage ? "page" : null)" @onclick="() => GoToPageFromPanel(number)">
                                        <span class="thumb-page" style="width:@Px(tw);height:@Px(th)"><canvas></canvas></span>
                                        <span class="thumb-number">@number</span>
                                    </button>
                                </li>
                            }
                        </ol>
                    </div>
                }
                else if (_panel == Panel.Outline && _config.ShowBookmarks)
                {
                    <div id="panel-outline" role="tabpanel" aria-labelledby="tab-outline" class="panel">
                        @if (_outline.Count == 0)
                        {
                            <p class="muted empty">This document has no outline.</p>
                        }
                        else
                        {
                            <OutlineTree Items="_outline" CurrentPage="_currentPage" OnSelect="p => GoToPageFromPanel(p)" />
                        }
                    </div>
                }
                else
                {
                    <div id="panel-results" role="tabpanel" aria-labelledby="tab-results" class="panel">
                        @if (_hits.Count == 0)
                        {
                            <p class="muted empty">@(string.IsNullOrWhiteSpace(_searchedFor) ? "Search with the box above (Ctrl+F)." : _searching ? "Searching…" : "No matches.")</p>
                        }
                        else
                        {
                            <ol class="results">
                                @for (int i = 0; i < _hits.Count; i++)
                                {
                                    int index = i;
                                    var hit = _hits[i];
                                    <li>
                                        <button type="button" class="result@(index == _currentHit ? " current" : "")" aria-current="@(index == _currentHit ? "true" : null)" @onclick="() => { SelectHit(index); CloseDrawer(); }">
                                            <span class="result-page">Page @hit.Page</span>
                                            <span class="result-text">@hit.Before<mark>@hit.Match</mark>@hit.After</span>
                                        </button>
                                    </li>
                                }
                            </ol>
                        }
                    </div>
                }
            </aside>
            @* Phones only (app.css): the side panel is a drawer over the pages; a tap beside it closes it. *@
            <div class="sidebar-backdrop" aria-hidden="true" @onclick="ToggleSidebar"></div>
        }

        <main id="pages" class="@PagesClass" tabindex="-1" aria-label="@(_doc == null ? "Start" : "Document pages")">
            @if (_doc == null && Embedded)
            {
                <section class="embed-wait">
                    @if (_error == null)
                    {
                        <p class="loading" role="status"><span class="spinner" aria-hidden="true"></span> @(_loading ? _loadingText : "Waiting for the document…")</p>
                    }
                </section>
            }
            else if (_doc == null)
            {
                <section class="welcome" aria-labelledby="welcome-title">
                    <h1 id="welcome-title">Open a PDF. It stays on your device.</h1>
                    <p class="lead">This is the PDF engine of <a href="https://github.com/ramanacr/pdf-viewer" rel="noopener">PDF Viewer Native</a>, compiled to WebAssembly and running in this tab: parsing, rendering with Skia, and text search.</p>
                    <div class="welcome-actions">
                        <button type="button" class="button primary large" @onclick="PickFile"><Icon Name="open" /> Open a PDF file</button>
                        <button type="button" class="button large" @onclick="OpenSampleAsync"><Icon Name="sample" /> Open the engine tour</button>
                    </div>
                    <p class="muted">or drop a PDF anywhere on this page</p>
                    @if (_loading)
                    {
                        <p class="loading" role="status"><span class="spinner" aria-hidden="true"></span> @_loadingText</p>
                    }
                    <div class="facts">
                        <div>
                            <h2>Private by construction</h2>
                            <p>This site is static files only: there is no server code to send a file to. Your PDF is read into this tab's memory and forgotten when you close it. There are no analytics, cookies or trackers. The theme you pick is kept in this browser's local storage.</p>
                        </div>
                        <div>
                            <h2>The real engine</h2>
                            <p>The same C# engine as the Windows viewer, PdfEngine.Vector, with its portable Skia renderer. Document JavaScript is never run.</p>
                        </div>
                        <div>
                            <h2>Limits of the demo</h2>
                            <p>A browser has no installed fonts. Text in fonts a PDF does not embed is drawn with the bundled Liberation fonts (metric-compatible with Arial and Helvetica, Times and Courier), fetched only when a page needs them. Symbol, Dingbats and other scripts need your device's fonts, which Chrome and Edge can lend this page if you allow it. Certificate-encrypted PDFs and CMYK JPEG images are not supported here yet. <a href="https://github.com/ramanacr/pdf-viewer/tree/main/src/PdfViewer.Web#limits" rel="noopener">Details</a>.</p>
                        </div>
                    </div>
                </section>
            }
            else
            {
                @foreach (var pv in _doc.Pages)
                {
                    var (w, h) = CssSize(pv);
                    <div class="page" id="page-@pv.Number" data-page="@pv.Number" style="width:@Px(w);height:@Px(h)"
                         role="group" aria-label="@($"Page {pv.Number} of {_doc.PageCount}")">
                        <canvas role="img" aria-label="@($"Page {pv.Number} of {_doc.PageCount}")"></canvas>
                        @if (LinksActive && _linksByPage.TryGetValue(pv.Number, out var pageLinks))
                        {
                            @for (int li = 0; li < pageLinks.Count; li++)
                            {
                                var link = pageLinks[li];
                                bool first = true;
                                @foreach (var r in link.Areas)
                                {
                                    <span class="link-hit" role="link" data-link="@li" tabindex="@(first ? "0" : "-1")" aria-hidden="@(first ? null : "true")"
                                          title="@link.Description" aria-label="@LinkLabel(link)"
                                          style="left:@Pct(r.X / pv.Width);top:@Pct(r.Y / pv.Height);width:@Pct(Math.Max(r.Width, 2) / pv.Width);height:@Pct(Math.Max(r.Height, 2) / pv.Height)"></span>
                                    first = false;
                                }
                            }
                        }
                        @if (_selection?.Page == pv.Number)
                        {
                            @foreach (var r in _selectionBands)
                            {
                                <span class="sel" aria-hidden="true"
                                      style="left:@Pct(r.X / pv.Width);top:@Pct(r.Y / pv.Height);width:@Pct(r.Width / pv.Width);height:@Pct(r.Height / pv.Height)"></span>
                            }
                        }
                        @if (AnnotationsClickable)
                        {
                            @foreach (var a in AnnotationsByPage[pv.Number].Where(a => a.Kind != ViewerAnnotationKind.Reply))
                            {
                                var r = _doc.Geometry[pv.Number - 1].ToShown(a.Box);
                                <span class="annot-hit@(a.Id == _selectedId ? " selected" : "")" data-annot="@a.Id" title="@(a.Contents.Length > 0 ? a.Contents : ViewerEditSession.Label(a))"
                                      style="left:@Pct(r.X / pv.Width);top:@Pct(r.Y / pv.Height);width:@Pct(Math.Max(r.Width, 4) / pv.Width);height:@Pct(Math.Max(r.Height, 4) / pv.Height)"></span>
                            }
                            @if (CanEditAnnotations && Selected is { IsCallout: true } callout && callout.Page == pv.Number)
                            {
                                // The selected callout's anchor: drag it to move the spot the callout points to.
                                var ap = _doc.Geometry[pv.Number - 1].ToShown(callout.Callout[0], callout.Callout[1]);
                                <span class="callout-anchor" data-anchor="@callout.Id" role="img" aria-label="The spot the callout points to"
                                      title="Drag to move the spot the callout points to" style="left:@Pct(ap.X / pv.Width);top:@Pct(ap.Y / pv.Height)"></span>
                            }
                            @if (CanEditAnnotations && Selected is { } shape && shape.Page == pv.Number && ViewerEditSession.HasVertexHandles(shape))
                            {
                                // The selected line's, polygon's or polyline's points: drag one to move only that point.
                                var sg = _doc.Geometry[pv.Number - 1];
                                bool closed = shape.Kind == ViewerAnnotationKind.Polygon;
                                @for (int vi = 0; vi < shape.Vertices.Count / 2; vi++)
                                {
                                    var vp = sg.ToShown(shape.Vertices[2 * vi], shape.Vertices[2 * vi + 1]);
                                    <span class="vertex-handle" data-vertex="@shape.Id" data-index="@vi" data-closed="@(closed ? "true" : null)"
                                          data-x="@Frac(vp.X / pv.Width)" data-y="@Frac(vp.Y / pv.Height)" role="img"
                                          aria-label="@($"Point {vi + 1} of {shape.Vertices.Count / 2}")" title="Drag to move this point"
                                          style="left:@Pct(vp.X / pv.Width);top:@Pct(vp.Y / pv.Height)"></span>
                                }
                            }
                        }
                        else if (Selected is { } shown && shown.Page == pv.Number)
                        {
                            var r = _doc.Geometry[pv.Number - 1].ToShown(shown.Box);
                            <span class="annot-hit selected passive" aria-hidden="true"
                                  style="left:@Pct(r.X / pv.Width);top:@Pct(r.Y / pv.Height);width:@Pct(Math.Max(r.Width, 4) / pv.Width);height:@Pct(Math.Max(r.Height, 4) / pv.Height)"></span>
                        }
                        @if (CanFillForms)
                        {
                            @foreach (var field in _formWidgetsByPage[pv.Number].Where(w => !w.ReadOnly))
                            {
                                var f = field;
                                var fr = f.Rect;
                                string place = $"left:{Pct(fr.X / pv.Width)};top:{Pct(fr.Y / pv.Height)};width:{Pct(fr.Width / pv.Width)};height:{Pct(fr.Height / pv.Height)};font-size:{FieldFontSize(f)}";
                                @switch (f.Kind)
                                {
                                    case ViewerFormKind.Text when f.Multiline:
                                        <textarea class="form-field" style="@place" aria-label="@FieldLabel(f)" maxlength="@(f.MaxLength > 0 ? f.MaxLength : ViewerEditSession.MaxFieldValueLength)" spellcheck="false" value="@f.Value" @onchange="e => OnFieldChange(f, e)"></textarea>
                                        break;
                                    case ViewerFormKind.Text:
                                        <input class="form-field" style="@place" type="@(f.Password ? "password" : "text")" aria-label="@FieldLabel(f)" value="@f.Value" autocomplete="off" spellcheck="false"
                                               maxlength="@(f.MaxLength > 0 ? f.MaxLength : ViewerEditSession.MaxFieldValueLength)" @onchange="e => OnFieldChange(f, e)" />
                                        break;
                                    case ViewerFormKind.CheckBox or ViewerFormKind.Radio:
                                        <button type="button" class="form-field toggle" style="@place" role="@(f.Kind == ViewerFormKind.Radio ? "radio" : "checkbox")"
                                                aria-checked="@(f.IsOn ? "true" : "false")" aria-label="@(f.Kind == ViewerFormKind.Radio ? $"{FieldLabel(f)} {f.OnState}" : FieldLabel(f))" @onclick="() => ToggleField(f)"></button>
                                        break;
                                    case ViewerFormKind.ComboBox or ViewerFormKind.ListBox:
                                        <select class="form-field choice" style="@place" aria-label="@FieldLabel(f)" multiple="@(f.Kind == ViewerFormKind.ListBox && f.MultiSelect)"
                                                size="@(f.Kind == ViewerFormKind.ListBox ? Math.Max(2, f.Options.Count) : 1)" @onchange="e => OnFieldChange(f, e)">
                                            @if (f.Kind == ViewerFormKind.ComboBox && !f.Options.Any(o => o.Export == f.Value))
                                            {
                                                <option value="" selected>@f.Value</option>
                                            }
                                            @foreach (var (export, display) in f.Options)
                                            {
                                                <option value="@export" selected="@(f.Values.Contains(export))">@display</option>
                                            }
                                        </select>
                                        break;
                                }
                            }
                        }
                        @if (_editingId != null && Selected is { } editing && editing.Page == pv.Number)
                        {
                            var er = _doc.Geometry[pv.Number - 1].ToShown(editing.Box);
                            // The editor is 240 x 150 CSS pixels: kept inside the page at any zoom.
                            double ew = 256 / (_zoom * CssPerPoint), eh = 160 / (_zoom * CssPerPoint);
                            <div class="annot-editor" style="left:@Pct(Math.Max(0, Math.Min(er.X, pv.Width - ew)) / pv.Width);top:@Pct(Math.Max(0, Math.Min(er.Y + er.Height, pv.Height - eh)) / pv.Height)"
                                 role="dialog" aria-label="@(editing.Kind == ViewerAnnotationKind.Note ? "Note text" : "Text box text")">
                                <textarea id="annot-editor-text" rows="4" maxlength="@ViewerAnnotationStore.MaxContentsLength" placeholder="@(editing.Kind == ViewerAnnotationKind.Note ? "Write a comment" : "Type the text")"
                                          @bind="_editText" @bind:event="oninput"></textarea>
                                <div class="annot-editor-actions">
                                    <button type="button" class="button" @onclick="CancelEditing">Cancel</button>
                                    <button type="button" class="button primary" @onclick="CommitEditing">Done</button>
                                </div>
                            </div>
                        }
                        @if (_hitsByPage.TryGetValue(pv.Number, out var pageHits))
                        {
                            @foreach (var (hit, index) in pageHits)
                            {
                                @foreach (var r in hit.Rects)
                                {
                                    <span class="hit@(index == _currentHit ? " current" : "")" aria-hidden="true"
                                          style="left:@Pct(r.X / pv.Width);top:@Pct(r.Y / pv.Height);width:@Pct(r.Width / pv.Width);height:@Pct(r.Height / pv.Height)"></span>
                                }
                            }
                        }
                    </div>
                }
            }
        </main>
    </div>

    @if (!Embedded)
    {
        <footer class="statusbar">
            <span class="status-file" title="@_fileName">@(_doc == null ? "No document" : _fileName)</span>
            <span aria-live="polite" class="status-main">@_status</span>
            <span class="status-perf" title="Last page render: interpreting the page into a display list, then drawing it with Skia">@_perf</span>
        </footer>

        <div class="drop-overlay" aria-hidden="true"><div><Icon Name="open" /> Drop the PDF to open it here</div></div>
        <input id="file-input" type="file" accept="application/pdf,.pdf" hidden />
    }
    else
    {
        <p class="visually-hidden" aria-live="polite">@_status</p>
    }

    @if (_dialog == Dialog.Help)
    {
        <div class="dialog-backdrop" @onclick="() => _dialog = Dialog.None"></div>
        <div class="dialog" role="dialog" aria-modal="true" aria-labelledby="help-title">
            <header>
                <h2 id="help-title">Keyboard shortcuts</h2>
                <button type="button" class="icon-button" aria-label="Close" @onclick="() => _dialog = Dialog.None" id="dialog-close"><Icon Name="close" /></button>
            </header>
            <table class="shortcuts">
                <tbody>
                    <tr><td><kbd>Ctrl</kbd> <kbd>O</kbd></td><td>Open a PDF file</td></tr>
                    <tr><td><kbd>Ctrl</kbd> <kbd>F</kbd></td><td>Find in document</td></tr>
                    <tr><td><kbd>Enter</kbd>, <kbd>F3</kbd> / <kbd>Shift</kbd> <kbd>F3</kbd></td><td>Next / previous match</td></tr>
                    <tr><td><kbd>&rarr;</kbd> <kbd>&larr;</kbd>, <kbd>J</kbd> <kbd>K</kbd></td><td>Next / previous page</td></tr>
                    <tr><td><kbd>Home</kbd> <kbd>End</kbd></td><td>First / last page</td></tr>
                    <tr><td>Click, <kbd>Tab</kbd> <kbd>Enter</kbd></td><td>Follow a link on a page</td></tr>
                    <tr><td><kbd>Alt</kbd> <kbd>&larr;</kbd></td><td>Back to where you followed a link from</td></tr>
                    <tr><td><kbd>Ctrl</kbd> <kbd>+</kbd> / <kbd>Ctrl</kbd> <kbd>-</kbd></td><td>Zoom in / out</td></tr>
                    <tr><td><kbd>Ctrl</kbd> <kbd>0</kbd> / <kbd>Ctrl</kbd> <kbd>9</kbd></td><td>Fit width / fit page</td></tr>
                    <tr><td>Drag, double click</td><td>Select text on a page, a word</td></tr>
                    <tr><td><kbd>Ctrl</kbd> <kbd>A</kbd> / <kbd>Ctrl</kbd> <kbd>C</kbd></td><td>Select the text of the page / copy the selection</td></tr>
                    <tr><td><kbd>O</kbd></td><td>Show or hide the side panel</td></tr>
                    <tr><td><kbd>D</kbd></td><td>Colour theme: system, light, dark</td></tr>
                    <tr><td><kbd>I</kbd></td><td>Night pages (inverted page colours)</td></tr>
                    <tr><td><kbd>Ctrl</kbd> <kbd>Z</kbd> / <kbd>Ctrl</kbd> <kbd>Y</kbd></td><td>Undo / redo an annotation change</td></tr>
                    <tr><td><kbd>Delete</kbd></td><td>Delete the selected annotation</td></tr>
                    <tr><td><kbd>Ctrl</kbd> <kbd>S</kbd></td><td>Save the PDF with its annotations and form data</td></tr>
                    <tr><td><kbd>Esc</kbd></td><td>Close this dialog, clear the selection or the search</td></tr>
                </tbody>
            </table>
            <h2>About this demo</h2>
            <p>PDF Viewer Native's engine, running as .NET WebAssembly in this tab. Open source under the MIT License: <a href="https://github.com/ramanacr/pdf-viewer" rel="noopener">github.com/ramanacr/pdf-viewer</a>.</p>
            <p class="muted">@_engineInfo</p>
            <h2>Fonts</h2>
            <p>For text in fonts that a PDF does not embed, this demo uses its own copies of these fonts, under the SIL Open Font License 1.1. Each file comes from this site only, when a page needs it. Licence texts: <a href="https://github.com/ramanacr/pdf-viewer/blob/main/THIRD_PARTY_NOTICES.md" rel="noopener">THIRD_PARTY_NOTICES.md</a>.</p>
            <ul class="font-notices">
                @foreach (var (family, licence) in FontNotices)
                {
                    <li>@family: <a href="@licence" target="_blank" rel="noopener">licence</a></li>
                }
            </ul>
            <h2>Cryptography in this runtime</h2>
            <table class="shortcuts">
                <tbody>
                    @foreach (var primitive in PlatformCrypto.Primitives)
                    {
                        <tr>
                            <td>@primitive.Name</td>
                            <td>@(primitive.Available ? "provided by the runtime" : primitive.EngineFallback ? $"missing here ({primitive.Failure}); the engine uses its own" : $"missing ({primitive.Failure})"): <span class="muted">@primitive.UsedFor</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="muted">@(PlatformCrypto.CanDecrypt ? "Password-protected PDFs open here. Certificate-encrypted ones need RSA and the certificate store, which a browser does not have." : "Encrypted PDFs cannot be opened here.")</p>
        </div>
    }

    @if (_dialog == Dialog.Link && _linkUri != null)
    {
        <div class="dialog-backdrop" @onclick="CancelPendingLink"></div>
        <div class="dialog" role="alertdialog" aria-modal="true" aria-labelledby="link-title" aria-describedby="link-site">
            <header><h2 id="link-title">@(_linkUri.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase) ? "Write an email?" : "Open this link in your browser?")</h2></header>
            <p id="link-site">@(_linkUri.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase) ? "To" : "Site"): <strong>@_linkHost</strong></p>
            <p class="link-url">@_linkUri</p>
            <p class="muted">The link comes from the document. Open it only if you trust where it goes.</p>
            <div class="dialog-actions">
                <button type="button" class="button" id="link-cancel" @onclick="CancelPendingLink">Cancel</button>
                <button type="button" class="button primary" @onclick="OpenPendingLink">Open link</button>
            </div>
        </div>
    }

    @if (_dialog == Dialog.CustomStamp)
    {
        <div class="dialog-backdrop" @onclick="CloseCustomStampDialogAsync"></div>
        <div class="dialog stamp-dialog" role="dialog" aria-modal="true" aria-labelledby="stamp-title">
            <header>
                <h2 id="stamp-title">Custom stamp</h2>
                <button type="button" class="icon-button" aria-label="Close" @onclick="CloseCustomStampDialogAsync"><Icon Name="close" /></button>
            </header>
            <p class="muted">Make a stamp from a PNG or JPEG picture, or from a page of a PDF. The file is read in this browser; nothing is uploaded.</p>
            <p><button type="button" class="button" id="stamp-pick" disabled="@_stampBusy" @onclick="PickStampFile">Choose a picture or PDF…</button></p>
            @if (_pickedKind != null && _pickedPdf != null)
            {
                <p><strong>@_pickedName</strong></p>
                @if (_pickedKind == PdfViewer.Web.Engine.Annotations.ViewerCustomStampKind.Page && _pickedPdf.PageCount > 1)
                {
                    <div class="stamp-page" role="group" aria-label="Page of the PDF">
                        <button type="button" class="icon-button" aria-label="Previous page" disabled="@(_pickedPage <= 1)" @onclick="() => StepPickedPage(-1)"><Icon Name="left" /></button>
                        <label>Page <input type="number" min="1" max="@_pickedPdf.PageCount" value="@_pickedPage" @onchange="OnPickedPageInput" /></label>
                        <span>of @_pickedPdf.PageCount</span>
                        <button type="button" class="icon-button" aria-label="Next page" disabled="@(_pickedPage >= _pickedPdf.PageCount)" @onclick="() => StepPickedPage(1)"><Icon Name="right" /></button>
                    </div>
                }
                <canvas id="stamp-preview" class="stamp-preview" role="img" aria-label="Preview of the stamp"></canvas>
                @if (CanKeepStamps && _stampLibrary)
                {
                    <label class="check"><input type="checkbox" @bind="_saveStamp" /> Keep it in this browser's stamp library</label>
                }
            }
            @if (_stampProblem != null)
            {
                <p class="problem" role="alert">@_stampProblem</p>
            }
            @if (_savedStamps.Count > 0)
            {
                <h3>Saved in this browser</h3>
                <ul class="saved-stamps">
                    @foreach (var saved in _savedStamps)
                    {
                        var s = saved;
                        <li>
                            <button type="button" class="link-button" @onclick="() => UseSavedStampAsync(s.Id)">@s.Name</button>
                            <span class="muted">@(s.Kind == "Page" ? "PDF page" : "Picture"), @(Math.Max(1, s.Size / 1024)) KB</span>
                            <button type="button" class="icon-button" aria-label="@($"Delete the saved stamp {s.Name}")" title="Delete" @onclick="() => DeleteSavedStampAsync(s)"><Icon Name="trash" /></button>
                        </li>
                    }
                </ul>
            }
            <div class="dialog-actions">
                <button type="button" class="button" @onclick="CloseCustomStampDialogAsync">Cancel</button>
                <button type="button" class="button primary" disabled="@(_pickedKind == null || _stampBusy)" @onclick="UsePickedStampAsync">Place stamp</button>
            </div>
        </div>
    }
    <input id="stamp-input" type="file" accept="image/png,image/jpeg,application/pdf,.png,.jpg,.jpeg,.pdf" hidden />

    @if (_dialog == Dialog.Password)
    {
        <div class="dialog-backdrop"></div>
        <form class="dialog" role="dialog" aria-modal="true" aria-labelledby="password-title" @onsubmit="SubmitPasswordAsync" @onsubmit:preventDefault>
            <header><h2 id="password-title">Password required</h2></header>
            <p>@_passwordPrompt</p>
            <label class="field">Password <input id="password-input" type="password" autocomplete="off" @bind="_password" /></label>
            <div class="dialog-actions">
                <button type="button" class="button" @onclick="CancelPassword">Cancel</button>
                <button type="submit" class="button primary">Open</button>
            </div>
        </form>
    }
</div>
