<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Portable on purpose: the web (Blazor WebAssembly) and Android viewers are to reuse this backend. -->
    <!-- net10.0 (LTS) too when the .NET 10 SDK builds it, as the package build does (see Directory.Build.targets). -->
    <TargetFrameworks>net9.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals($(NETCoreSdkVersion), 10.0))">net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfEngine.Vector.Skia</RootNamespace>
    <AssemblyName>PdfEngine.Vector.Skia</AssemblyName>
    <Description>Portable Skia (CPU raster) renderer for the PdfEngine.Vector display list: renders PDF pages to BGRA pixels on any platform that SkiaSharp supports.</Description>
    <IsPackable>true</IsPackable>
    <!-- XML documentation for the package only (dotnet pack sets _IsPacking): the app's payload carries no .xml files. -->
    <GenerateDocumentationFile Condition="'$(_IsPacking)' == 'true'">true</GenerateDocumentationFile>
    <PackageId>PdfEngine.Vector.Skia</PackageId>
    <PackageTags>pdf;pdf-renderer;skia;skiasharp;pdf-engine</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEngine.Abstractions\PdfEngine.Abstractions.csproj" />
    <ProjectReference Include="..\PdfEngine.Vector\PdfEngine.Vector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      MIT-licensed SkiaSharp; pinned. Each host brings the native library for its platform (the
      tests reference SkiaSharp.NativeAssets.Win32 at the same version).
    -->
    <PackageReference Include="SkiaSharp" Version="3.116.1" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfEngine.Vector.Skia.Tests" />
  </ItemGroup>

</Project>
