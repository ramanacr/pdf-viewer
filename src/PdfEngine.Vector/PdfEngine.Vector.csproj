<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PdfEngine.Vector</RootNamespace>
    <AssemblyName>PdfEngine.Vector</AssemblyName>
    <Description>Native vector-first PDF core parsing, document model, and content stream interpreter.</Description>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfEngine.Abstractions\PdfEngine.Abstractions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Predefined CJK CMaps (Adobe cmap-resources, BSD-3-Clause); built by eng/vectorpdf/cmaps/build-cmaps.ps1. -->
    <EmbeddedResource Include="Fonts\CMaps\PredefinedCMaps.zip" LogicalName="PdfEngine.Vector.PredefinedCMaps.zip" />
    <None Include="Fonts\CMaps\LICENSE-cmap-resources.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PdfEngine.Vector.Tests" />
    <InternalsVisibleTo Include="PdfViewer.Tests" />
    <!-- The developer tool times the phases of native text extraction (vectorpdf textbench). -->
    <InternalsVisibleTo Include="vectorpdf" />
    <!-- The Skia backend shapes text drawn with a substitute font (Arabic joining, Indic reordering) with the editing shaper. -->
    <InternalsVisibleTo Include="PdfEngine.Vector.Skia" />
    <!-- The Direct2D and WPF backends shape substitute text with the same engine code (Text/SubstituteShaper). -->
    <InternalsVisibleTo Include="PdfEngine.Vector.Direct2D" />
    <InternalsVisibleTo Include="PdfEngine.Vector.Windows" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CoreJ2K" Version="2.4.1.108" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>

</Project>
