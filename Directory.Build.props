<Project>
  <PropertyGroup>
    <Company>PDF Viewer Native</Company>
    <Product>PDF Viewer Native Desktop</Product>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <!--
    Derive the assembly version from the nearest git release tag (e.g. "v1.2.2" -> 1.2.2),
    NOT from the total commit count. The self-update check (UpdateService.CompareVersions)
    compares this assembly version directly against GitHub release tag names, and a
    commit-count-based build number grows every commit while a tag's patch digit only
    grows once per release, so the two schemes must match or update checks silently
    stop detecting genuinely newer releases as newer.
  -->
  <Target Name="AutoSetGitVersion" BeforeTargets="BeforeBuild;BeforeCompile;GetAssemblyVersion;GenerateNuspec;CoreCompile">
    <Exec Command="git describe --tags --abbrev=0" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitLatestTag" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" IgnoreExitCode="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
    </Exec>
    <PropertyGroup>
      <!--
        Exec with IgnoreExitCode captures whatever the command printed, so when git is not
        on PATH (clean CI container, build from a source archive) ConsoleOutput is the shell's
        error text - e.g. "'git' is not recognized...". Feeding that straight into Version
        fails the whole build with CS7034/MC1005, so validate the shape before trusting it
        and fall back to a a well-formed placeholder instead.
      -->
      <GitLatestTag Condition="'$(GitLatestTag)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch($(GitLatestTag), '^[vV]?[0-9]+(\.[0-9]+){0,2}$'))"></GitLatestTag>
      <GitLatestTag Condition="'$(GitLatestTag)' == ''">v0.0.0</GitLatestTag>
      <GitCommitHash Condition="'$(GitCommitHash)' != '' And !$([System.Text.RegularExpressions.Regex]::IsMatch($(GitCommitHash), '^[0-9a-fA-F]{7,40}$'))"></GitCommitHash>

      <GitReleaseVersion Condition="$(GitLatestTag.StartsWith('v')) Or $(GitLatestTag.StartsWith('V'))">$(GitLatestTag.Substring(1))</GitReleaseVersion>
      <GitReleaseVersion Condition="'$(GitReleaseVersion)' == ''">$(GitLatestTag)</GitReleaseVersion>
      <Version>$(GitReleaseVersion)</Version>
      <AssemblyVersion>$(GitReleaseVersion).0</AssemblyVersion>
      <FileVersion>$(GitReleaseVersion).0</FileVersion>
      <InformationalVersion Condition="'$(GitCommitHash)' != ''">$(GitReleaseVersion)+$(GitCommitHash)</InformationalVersion>
      <InformationalVersion Condition="'$(GitCommitHash)' == ''">$(GitReleaseVersion)</InformationalVersion>
    </PropertyGroup>
  </Target>
</Project>
