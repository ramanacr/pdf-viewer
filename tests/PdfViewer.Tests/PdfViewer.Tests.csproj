<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match PdfViewer's TFM, which is raised to reach the Windows OCR runtime. -->
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!--
    Two configurations, like the application's. The default (PdfiumRenderer=true) runs every
    test, the PDFium oracle tests included. With -p:PdfiumRenderer=false the suite is built
    against the published app, which has no PDFium: PdfEngine.Pdfium is not referenced, and the
    test files that need it are left out by name below (each listed, so leaving one out is a
    reviewed decision, not a silent pass). PdfiumFreeConfigurationTests checks that this list
    and the build agree. The differential tests run in both: without PDFium they compare with what
    PDFium gave, committed in PdfiumGoldens\ (scripts/update_pdfium_goldens.ps1 regenerates it).
    Single PDFium-only tests (PDFium mode, the adapter) are behind #if PDFIUM_RENDERER.
  -->
  <PropertyGroup>
    <PdfiumRenderer Condition="'$(PdfiumRenderer)' == ''">true</PdfiumRenderer>
    <DefineConstants Condition="'$(PdfiumRenderer)' == 'true'">$(DefineConstants);PDFIUM_RENDERER</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(PdfiumRenderer)' == 'true'">
    <ProjectReference Include="..\..\src\PdfEngine.Pdfium\PdfEngine.Pdfium.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(PdfiumRenderer)' != 'true'">
    <!-- Test files that are only meaningful with PDFium (they test its adapter): developer and test builds only. Each says why in Reason. -->
    <PdfiumOnlyTest Include="PdfiumFormRenderingTests.cs" Reason="tests the PDFium adapter's form-fill environment (FPDF_FFLDraw) and its lifetime; NativeFormRenderingTests checks the same fields on vector-drawn pages" />
    <Compile Remove="@(PdfiumOnlyTest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PdfEngine.Abstractions\PdfEngine.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\PdfViewer.Core\PdfViewer.Core.csproj" />
    <ProjectReference Include="..\..\src\PdfViewer\PdfViewer.csproj" />
    <!-- The release gates' measurement and comparison logic (eng/releasegate), tested here. Program.cs stays out: it is an entry point. -->
    <Compile Include="..\..\eng\releasegate\ReleaseGate.Tool\*.cs" Exclude="..\..\eng\releasegate\ReleaseGate.Tool\Program.cs" LinkBase="ReleaseGate" />
    <Compile Include="..\PdfEngine.Vector.Tests\Fixtures\VectorPdfBuilder.cs" Link="Fixtures\VectorPdfBuilder.cs" />
    <Compile Include="..\PdfEngine.Vector.Tests\Fixtures\FormPdfFixture.cs" Link="Fixtures\FormPdfFixture.cs" />
    <Compile Include="..\PdfEngine.Vector.Tests\Fixtures\ScriptedFormFixture.cs" Link="Fixtures\ScriptedFormFixture.cs" />
    <Compile Include="..\PdfEngine.Vector.Tests\Fixtures\PdfTestEncryption.cs" Link="Fixtures\PdfTestEncryption.cs" />
    <Compile Include="..\PdfEngine.Vector.Tests\Fixtures\TestPki.cs" Link="Fixtures\TestPki.cs" />
    <None Update="xunit.runner.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
